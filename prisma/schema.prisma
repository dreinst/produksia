  potonganPajak     Decimal           @default(0) @db.Decimal(18, 2)
  /// Mata uang & kurs saat uang diterima (informasional; `jumlah` tetap IDR)
  mataUangId        String?
  mataUang          MataUang?         @relation(fields: [mataUangId], references: [id])
  kurs              Decimal           @default(1) @db.Decimal(18, 6)
  nilaiAsli         Decimal?          @db.Decimal(18, 2)
  jurnalId          String?           @unique
  jurnal            Jurnal?           @relation("JurnalPenerimaanPenjualan", fields: [jurnalId], references: [id])
  metodeBayar       String            @default("TUNAI")
  /// Persetujuan (maker-checker); lihat src/lib/persetujuan.ts
  statusPersetujuan StatusPersetujuan @default(DRAFT)
  diajukanOlehId    String?
  diajukanOleh      Pengguna?         @relation("AjukanPenerimaanPenjualan", fields: [diajukanOlehId], references: [id])
  diajukanPada      DateTime?
  disetujuiOlehId   String?
  disetujuiOleh     Pengguna?         @relation("SetujuiPenerimaanPenjualan", fields: [disetujuiOlehId], references: [id])
  disetujuiPada     DateTime?
  ditolakOlehId     String?
  ditolakOleh       Pengguna?         @relation("TolakPenerimaanPenjualan", fields: [ditolakOlehId], references: [id])
  ditolakPada       DateTime?
  catatanPenolakan  String?

  @@index([pelangganId])
  @@index([fakturId])
  @@index([akunId])
  @@index([tanggal])
  @@index([statusPersetujuan])
}

model ReturPenjualan {
  id       String          @id @default(cuid())
  nomor    String          @unique
