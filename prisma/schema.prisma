  jumlah   Decimal         @db.Decimal(18, 2)
  harga    Decimal         @db.Decimal(18, 2)
  subtotal Decimal         @db.Decimal(18, 2)

  @@index([fakturId])
  @@index([barangId])
}

model PembayaranPembelian {
  id                String            @id @default(cuid())
  nomor             String            @unique
  tanggal           DateTime          @default(now())
  pemasokId         String
  pemasok           Pemasok           @relation(fields: [pemasokId], references: [id])
  fakturId          String
  faktur            FakturPembelian   @relation(fields: [fakturId], references: [id])
  akunId            String
  akun              Akun              @relation("AkunPembayaranPembelian", fields: [akunId], references: [id])
  jumlah            Decimal           @db.Decimal(18, 2)
  /// PPh 23 yang kita potong dari vendor (mengurangi hutang, dicatat sebagai hutang PPh 23)
  potonganPajak     Decimal           @default(0) @db.Decimal(18, 2)
  /// Mata uang & kurs saat uang dibayarkan (informasional; `jumlah` tetap IDR)
  mataUangId        String?
  mataUang          MataUang?         @relation(fields: [mataUangId], references: [id])
  kurs              Decimal           @default(1) @db.Decimal(18, 6)
  nilaiAsli         Decimal?          @db.Decimal(18, 2)
  jurnalId          String?           @unique
  jurnal            Jurnal?           @relation("JurnalPembayaranPembelian", fields: [jurnalId], references: [id])
  metodeBayar       String            @default("TRANSFER")
  /// Persetujuan (maker-checker); lihat src/lib/persetujuan.ts
  statusPersetujuan StatusPersetujuan @default(DRAFT)
  diajukanOlehId    String?
  diajukanOleh      Pengguna?         @relation("AjukanPembayaranPembelian", fields: [diajukanOlehId], references: [id])
  diajukanPada      DateTime?
  disetujuiOlehId   String?
  disetujuiOleh     Pengguna?         @relation("SetujuiPembayaranPembelian", fields: [disetujuiOlehId], references: [id])
  disetujuiPada     DateTime?
  ditolakOlehId     String?
  ditolakOleh       Pengguna?         @relation("TolakPembayaranPembelian", fields: [ditolakOlehId], references: [id])
  ditolakPada       DateTime?
  catatanPenolakan  String?

  @@index([pemasokId])
  @@index([fakturId])
  @@index([akunId])
  @@index([tanggal])
  @@index([statusPersetujuan])
}

model ReturPembelian {
  id       String          @id @default(cuid())
  nomor    String          @unique
  tanggal  DateTime        @default(now())
  fakturId String
  faktur   FakturPembelian @relation(fields: [fakturId], references: [id])
  gudangId String
  gudang   Gudang          @relation(fields: [gudangId], references: [id])
  alasan   String?
  total    Decimal         @default(0) @db.Decimal(18, 2)
  dpp      Decimal         @default(0) @db.Decimal(18, 2)
  ppn      Decimal         @default(0) @db.Decimal(18, 2)
  jurnalId String?         @unique
  jurnal   Jurnal?         @relation("JurnalReturPembelian", fields: [jurnalId], references: [id])

  baris             BarisReturPembelian[]
  /// Persetujuan (maker-checker); lihat src/lib/persetujuan.ts
  statusPersetujuan StatusPersetujuan     @default(DRAFT)
  diajukanOlehId    String?
  diajukanOleh      Pengguna?             @relation("AjukanReturPembelian", fields: [diajukanOlehId], references: [id])
  diajukanPada      DateTime?
  disetujuiOlehId   String?
  disetujuiOleh     Pengguna?             @relation("SetujuiReturPembelian", fields: [disetujuiOlehId], references: [id])
  disetujuiPada     DateTime?
  ditolakOlehId     String?
  ditolakOleh       Pengguna?             @relation("TolakReturPembelian", fields: [ditolakOlehId], references: [id])
  ditolakPada       DateTime?
  catatanPenolakan  String?

  @@index([fakturId])
  @@index([gudangId])
  @@index([statusPersetujuan])
}

model BarisReturPembelian {
  id         String         @id @default(cuid())
  returId    String
  retur      ReturPembelian @relation(fields: [returId], references: [id])
  barangId   String
  barang     Barang         @relation(fields: [barangId], references: [id])
  jumlah     Decimal        @db.Decimal(18, 2)
  hargaPokok Decimal        @default(0) @db.Decimal(18, 2)

  @@index([returId])
  @@index([barangId])
}

// ---------- Buku Besar & Kas/Bank ----------

model Akun {
  id         String    @id @default(cuid())
  kode       String    @unique
  nama       String
  jenis      JenisAkun
  /// Akun kelompok/induk: hanya wadah untuk anak-anaknya, tidak boleh menerima jurnal
  kelompok   Boolean   @default(false)
  /// Tampil sebagai pilihan akun Kas/Bank (penerimaan, pembayaran, kas masuk/keluar)
  kasBank    Boolean   @default(false)
  keterangan String?
  indukId    String?
  induk      Akun?     @relation("PohonAkun", fields: [indukId], references: [id])
  anak       Akun[]    @relation("PohonAkun")

  barisJurnal         BarisJurnal[]
  penerimaanPenjualan PenerimaanPenjualan[] @relation("AkunPenerimaanPenjualan")
  uangMukaPelanggan   UangMukaPelanggan[]   @relation("AkunUangMuka")
  pembayaranPembelian PembayaranPembelian[] @relation("AkunPembayaranPembelian")

  pemetaanPiutang    PemetaanAkun? @relation("PetaPiutang")
  pemetaanPersediaan PemetaanAkun? @relation("PetaPersediaan")
  pemetaanHpp        PemetaanAkun? @relation("PetaHpp")
  pemetaanPendapatan PemetaanAkun? @relation("PetaPendapatan")
  pemetaanUtang      PemetaanAkun? @relation("PetaUtang")

  asetSebagaiAkunAset      AsetTetap[] @relation("AkunAsetTetap")
  asetSebagaiAkunBeban     AsetTetap[] @relation("AkunBebanPenyusutan")
  asetSebagaiAkunAkumulasi AsetTetap[] @relation("AkunAkumulasiPenyusutan")

  barangPendapatan           Barang[]                @relation("AkunPendapatanBarang")
  barangHpp                  Barang[]                @relation("AkunHppBarang")
  barangPersediaan           Barang[]                @relation("AkunPersediaanBarang")
  barangBeban                Barang[]                @relation("AkunBebanBarang")
  pemetaanBebanJasa          PemetaanAkun?           @relation("PetaBebanJasa")
  pemetaanBarangBelumDitagih PemetaanAkun?           @relation("PetaBarangBelumDitagih")
  pemetaanSelisihPersediaan  PemetaanAkun?           @relation("PetaSelisihPersediaan")
  pemetaanBarangTerkirim     PemetaanAkun?           @relation("PetaBarangTerkirim")
  pemetaanUangMuka           PemetaanAkun?           @relation("PetaUangMuka")
  pemetaanLabaDitahan        PemetaanAkun?           @relation("PetaLabaDitahan")
  pemetaanDiskonPenjualan    PemetaanAkun?           @relation("PetaDiskonPenjualan")
  pemetaanPendapatanLain     PemetaanAkun?           @relation("PetaPendapatanLain")
  pemetaanSelisihKurs        PemetaanAkun?           @relation("PetaSelisihKurs")
  dokumenKasSebagaiKas       DokumenKas[]            @relation("AkunKasDokumenKas")
  dokumenKasSebagaiLawan     DokumenKas[]            @relation("AkunLawanDokumenKas")
  asetSebagaiAkunPembayaran  AsetTetap[]             @relation("AkunPembayaranAset")
  pelepasanPenerimaan        PelepasanAset[]         @relation("AkunPenerimaanPelepasan")
  pelepasanLabaRugi          PelepasanAset[]         @relation("AkunLabaRugiPelepasan")
  mutasiBank                 MutasiBank[]            @relation("AkunMutasiBank")
  priveKas                   Prive[]                 @relation("AkunKasPrive")
  priveModal                 Prive[]                 @relation("AkunPrive")
  karyawanBeban              Karyawan[]              @relation("AkunBebanKaryawan")
  penggajianKas              Penggajian[]            @relation("AkunKasPenggajian")
  pemetaanTambahan           PemetaanAkunTambahan[]  @relation("AkunPemetaanTambahan")
  penyesuaianLawan           PenyesuaianPersediaan[] @relation("AkunLawanPenyesuaian")
  pengaturanPpnKeluaran      PengaturanPerusahaan?   @relation("PetaPpnKeluaran")
  pengaturanPpnMasukan       PengaturanPerusahaan?   @relation("PetaPpnMasukan")
  pengaturanPph23Dimuka      PengaturanPerusahaan?   @relation("PetaPph23Dimuka")
  pengaturanPph23Dipotong    PengaturanPerusahaan?   @relation("PetaPph23Dipotong")
  pengaturanBebanPphFinal    PengaturanPerusahaan?   @relation("PetaBebanPphFinal")
  pengaturanHutangPphFinal   PengaturanPerusahaan?   @relation("PetaHutangPphFinal")

  @@index([indukId])
}

model PemetaanAkun {
  id String @id @default("default")

  piutangUsahaId String @unique
  piutangUsaha   Akun   @relation("PetaPiutang", fields: [piutangUsahaId], references: [id])

  persediaanId String @unique
  persediaan   Akun   @relation("PetaPersediaan", fields: [persediaanId], references: [id])

  hppId String @unique
  hpp   Akun   @relation("PetaHpp", fields: [hppId], references: [id])

  pendapatanPenjualanId String @unique
  pendapatanPenjualan   Akun   @relation("PetaPendapatan", fields: [pendapatanPenjualanId], references: [id])

  utangUsahaId String @unique
  utangUsaha   Akun   @relation("PetaUtang", fields: [utangUsahaId], references: [id])

  /// Beban untuk pembelian JASA (kosong = HPP)
  bebanJasaId          String? @unique
  bebanJasa            Akun?   @relation("PetaBebanJasa", fields: [bebanJasaId], references: [id])
  /// Kewajiban sementara: barang sudah diterima (TB) tapi belum ditagih (FB)
  barangBelumDitagihId String? @unique
  barangBelumDitagih   Akun?   @relation("PetaBarangBelumDitagih", fields: [barangBelumDitagihId], references: [id])
  /// Selisih nilai persediaan (retur pembelian beda harga, penyesuaian stok)
  selisihPersediaanId  String? @unique
  selisihPersediaan    Akun?   @relation("PetaSelisihPersediaan", fields: [selisihPersediaanId], references: [id])
  /// Aset sementara: barang sudah dikirim (SJ) tapi belum difaktur (FJ)
  barangTerkirimId     String? @unique
  barangTerkirim       Akun?   @relation("PetaBarangTerkirim", fields: [barangTerkirimId], references: [id])
  /// Kewajiban: uang muka/DP pelanggan yang belum dipakai faktur
  uangMukaPelangganId  String? @unique
  uangMukaPelanggan    Akun?   @relation("PetaUangMuka", fields: [uangMukaPelangganId], references: [id])
  /// Ekuitas: tujuan jurnal penutup tahun (laba/rugi bersih dipindahkan ke sini)
  labaDitahanId        String? @unique
  labaDitahan          Akun?   @relation("PetaLabaDitahan", fields: [labaDitahanId], references: [id])
  /// Kontra-pendapatan: diskon faktur penjualan (saldo normal debit); kelompoknya tidak dihitung sebagai omzet
  diskonPenjualanId    String? @unique
  diskonPenjualan      Akun?   @relation("PetaDiskonPenjualan", fields: [diskonPenjualanId], references: [id])
  /// Kelompok pendapatan non-usaha (bunga bank, laba pelepasan aset, dst.): bukan omzet PPh Final
  pendapatanLainId     String? @unique
  pendapatanLain       Akun?   @relation("PetaPendapatanLain", fields: [pendapatanLainId], references: [id])
  /// Selisih Kurs (laba/rugi kurs): tujuan jurnal penilaian kembali piutang/hutang mata uang asing.
  /// Ditempatkan di PemetaanAkun (bukan PengaturanPerusahaan) karena ini pemetaan akuntansi umum,
  /// sejenis Selisih Persediaan, bukan akun pajak.
  selisihKursId        String? @unique
  selisihKurs          Akun?   @relation("PetaSelisihKurs", fields: [selisihKursId], references: [id])
}

model Jurnal {
  id         String       @id @default(cuid())
  nomor      String       @unique
  tanggal    DateTime     @default(now())
  keterangan String?
  sumber     SumberJurnal @default(MANUAL)
  /// Dimensi event/proyek: diwarisi dari pesanan (jurnal otomatis) atau dipilih di jurnal manual/kas
  proyekId   String?
  proyek     Proyek?      @relation(fields: [proyekId], references: [id])

  baris                 BarisJurnal[]
  penyusutanAset        PenyusutanAset[]
  perolehanAset         AsetTetap?             @relation("JurnalPerolehanAset")
  penyesuaianPersediaan PenyesuaianPersediaan?
  penerimaanBarang      PenerimaanBarang?
  pengiriman            PengirimanPesanan?     @relation("JurnalPengiriman")
  fakturPenjualan       FakturPenjualan?       @relation("JurnalFakturPenjualan")
  penerimaanPenjualan   PenerimaanPenjualan?   @relation("JurnalPenerimaanPenjualan")
  uangMukaPelanggan     UangMukaPelanggan?     @relation("JurnalUangMuka")
  tutupBuku             TutupBuku?             @relation("JurnalTutupBuku")
  pphFinal              PphFinalBulanan?       @relation("JurnalPphFinal")
  pelepasanAset         PelepasanAset?         @relation("JurnalPelepasanAset")
  prive                 Prive?                 @relation("JurnalPrive")
  returPenjualan        ReturPenjualan?        @relation("JurnalReturPenjualan")
  fakturPembelian       FakturPembelian?       @relation("JurnalFakturPembelian")
  pembayaranPembelian   PembayaranPembelian?   @relation("JurnalPembayaranPembelian")
  returPembelian        ReturPembelian?        @relation("JurnalReturPembelian")
  penggajian            Penggajian?            @relation("JurnalPenggajian")
  dokumenKas            DokumenKas?            @relation("JurnalDokumenKas")
  /// Persetujuan (maker-checker); lihat src/lib/persetujuan.ts.
  /// Untuk Jurnal bawaannya DISETUJUI karena berlaku aturan tetap: ADANYA satu baris Jurnal berarti
  /// transaksinya SUDAH masuk buku besar (semua laporan membaca Jurnal tanpa menyaring status).
  /// Draf yang belum dibukukan disimpan di dokumen sumbernya (mis. DokumenKas), bukan sebagai Jurnal.
  statusPersetujuan     StatusPersetujuan      @default(DISETUJUI)
  diajukanOlehId        String?
  diajukanOleh          Pengguna?              @relation("AjukanJurnal", fields: [diajukanOlehId], references: [id])
  diajukanPada          DateTime?
  disetujuiOlehId       String?
  disetujuiOleh         Pengguna?              @relation("SetujuiJurnal", fields: [disetujuiOlehId], references: [id])
  disetujuiPada         DateTime?
  ditolakOlehId         String?
  ditolakOleh           Pengguna?              @relation("TolakJurnal", fields: [ditolakOlehId], references: [id])
  ditolakPada           DateTime?
  catatanPenolakan      String?

  @@index([proyekId])
  @@index([tanggal])
  @@index([statusPersetujuan])
}

model BarisJurnal {
  id               String      @id @default(cuid())
  jurnalId         String
  jurnal           Jurnal      @relation(fields: [jurnalId], references: [id])
  akunId           String
  akun             Akun        @relation(fields: [akunId], references: [id])
  debit            Decimal     @default(0) @db.Decimal(18, 2)
  kredit           Decimal     @default(0) @db.Decimal(18, 2)
  keterangan       String?
  /// Rekonsiliasi kas/bank: kapan baris ini dicocokkan dengan mutasi rekening
  rekonsiliasiPada DateTime?
  mutasiBank       MutasiBank?
  /// Jejak mata uang asal (informasional). Buku besar SELALU dalam IDR (mata uang fungsional);
  /// tiga kolom ini hanya menyimpan nilai dokumen dalam mata uang transaksinya agar bisa ditelusuri.
  mataUangAsliId   String?
  mataUangAsli     MataUang?   @relation("MataUangAsliBarisJurnal", fields: [mataUangAsliId], references: [id])
  kursAsli         Decimal?    @db.Decimal(18, 6)
  nilaiAsli        Decimal?    @db.Decimal(18, 2)

  @@index([jurnalId])
  @@index([akunId])
}

/// Dokumen Kas Masuk / Kas Keluar yang melewati persetujuan.
///
/// Kenapa model sendiri: di Produksia keberadaan satu baris `Jurnal` BERARTI sudah masuk buku besar
/// (semua laporan membaca Jurnal tanpa filter). Draf kas karena itu tidak boleh berupa Jurnal, jadi
/// niat transaksinya disimpan di sini dulu; jurnal KM/KK baru dibuat saat dokumen DISETUJUI dan
/// ditautkan lewat `jurnalId`. Kas masuk/keluar yang dicatat tanpa alur persetujuan (pengaturan
/// `wajibPersetujuan` mati) tetap langsung menjadi Jurnal seperti sebelumnya.
model DokumenKas {
  id          String          @id @default(cuid())
  nomor       String          @unique
  jenis       JenisDokumenKas
  tanggal     DateTime        @default(now())
  akunKasId   String
  akunKas     Akun            @relation("AkunKasDokumenKas", fields: [akunKasId], references: [id])
  akunLawanId String
  akunLawan   Akun            @relation("AkunLawanDokumenKas", fields: [akunLawanId], references: [id])
  jumlah      Decimal         @db.Decimal(18, 2)
  keterangan  String?
  proyekId    String?
  proyek      Proyek?         @relation(fields: [proyekId], references: [id])
  /// Terisi setelah disetujui: jurnal KM/KK yang dihasilkan
  jurnalId    String?         @unique
  jurnal      Jurnal?         @relation("JurnalDokumenKas", fields: [jurnalId], references: [id])
  dibuatOleh  String
  dibuatPada  DateTime        @default(now())

  /// Persetujuan (maker-checker); lihat src/lib/persetujuan.ts
  statusPersetujuan StatusPersetujuan @default(DRAFT)
  diajukanOlehId    String?
  diajukanOleh      Pengguna?         @relation("AjukanDokumenKas", fields: [diajukanOlehId], references: [id])
  diajukanPada      DateTime?
  disetujuiOlehId   String?
  disetujuiOleh     Pengguna?         @relation("SetujuiDokumenKas", fields: [disetujuiOlehId], references: [id])
  disetujuiPada     DateTime?
  ditolakOlehId     String?
  ditolakOleh       Pengguna?         @relation("TolakDokumenKas", fields: [ditolakOlehId], references: [id])
  ditolakPada       DateTime?
  catatanPenolakan  String?

  @@index([statusPersetujuan])
  @@index([jenis])
  @@index([tanggal])
  @@index([akunKasId])
  @@index([akunLawanId])
  @@index([proyekId])
}

// ---------- Aset Tetap ----------

model AsetTetap {
  id               String     @id @default(cuid())
  kode             String     @unique
  nama             String
  tanggalPerolehan DateTime   @default(now())
  hargaPerolehan   Decimal    @db.Decimal(18, 2)
  nilaiSisa        Decimal    @default(0) @db.Decimal(18, 2)
  umurBulan        Int
  status           StatusAset @default(AKTIF)

  akunAsetId                String
  akunAset                  Akun   @relation("AkunAsetTetap", fields: [akunAsetId], references: [id])
  akunBebanPenyusutanId     String
  akunBebanPenyusutan       Akun   @relation("AkunBebanPenyusutan", fields: [akunBebanPenyusutanId], references: [id])
  akunAkumulasiPenyusutanId String
  akunAkumulasiPenyusutan   Akun   @relation("AkunAkumulasiPenyusutan", fields: [akunAkumulasiPenyusutanId], references: [id])

  /// Kas/Bank atau Hutang yang dikredit saat perolehan (kosong = tidak dijurnal, aset sudah tercatat)
  akunPembayaranId  String?
  akunPembayaran    Akun?   @relation("AkunPembayaranAset", fields: [akunPembayaranId], references: [id])
  jurnalPerolehanId String? @unique
  jurnalPerolehan   Jurnal? @relation("JurnalPerolehanAset", fields: [jurnalPerolehanId], references: [id])

  penyusutan        PenyusutanAset[]
  pelepasan         PelepasanAset?
  /// Persetujuan (maker-checker); lihat src/lib/persetujuan.ts
  statusPersetujuan StatusPersetujuan @default(DRAFT)
  diajukanOlehId    String?
  diajukanOleh      Pengguna?         @relation("AjukanAsetTetap", fields: [diajukanOlehId], references: [id])
  diajukanPada      DateTime?
  disetujuiOlehId   String?
  disetujuiOleh     Pengguna?         @relation("SetujuiAsetTetap", fields: [disetujuiOlehId], references: [id])
  disetujuiPada     DateTime?
  ditolakOlehId     String?
  ditolakOleh       Pengguna?         @relation("TolakAsetTetap", fields: [ditolakOlehId], references: [id])
  ditolakPada       DateTime?
  catatanPenolakan  String?

  @@index([akunAsetId])
  @@index([akunBebanPenyusutanId])
  @@index([akunAkumulasiPenyusutanId])
  @@index([akunPembayaranId])
  @@index([statusPersetujuan])
}

/// Pelepasan aset (dijual / dihapusbukukan): akumulasi penyusutan & aset dikeluarkan, selisih harga jual vs nilai buku = laba/rugi
model PelepasanAset {
  id                String            @id @default(cuid())
  asetId            String            @unique
  aset              AsetTetap         @relation(fields: [asetId], references: [id])
  tanggal           DateTime          @default(now())
  jenis             StatusAset
  hargaJual         Decimal           @default(0) @db.Decimal(18, 2)
  /// Kas/Bank atau Piutang yang menerima hasil penjualan (kosong bila dihapusbukukan tanpa hasil)
  akunPenerimaanId  String?
  akunPenerimaan    Akun?             @relation("AkunPenerimaanPelepasan", fields: [akunPenerimaanId], references: [id])
  /// Akun laba/rugi pelepasan (dikredit bila laba, didebit bila rugi)
  akunLabaRugiId    String
  akunLabaRugi      Akun              @relation("AkunLabaRugiPelepasan", fields: [akunLabaRugiId], references: [id])
  nilaiBuku         Decimal           @db.Decimal(18, 2)
  labaRugi          Decimal           @db.Decimal(18, 2)
  keterangan        String?
  jurnalId          String?           @unique
  jurnal            Jurnal?           @relation("JurnalPelepasanAset", fields: [jurnalId], references: [id])
  penggunaNama      String
  dibuatPada        DateTime          @default(now())
  /// Persetujuan (maker-checker); lihat src/lib/persetujuan.ts
  statusPersetujuan StatusPersetujuan @default(DRAFT)
  diajukanOlehId    String?
  diajukanOleh      Pengguna?         @relation("AjukanPelepasanAset", fields: [diajukanOlehId], references: [id])
  diajukanPada      DateTime?
  disetujuiOlehId   String?
  disetujuiOleh     Pengguna?         @relation("SetujuiPelepasanAset", fields: [disetujuiOlehId], references: [id])
  disetujuiPada     DateTime?
  ditolakOlehId     String?
  ditolakOleh       Pengguna?         @relation("TolakPelepasanAset", fields: [ditolakOlehId], references: [id])
  ditolakPada       DateTime?
  catatanPenolakan  String?

  @@index([akunPenerimaanId])
  @@index([akunLabaRugiId])
  @@index([statusPersetujuan])
}

model PenyusutanAset {
  id       String    @id @default(cuid())
  asetId   String
  aset     AsetTetap @relation(fields: [asetId], references: [id])
  periode  DateTime
  jumlah   Decimal   @db.Decimal(18, 2)
  jurnalId String?
  jurnal   Jurnal?   @relation(fields: [jurnalId], references: [id])

  @@unique([asetId, periode])
  @@index([jurnalId])
}

// ---------- Persediaan: penyesuaian stok (saldo awal, opname, koreksi) ----------

/// Pindah barang antar gudang: stok fisik berpindah, nilai persediaan tetap (tanpa jurnal)
model PindahBarang {
  id             String   @id @default(cuid())
  nomor          String   @unique
  tanggal        DateTime @default(now())
  gudangAsalId   String
  gudangAsal     Gudang   @relation("GudangAsalPindah", fields: [gudangAsalId], references: [id])
  gudangTujuanId String
  gudangTujuan   Gudang   @relation("GudangTujuanPindah", fields: [gudangTujuanId], references: [id])
  keterangan     String?
  dibuatPada     DateTime @default(now())

  baris             BarisPindahBarang[]
  /// Persetujuan (maker-checker); lihat src/lib/persetujuan.ts
  statusPersetujuan StatusPersetujuan   @default(DRAFT)
  diajukanOlehId    String?
  diajukanOleh      Pengguna?           @relation("AjukanPindahBarang", fields: [diajukanOlehId], references: [id])
  diajukanPada      DateTime?
  disetujuiOlehId   String?
  disetujuiOleh     Pengguna?           @relation("SetujuiPindahBarang", fields: [disetujuiOlehId], references: [id])
  disetujuiPada     DateTime?
  ditolakOlehId     String?
  ditolakOleh       Pengguna?           @relation("TolakPindahBarang", fields: [ditolakOlehId], references: [id])
  ditolakPada       DateTime?
  catatanPenolakan  String?

  @@index([gudangAsalId])
  @@index([gudangTujuanId])
  @@index([statusPersetujuan])
}

model BarisPindahBarang {
  id       String       @id @default(cuid())
  pindahId String
  pindah   PindahBarang @relation(fields: [pindahId], references: [id])
  barangId String
  barang   Barang       @relation(fields: [barangId], references: [id])
  jumlah   Decimal      @db.Decimal(18, 2)

  @@index([pindahId])
  @@index([barangId])
}

model PenyesuaianPersediaan {
  id          String   @id @default(cuid())
  nomor       String   @unique
  tanggal     DateTime @default(now())
  gudangId    String
  gudang      Gudang   @relation(fields: [gudangId], references: [id])
  keterangan  String?
  /// Akun lawan: Modal (saldo awal) atau Selisih Persediaan (opname/koreksi)
  akunLawanId String
  akunLawan   Akun     @relation("AkunLawanPenyesuaian", fields: [akunLawanId], references: [id])
  jurnalId    String?  @unique
  jurnal      Jurnal?  @relation(fields: [jurnalId], references: [id])
  dibuatPada  DateTime @default(now())

  baris             BarisPenyesuaianPersediaan[]
  /// Persetujuan (maker-checker); lihat src/lib/persetujuan.ts
  statusPersetujuan StatusPersetujuan            @default(DRAFT)
  diajukanOlehId    String?
  diajukanOleh      Pengguna?                    @relation("AjukanPenyesuaianPersediaan", fields: [diajukanOlehId], references: [id])
  diajukanPada      DateTime?
  disetujuiOlehId   String?
  disetujuiOleh     Pengguna?                    @relation("SetujuiPenyesuaianPersediaan", fields: [disetujuiOlehId], references: [id])
  disetujuiPada     DateTime?
  ditolakOlehId     String?
  ditolakOleh       Pengguna?                    @relation("TolakPenyesuaianPersediaan", fields: [ditolakOlehId], references: [id])
  ditolakPada       DateTime?
  catatanPenolakan  String?
  /// Peminjaman Barang berselisih (hilang/rusak) yang diselesaikan lewat penyesuaian ini
  peminjaman        PeminjamanBarang[]

  @@index([gudangId])
  @@index([akunLawanId])
  @@index([statusPersetujuan])
}

model BarisPenyesuaianPersediaan {
  id            String                @id @default(cuid())
  penyesuaianId String
  penyesuaian   PenyesuaianPersediaan @relation(fields: [penyesuaianId], references: [id])
  barangId      String
  barang        Barang                @relation(fields: [barangId], references: [id])
  jumlahSebelum Decimal               @db.Decimal(18, 2)
  jumlahSesudah Decimal               @db.Decimal(18, 2)
  /// Harga pokok satuan yang dipakai menilai selisih
  hargaSatuan   Decimal               @db.Decimal(18, 2)

  @@index([penyesuaianId])
  @@index([barangId])
}

// ---------- Peminjaman Barang (loading out / loading in) ----------

/// Foto disimpan di basis data (Bytes) karena Vercel & Docker VPS tidak punya disk tetap.
/// barangId = foto barang (galeri di data induk); peminjamanId + tahap = foto bukti keluar/kembali.
model Foto {
  id           String            @id @default(cuid())
  barangId     String?
  barang       Barang?           @relation(fields: [barangId], references: [id], onDelete: Cascade)
  peminjamanId String?
  peminjaman   PeminjamanBarang? @relation(fields: [peminjamanId], references: [id], onDelete: Cascade)
  tahap        TahapFoto?
  urutan       Int               @default(0)
  tipe         String
  ukuran       Int
  isi          Bytes
  dibuatPada   DateTime          @default(now())

  @@index([barangId])
  @@index([peminjamanId])
}

/// Barang keluar gudang untuk event lalu kembali. TIDAK menyentuh StokBarang maupun jurnal;
/// "sedang di luar" dihitung dari baris (jumlah - jumlahKembali), lihat src/lib/peminjaman.ts.
/// Status turunan: TERBUKA (ditutupPada null), SELESAI, SELISIH (sisa > 0), DISESUAIKAN (penyesuaianId terisi).
model PeminjamanBarang {
  id              String                 @id @default(cuid())
  nomor           String                 @unique
  gudangId        String
  gudang          Gudang                 @relation(fields: [gudangId], references: [id])
  proyekId        String?
  proyek          Proyek?                @relation(fields: [proyekId], references: [id])
  /// Teks bebas: kru lapangan yang mengambil barang belum tentu punya akun
  namaPengambil   String
  keterangan      String?
  waktuKeluar     DateTime               @default(now())
  rencanaKembali  DateTime?
  ditutupPada     DateTime?
  catatanKembali  String?
  penyesuaianId   String?
  penyesuaian     PenyesuaianPersediaan? @relation(fields: [penyesuaianId], references: [id])
  dicatatOlehId   String?
  dicatatOleh     Pengguna?              @relation("CatatPeminjamanBarang", fields: [dicatatOlehId], references: [id], onDelete: SetNull)
  dicatatOlehNama String

  baris BarisPeminjamanBarang[]
  foto  Foto[]

  @@index([gudangId])
  @@index([proyekId])
  @@index([penyesuaianId])
  @@index([ditutupPada])
  @@index([dicatatOlehId])
}

model BarisPeminjamanBarang {
  id            String           @id @default(cuid())
  peminjamanId  String
  peminjaman    PeminjamanBarang @relation(fields: [peminjamanId], references: [id], onDelete: Cascade)
  barangId      String
  barang        Barang           @relation(fields: [barangId], references: [id])
  jumlah        Decimal          @db.Decimal(18, 2)
  /// Akumulasi yang sudah kembali (boleh bertahap); CHECK DB: jumlahKembali <= jumlah
  jumlahKembali Decimal          @default(0) @db.Decimal(18, 2)

  @@unique([peminjamanId, barangId])
  @@index([barangId])
}

// ---------- Pengaturan perusahaan & pajak (singleton id = "default") ----------

model PengaturanPerusahaan {
  id               String  @id @default("default")
  nama             String  @default("Produksia")
  /// Pengusaha Kena Pajak: faktur memungut PPN
  pkp              Boolean @default(false)
  tarifPpnPersen   Decimal @default(11) @db.Decimal(5, 2)
  /// Jatuh tempo bawaan faktur (hari)
  terminHari       Int     @default(14)
  /// Tahun buku yang sedang dibuka (kosong = mengikuti tahun kalender); bawaan periode laporan
  tahunBuku        Int?
  /// Alur persetujuan maker-checker aktif. Menyala (bawaan): dokumen dibuat sebagai DRAFT, harus
  /// diajukan lalu disetujui orang lain sebelum jurnalnya masuk buku besar. Dimatikan hanya untuk
  /// usaha yang stafnya terlalu sedikit untuk memisahkan tugas; pengendaliannya hilang.
  wajibPersetujuan Boolean @default(true)

  akunPpnKeluaranId    String? @unique
  akunPpnKeluaran      Akun?   @relation("PetaPpnKeluaran", fields: [akunPpnKeluaranId], references: [id])
  akunPpnMasukanId     String? @unique
  akunPpnMasukan       Akun?   @relation("PetaPpnMasukan", fields: [akunPpnMasukanId], references: [id])
  /// PPh 23 yang dipotong pelanggan dari pembayaran kita (aset: pajak dibayar dimuka)
  akunPph23DimukaId    String? @unique
  akunPph23Dimuka      Akun?   @relation("PetaPph23Dimuka", fields: [akunPph23DimukaId], references: [id])
  /// PPh 23 yang kita potong dari vendor (kewajiban: hutang PPh 23)
  akunPph23DipotongId  String? @unique
  akunPph23Dipotong    Akun?   @relation("PetaPph23Dipotong", fields: [akunPph23DipotongId], references: [id])
  /// PPh Final UMKM (PP 55/2022): tarif % dari omzet bulanan; beban & hutangnya dijurnal dari Ringkasan Pajak
  pphFinalPersen       Decimal @default(0.5) @db.Decimal(5, 2)
  akunBebanPphFinalId  String? @unique
  akunBebanPphFinal    Akun?   @relation("PetaBebanPphFinal", fields: [akunBebanPphFinalId], references: [id])
  akunHutangPphFinalId String? @unique
  akunHutangPphFinal   Akun?   @relation("PetaHutangPphFinal", fields: [akunHutangPphFinalId], references: [id])
}

// ---------- Jejak audit ----------

/// Penutupan tahun buku: pendapatan & beban tahun itu dipindahkan ke Laba Ditahan lewat jurnal JU-TUTUP
model TutupBuku {
  id                String            @id @default(cuid())
  tahun             Int               @unique
  tanggal           DateTime          @default(now())
  labaBersih        Decimal           @default(0) @db.Decimal(18, 2)
  penggunaNama      String
  jurnalId          String?           @unique
  jurnal            Jurnal?           @relation("JurnalTutupBuku", fields: [jurnalId], references: [id])
  /// Persetujuan (maker-checker); lihat src/lib/persetujuan.ts
  statusPersetujuan StatusPersetujuan @default(DRAFT)
  diajukanOlehId    String?
  diajukanOleh      Pengguna?         @relation("AjukanTutupBuku", fields: [diajukanOlehId], references: [id])
  diajukanPada      DateTime?
  disetujuiOlehId   String?
  disetujuiOleh     Pengguna?         @relation("SetujuiTutupBuku", fields: [disetujuiOlehId], references: [id])
  disetujuiPada     DateTime?
  ditolakOlehId     String?
  ditolakOleh       Pengguna?         @relation("TolakTutupBuku", fields: [ditolakOlehId], references: [id])
  ditolakPada       DateTime?
  catatanPenolakan  String?

  @@index([statusPersetujuan])
}

/// PPh Final UMKM per bulan: omzet (DPP faktur − retur) × tarif, dijurnal Dr Beban PPh Final / Cr Hutang PPh Final
model PphFinalBulanan {
  id                String            @id @default(cuid())
  /// "YYYY-MM"
  periode           String            @unique
  omzet             Decimal           @db.Decimal(18, 2)
  tarifPersen       Decimal           @db.Decimal(5, 2)
  jumlah            Decimal           @db.Decimal(18, 2)
  jurnalId          String?           @unique
  jurnal            Jurnal?           @relation("JurnalPphFinal", fields: [jurnalId], references: [id])
  dibuatPada        DateTime          @default(now())
  /// Persetujuan (maker-checker); lihat src/lib/persetujuan.ts
  statusPersetujuan StatusPersetujuan @default(DRAFT)
  diajukanOlehId    String?
  diajukanOleh      Pengguna?         @relation("AjukanPphFinalBulanan", fields: [diajukanOlehId], references: [id])
  diajukanPada      DateTime?
  disetujuiOlehId   String?
  disetujuiOleh     Pengguna?         @relation("SetujuiPphFinalBulanan", fields: [disetujuiOlehId], references: [id])
  disetujuiPada     DateTime?
  ditolakOlehId     String?
  ditolakOleh       Pengguna?         @relation("TolakPphFinalBulanan", fields: [ditolakOlehId], references: [id])
  ditolakPada       DateTime?
  catatanPenolakan  String?

  @@index([statusPersetujuan])
}

/// Penyesuaian hak akses per peran (Pengaturan › Hak Akses); bawaan ada di src/lib/hakAkses.ts
model HakAksesPeran {
  peran PeranPengguna
  hak   String
  boleh Boolean

  @@id([peran, hak])
}

/// Permintaan "lupa kata sandi" dari halaman masuk; ditangani Superadmin/Pemilik/Admin dengan tautan sekali pakai
model PermintaanAturUlang {
  id            String    @id @default(cuid())
  penggunaId    String
  pengguna      Pengguna  @relation(fields: [penggunaId], references: [id], onDelete: Cascade)
  dibuatPada    DateTime  @default(now())
  /// MENUNGGU → TAUTAN (tautan dibuat) → SELESAI (kata sandi diganti) | DITOLAK
  status        String    @default("MENUNGGU")
  /// Token tautan sekali pakai (/atur-ulang/<token>), berlaku sampai `kedaluwarsa`
  token         String?   @unique
  kedaluwarsa   DateTime?
  ditanganiOleh String?
  ditanganiPada DateTime?
  selesaiPada   DateTime?

  @@index([status])
  @@index([penggunaId])
}

/// Mutasi rekening koran hasil impor (CSV/HTML) per akun kas/bank; dicocokkan ke baris jurnal saat rekonsiliasi
model MutasiBank {
  id               String       @id @default(cuid())
  akunId           String
  akun             Akun         @relation("AkunMutasiBank", fields: [akunId], references: [id])
  tanggal          DateTime
  keterangan       String
  referensi        String?
  masuk            Decimal      @default(0) @db.Decimal(18, 2)
  keluar           Decimal      @default(0) @db.Decimal(18, 2)
  saldo            Decimal?     @db.Decimal(18, 2)
  /// Sidik jari (akun + tanggal + masuk + keluar + keterangan) untuk menolak baris yang diimpor dua kali
  sidik            String       @unique
  berkas           String
  diimporPada      DateTime     @default(now())
  penggunaNama     String
  barisJurnalId    String?      @unique
  barisJurnal      BarisJurnal? @relation(fields: [barisJurnalId], references: [id])
  /// Cocok otomatis tapi tanggal buku ≠ tanggal rekening: perlu dicek orang; dikonfirmasiPada diisi setelah dicek
  perluPerhatian   Boolean      @default(false)
  dikonfirmasiPada DateTime?

  @@index([akunId, tanggal])
}

/// Prive: pengambilan uang pribadi pemilik dari kas/bank (Dr Prive 3-4000 / Cr Kas)
model Prive {
  id                String            @id @default(cuid())
  nomor             String            @unique
  tanggal           DateTime          @default(now())
  pemilikNama       String
  akunKasId         String
  akunKas           Akun              @relation("AkunKasPrive", fields: [akunKasId], references: [id])
  akunPriveId       String
  akunPrive         Akun              @relation("AkunPrive", fields: [akunPriveId], references: [id])
  jumlah            Decimal           @db.Decimal(18, 2)
  keterangan        String?
  jurnalId          String?           @unique
  jurnal            Jurnal?           @relation("JurnalPrive", fields: [jurnalId], references: [id])
  penggunaNama      String
  dibuatPada        DateTime          @default(now())
  /// Persetujuan (maker-checker); lihat src/lib/persetujuan.ts
  statusPersetujuan StatusPersetujuan @default(DRAFT)
  diajukanOlehId    String?
  diajukanOleh      Pengguna?         @relation("AjukanPrive", fields: [diajukanOlehId], references: [id])
  diajukanPada      DateTime?
  disetujuiOlehId   String?
  disetujuiOleh     Pengguna?         @relation("SetujuiPrive", fields: [disetujuiOlehId], references: [id])
  disetujuiPada     DateTime?
  ditolakOlehId     String?
  ditolakOleh       Pengguna?         @relation("TolakPrive", fields: [ditolakOlehId], references: [id])
  ditolakPada       DateTime?
  catatanPenolakan  String?

  @@index([akunKasId])
  @@index([akunPriveId])
  @@index([tanggal])
  @@index([statusPersetujuan])
}

/// Siklus SDM: satu proses gaji per periode (bulan), mencakup semua karyawan yang diikutkan.
/// Jurnal: Dr Beban Gaji Pokok (per akun) + Dr Beban Tunjangan (per akun) / Cr Hutang Potongan Gaji (bila ada potongan) / Cr Kas-Bank (gaji bersih).
model Penggajian {
  id             String   @id @default(cuid())
  nomor          String   @unique
  periode        String   @unique // YYYY-MM; satu proses per bulan, koreksi = hapus lalu buat ulang
  tanggal        DateTime @default(now())
  akunKasId      String
  akunKas        Akun     @relation("AkunKasPenggajian", fields: [akunKasId], references: [id])
  proyekId       String?
  proyek         Proyek?  @relation(fields: [proyekId], references: [id])
  totalGajiPokok Decimal  @default(0) @db.Decimal(18, 2)
  totalTunjangan Decimal  @default(0) @db.Decimal(18, 2)
  totalPotongan  Decimal  @default(0) @db.Decimal(18, 2)
  totalDibayar   Decimal  @default(0) @db.Decimal(18, 2)
  keterangan     String?
  jurnalId       String?  @unique
  jurnal         Jurnal?  @relation("JurnalPenggajian", fields: [jurnalId], references: [id])
  penggunaNama   String
  dibuatPada     DateTime @default(now())

  baris             BarisPenggajian[]
  /// Persetujuan (maker-checker); lihat src/lib/persetujuan.ts
  statusPersetujuan StatusPersetujuan @default(DRAFT)
  diajukanOlehId    String?
  diajukanOleh      Pengguna?         @relation("AjukanPenggajian", fields: [diajukanOlehId], references: [id])
  diajukanPada      DateTime?
  disetujuiOlehId   String?
  disetujuiOleh     Pengguna?         @relation("SetujuiPenggajian", fields: [disetujuiOlehId], references: [id])
  disetujuiPada     DateTime?
  ditolakOlehId     String?
  ditolakOleh       Pengguna?         @relation("TolakPenggajian", fields: [ditolakOlehId], references: [id])
  ditolakPada       DateTime?
  catatanPenolakan  String?

  @@index([akunKasId])
  @@index([proyekId])
  @@index([tanggal])
  @@index([statusPersetujuan])
}

/// Rincian gaji per karyawan dalam satu proses Penggajian; diterima = gajiPokok + tunjangan − potongan.
model BarisPenggajian {
  id                 String     @id @default(cuid())
  penggajianId       String
  penggajian         Penggajian @relation(fields: [penggajianId], references: [id])
  karyawanId         String
  karyawan           Karyawan   @relation(fields: [karyawanId], references: [id])
  gajiPokok          Decimal    @db.Decimal(18, 2)
  tunjangan          Decimal    @db.Decimal(18, 2)
  potongan           Decimal    @default(0) @db.Decimal(18, 2)
  keteranganPotongan String?
  diterima           Decimal    @db.Decimal(18, 2)

  @@index([penggajianId])
  @@index([karyawanId])
}

/// Pemetaan akun tambahan buatan pengguna (mis. "prive" → 3-4000) untuk peran yang belum ada di PemetaanAkun
model PemetaanAkunTambahan {
  id         String   @id @default(cuid())
  kunci      String   @unique
  label      String
  akunId     String
  akun       Akun     @relation("AkunPemetaanTambahan", fields: [akunId], references: [id])
  keterangan String?
  dibuatOleh String
  dibuatPada DateTime @default(now())

  @@index([akunId])
}

model LogAktivitas {
  id           String   @id @default(cuid())
  waktu        DateTime @default(now())
  penggunaId   String?
  penggunaNama String
  /// HAPUS, TUTUP_BUKU, dll.
  aksi         String
  /// jenis dokumen (FakturPenjualan, PenerimaanBarang, ...)
  jenis        String
  nomor        String
  keterangan   String?

  @@index([waktu])
}
