  diajukanOlehId    String?
  diajukanOleh      Pengguna?              @relation("AjukanFakturPembelian", fields: [diajukanOlehId], references: [id])
  diajukanPada      DateTime?
  disetujuiOlehId   String?
  disetujuiOleh     Pengguna?              @relation("SetujuiFakturPembelian", fields: [disetujuiOlehId], references: [id])
  disetujuiPada     DateTime?
  ditolakOlehId     String?
  ditolakOleh       Pengguna?              @relation("TolakFakturPembelian", fields: [ditolakOlehId], references: [id])
  ditolakPada       DateTime?
  catatanPenolakan  String?

  @@index([pemasokId])
  @@index([pesananId])
  @@index([penerimaanId])
  @@index([status])
  @@index([tanggal])
  @@index([statusPersetujuan])
}

model BarisFakturPembelian {
