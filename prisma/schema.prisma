  statusPersetujuan StatusPersetujuan   @default(DRAFT)
  diajukanOlehId    String?
  diajukanOleh      Pengguna?           @relation("AjukanUangMukaPelanggan", fields: [diajukanOlehId], references: [id])
  diajukanPada      DateTime?
  disetujuiOlehId   String?
  disetujuiOleh     Pengguna?           @relation("SetujuiUangMukaPelanggan", fields: [disetujuiOlehId], references: [id])
  disetujuiPada     DateTime?
  ditolakOlehId     String?
  ditolakOleh       Pengguna?           @relation("TolakUangMukaPelanggan", fields: [ditolakOlehId], references: [id])
  ditolakPada       DateTime?
  catatanPenolakan  String?

  @@index([pelangganId])
  @@index([pesananId])
  @@index([akunId])
  @@index([tanggal])
  @@index([statusPersetujuan])
}

/// Jejak DP mana yang dipakai faktur mana (dibalik saat faktur dihapus)
model PemakaianUangMuka {
  id         String            @id @default(cuid())
