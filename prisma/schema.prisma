model BarisPengiriman {
  id             String                @id @default(cuid())
  pengirimanId   String
  pengiriman     PengirimanPesanan     @relation(fields: [pengirimanId], references: [id])
  barisPesananId String
  barisPesanan   BarisPesananPenjualan @relation(fields: [barisPesananId], references: [id])
  barangId       String
  barang         Barang                @relation(fields: [barangId], references: [id])
  jumlah         Decimal               @db.Decimal(18, 2)
  /// harga pokok rata-rata saat barang keluar (menilai akun Barang Terkirim Belum Ditagih)
  hargaPokok     Decimal               @default(0) @db.Decimal(18, 2)
  /// bagian dari baris ini yang sudah dikonsumsi Faktur Penjualan (HPP sudah diakui)
  jumlahDifaktur Decimal               @default(0) @db.Decimal(18, 2)
  konsumsiFaktur KonsumsiSuratJalan[]

  @@index([pengirimanId])
  @@index([barisPesananId])
  @@index([barangId])
}

/// Catatan baris SJ yang dikonsumsi satu baris faktur penjualan (jumlah dan nilai transitnya), ditulis buatFaktur.
/// Hapus faktur membalik persis catatan ini, termasuk konsumsi lintas baris pesanan (SJ yatim). Faktur yang dibuat
/// sebelum tabel ini ada (`FakturPenjualan.konsumsiSjTercatat` = false) dibalik dengan cara lama per barang.
model KonsumsiSuratJalan {
  id                String               @id @default(cuid())
  barisFakturId     String
  barisFaktur       BarisFakturPenjualan @relation(fields: [barisFakturId], references: [id], onDelete: Cascade)
  barisPengirimanId String
  barisPengiriman   BarisPengiriman      @relation(fields: [barisPengirimanId], references: [id], onDelete: Restrict)
  jumlah            Decimal              @db.Decimal(18, 2)
  /// jumlah x harga pokok baris SJ; jumlah per baris faktur = BarisFakturPenjualan.nilaiTransit
  nilaiTransit      Decimal              @db.Decimal(18, 2)
  dibuatPada        DateTime             @default(now())

  @@index([barisFakturId])
  @@index([barisPengirimanId])
}

model FakturPenjualan {
  id                String              @id @default(cuid())
  nomor             String              @unique
  tanggal           DateTime            @default(now())
  jatuhTempo        DateTime?
  pelangganId       String
  pelanggan         Pelanggan           @relation(fields: [pelangganId], references: [id])
  pesananId         String?
  pesanan           PesananPenjualan?   @relation(fields: [pesananId], references: [id])
  pengirimanId      String?
  pengiriman        PengirimanPesanan?  @relation(fields: [pengirimanId], references: [id])
  status            StatusDokumen       @default(DRAF)
  total             Decimal             @default(0) @db.Decimal(18, 2)
  /// Diskon faktur dalam rupiah (kontra-pendapatan, akun Diskon Penjualan); dpp = Σ baris − diskon + fee
  diskon            Decimal             @default(0) @db.Decimal(18, 2)
  /// Dasar pengenaan pajak (Σ baris − diskon + fee) dan PPN; total = dpp + ppn
  dpp               Decimal             @default(0) @db.Decimal(18, 2)
  ppnPersen         Decimal             @default(0) @db.Decimal(5, 2)
  ppn               Decimal             @default(0) @db.Decimal(18, 2)
  /// Uang muka pelanggan (DP pesanan) yang dipakai mengurangi piutang faktur ini
  uangMuka          Decimal             @default(0) @db.Decimal(18, 2)
  /// Mata uang transaksi (kosong = IDR). `kurs` = kurs ke IDR yang dipakai saat dokumen dibuat (snapshot),
  /// `nilaiAsli` = nilai total dalam mata uang transaksi. Kolom uang lain (total/dpp/ppn/diskon) selalu IDR.
  mataUangId        String?             @map("mataUangId")
  mataUang          MataUang?           @relation(fields: [mataUangId], references: [id])
  kurs              Decimal             @default(1) @db.Decimal(18, 6)
  nilaiAsli         Decimal?            @db.Decimal(18, 2)
  /// Kurs yang saldo terbukanya saat ini dibawa di buku besar. Kosong = masih kurs dokumen (`kurs`).
  /// Diisi penilaian kembali (src/lib/selisihKurs.ts) supaya penilaian berikutnya hanya mencatat
  /// selisih sejak penilaian terakhir, bukan menghitung ulang dari kurs asli (idempoten).
  kursRevaluasi     Decimal?            @db.Decimal(18, 6)
  revaluasiPada     DateTime?
  jurnalId          String?             @unique
  jurnal            Jurnal?             @relation("JurnalFakturPenjualan", fields: [jurnalId], references: [id])
  pemakaianUangMuka PemakaianUangMuka[]

  /// true = konsumsi SJ faktur ini tercatat lengkap di KonsumsiSuratJalan (buatFaktur sejak tabel itu ada), termasuk
  /// faktur yang tidak mengonsumsi SJ sama sekali. false = faktur lama; hapus faktur memakai pembalikan kode lama.
  konsumsiSjTercatat Boolean @default(false)

  /// Pemilik pembukuan (lihat model Perusahaan). Dokumen anak mewarisi induknya; jurnal mewarisi dokumennya.
  perusahaanId String     @default("utama")
  perusahaan   Perusahaan @relation(fields: [perusahaanId], references: [id])

  baris             BarisFakturPenjualan[]
  penerimaan        PenerimaanPenjualan[]
  retur             ReturPenjualan[]
  /// Persetujuan (maker-checker); lihat src/lib/persetujuan.ts
  statusPersetujuan StatusPersetujuan      @default(DRAFT)
  diajukanOlehId    String?
  diajukanOleh      Pengguna?              @relation("AjukanFakturPenjualan", fields: [diajukanOlehId], references: [id])
  diajukanPada      DateTime?
  disetujuiOlehId   String?
  disetujuiOleh     Pengguna?              @relation("SetujuiFakturPenjualan", fields: [disetujuiOlehId], references: [id])
  disetujuiPada     DateTime?
  ditolakOlehId     String?
  ditolakOleh       Pengguna?              @relation("TolakFakturPenjualan", fields: [ditolakOlehId], references: [id])
  ditolakPada       DateTime?
  catatanPenolakan  String?

  // --- D2: mode event, diskon, fee, teks surat & cetak ---
  mode             ModeDokumen   @default(STANDAR)
  tampilanEvent    TampilanEvent @default(RINCI)
  namaEvent        String?
  venue            String?
  tanggalEvent     String?
  /// informasi cetak cara hitung diskon; nilai rupiahnya tetap di kolom `diskon` lama
  jenisDiskon      JenisNilai    @default(NOMINAL)
  nilaiDiskon      Decimal       @default(0) @db.Decimal(18, 2)
  /// diwarisi dari pesanan (server), tidak dari formulir
  jenisFee         JenisNilai    @default(PERSEN)
  nilaiFee         Decimal       @default(0) @db.Decimal(18, 2)
  /// management fee faktur ini (rupiah); masuk dpp; dijurnal Cr akun fee
  fee              Decimal       @default(0) @db.Decimal(18, 2)
  judulCetak       String?
  nomorCetak       String?
  perihal          String?
  lampiran         String?
  referensi        String?
  teksPembuka      String?
  teksPenutup      String?
  catatan          String?
  catatanKanan     String?
  syaratPembayaran String?
  infoBank         String?
  /// nama/kontak/alamat tujuan di cetakan; kosong = data induk pelanggan saat dicetak
  kepada           String?
  kepadaUp         String?
  kepadaAlamat     String?
  kepadaTelepon    String?
  kepadaEmail      String?
  kopSuratId       String?
  kopSurat         KopSurat?     @relation(fields: [kopSuratId], references: [id], onDelete: SetNull)

  @@unique([perusahaanId, nomorCetak])
  @@index([pelangganId])
  @@index([pesananId])
  @@index([pengirimanId])
  @@index([status])
  @@index([tanggal])
  @@index([statusPersetujuan])
  @@index([perusahaanId])
  @@index([kopSuratId])
}

model BarisFakturPenjualan {
  id           String          @id @default(cuid())
  fakturId     String
  faktur       FakturPenjualan @relation(fields: [fakturId], references: [id])
  barangId     String
  barang       Barang          @relation(fields: [barangId], references: [id])
  jumlah       Decimal         @db.Decimal(18, 2)
  harga        Decimal         @db.Decimal(18, 2)
  subtotal     Decimal         @db.Decimal(18, 2)
  /// Nilai "Barang Terkirim Belum Ditagih" yang dikonsumsi baris ini saat faktur dibuat (surat jalan
  /// mendahului faktur). Disimpan karena jurnal HPP baru dicatat saat faktur DISETUJUI, sedangkan
  /// konsumsi baris surat jalannya sudah terjadi saat draf dibuat.
  nilaiTransit Decimal         @default(0) @db.Decimal(18, 2)

  /// frekuensi mode event (malam/hari/kali). Hanya mengalikan nilai uang; TIDAK PERNAH kuantitas stok, SJ, atau HPP
  frekuensi       Decimal                @default(1) @db.Decimal(18, 2)
  satuanFrekuensi String?
  /// seksi baris (mode event); baris berurutan dengan seksi sama dicetak di bawah satu judul
  bagian          String?
  urutan          Int                    @default(0)
  /// nama tampil; kosong = Barang.nama. Baris bebas memakai Barang sistem JASA-LAIN dengan nama di sini
  nama            String?
  /// satu poin per baris: "- " butir, "-- " sub-butir, **tebal** (src/lib/teksBerbutir.ts)
  deskripsi       String?
  /// satuan tampil; kosong = Barang.satuan
  satuan          String?
  /// kolom "Keterangan" proposal D'Pro
  keterangan      String?
  /// baris pesanan yang ditagih baris ini. Null untuk baris lama yang barangnya ganda di pesanan (cadangan per barangId)
  barisPesananId  String?
  barisPesanan    BarisPesananPenjualan? @relation(fields: [barisPesananId], references: [id], onDelete: SetNull)
  barisRetur      BarisReturPenjualan[]
  konsumsiSj      KonsumsiSuratJalan[]

  @@index([fakturId])
  @@index([barangId])
  @@index([barisPesananId])
}

model UangMukaPelanggan {
  id            String           @id @default(cuid())
  nomor         String           @unique
  tanggal       DateTime         @default(now())
  pelangganId   String
  pelanggan     Pelanggan        @relation(fields: [pelangganId], references: [id])
  pesananId     String
  pesanan       PesananPenjualan @relation(fields: [pesananId], references: [id])
  akunId        String
  akun          Akun             @relation("AkunUangMuka", fields: [akunId], references: [id])
  /// DP yang diterima; jumlahDipakai = bagian yang sudah mengurangi faktur
  jumlah        Decimal          @db.Decimal(18, 2)
  jumlahDipakai Decimal          @default(0) @db.Decimal(18, 2)
  metodeBayar   String           @default("TRANSFER")
  keterangan    String?
  jurnalId      String?          @unique
  jurnal        Jurnal?          @relation("JurnalUangMuka", fields: [jurnalId], references: [id])

  /// Pemilik pembukuan (lihat model Perusahaan). Dokumen anak mewarisi induknya; jurnal mewarisi dokumennya.
  perusahaanId String     @default("utama")
  perusahaan   Perusahaan @relation(fields: [perusahaanId], references: [id])

  pemakaian         PemakaianUangMuka[]
  /// Persetujuan (maker-checker); lihat src/lib/persetujuan.ts
  statusPersetujuan StatusPersetujuan   @default(DRAFT)
  diajukanOlehId    String?
  diajukanOleh      Pengguna?           @relation("AjukanUangMukaPelanggan", fields: [diajukanOlehId], references: [id])
  diajukanPada      DateTime?
  disetujuiOlehId   String?
  disetujuiOleh     Pengguna?           @relation("SetujuiUangMukaPelanggan", fields: [disetujuiOlehId], references: [id])
  disetujuiPada     DateTime?
  ditolakOlehId     String?
  ditolakOleh       Pengguna?           @relation("TolakUangMukaPelanggan", fields: [ditolakOlehId], references: [id])
  ditolakPada       DateTime?
  catatanPenolakan  String?

  // --- D2: termin dan kuitansi DP ---
  /// butir rencana termin yang dibayar (opsional); hanya tautan, jurnal UM tidak berubah
  rencanaTerminId String?
  rencanaTermin   RencanaTermin? @relation(fields: [rencanaTerminId], references: [id], onDelete: Restrict)
  nomorCetak      String?
  judulCetak      String?
  terimaDari      String?
  keperluan       String?
  kopSuratId      String?
  kopSurat        KopSurat?      @relation(fields: [kopSuratId], references: [id], onDelete: SetNull)

  @@unique([perusahaanId, nomorCetak])
  @@index([pelangganId])
  @@index([pesananId])
  @@index([akunId])
  @@index([tanggal])
  @@index([statusPersetujuan])
  @@index([perusahaanId])
  @@index([rencanaTerminId])
  @@index([kopSuratId])
}

/// Jejak DP mana yang dipakai faktur mana (dibalik saat faktur dihapus)
model PemakaianUangMuka {
  id         String            @id @default(cuid())
  uangMukaId String
  uangMuka   UangMukaPelanggan @relation(fields: [uangMukaId], references: [id])
  fakturId   String
  faktur     FakturPenjualan   @relation(fields: [fakturId], references: [id])
  jumlah     Decimal           @db.Decimal(18, 2)

  @@index([fakturId])
  @@index([uangMukaId])
}

model PenerimaanPenjualan {
  id                String            @id @default(cuid())
  nomor             String            @unique
  tanggal           DateTime          @default(now())
  pelangganId       String
  pelanggan         Pelanggan         @relation(fields: [pelangganId], references: [id])
  fakturId          String
  faktur            FakturPenjualan   @relation(fields: [fakturId], references: [id])
  akunId            String
  akun              Akun              @relation("AkunPenerimaanPenjualan", fields: [akunId], references: [id])
  jumlah            Decimal           @db.Decimal(18, 2)
  /// PPh 23 yang dipotong pelanggan (mengurangi piutang, dicatat sebagai pajak dibayar dimuka)
  potonganPajak     Decimal           @default(0) @db.Decimal(18, 2)
  /// Mata uang & kurs saat uang diterima (informasional; `jumlah` tetap IDR)
  mataUangId        String?
  mataUang          MataUang?         @relation(fields: [mataUangId], references: [id])
  kurs              Decimal           @default(1) @db.Decimal(18, 6)
  nilaiAsli         Decimal?          @db.Decimal(18, 2)
  jurnalId          String?           @unique
  jurnal            Jurnal?           @relation("JurnalPenerimaanPenjualan", fields: [jurnalId], references: [id])
  metodeBayar       String            @default("TUNAI")
  /// Persetujuan (maker-checker); lihat src/lib/persetujuan.ts
  statusPersetujuan StatusPersetujuan @default(DRAFT)
  diajukanOlehId    String?
  diajukanOleh      Pengguna?         @relation("AjukanPenerimaanPenjualan", fields: [diajukanOlehId], references: [id])
  diajukanPada      DateTime?
  disetujuiOlehId   String?
  disetujuiOleh     Pengguna?         @relation("SetujuiPenerimaanPenjualan", fields: [disetujuiOlehId], references: [id])
  disetujuiPada     DateTime?
  ditolakOlehId     String?
  ditolakOleh       Pengguna?         @relation("TolakPenerimaanPenjualan", fields: [ditolakOlehId], references: [id])
  ditolakPada       DateTime?
  catatanPenolakan  String?

  /// Pemilik pembukuan (lihat model Perusahaan). Dokumen anak mewarisi induknya; jurnal mewarisi dokumennya.
  perusahaanId String     @default("utama")
  perusahaan   Perusahaan @relation(fields: [perusahaanId], references: [id])

  // --- D2: kuitansi ---
  nomorCetak String?
  judulCetak String?
  /// "Telah terima dari"; kosong = nama pelanggan
  terimaDari String?
  /// "Digunakan untuk" (≤ 300, maks 2 baris cetak); kosong = teks otomatis
  keperluan  String?
  catatan    String?
  kopSuratId String?
  kopSurat   KopSurat? @relation(fields: [kopSuratId], references: [id], onDelete: SetNull)

  @@unique([perusahaanId, nomorCetak])
  @@index([pelangganId])
  @@index([fakturId])
  @@index([akunId])
  @@index([tanggal])
  @@index([statusPersetujuan])
  @@index([perusahaanId])
  @@index([kopSuratId])
}

model ReturPenjualan {
  id       String          @id @default(cuid())
  nomor    String          @unique
  tanggal  DateTime        @default(now())
  fakturId String
  faktur   FakturPenjualan @relation(fields: [fakturId], references: [id])
