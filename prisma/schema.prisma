  baris             BarisPesananPembelian[]
  penerimaanBarang  PenerimaanBarang[]
  faktur            FakturPembelian[]
  /// Persetujuan (maker-checker); lihat src/lib/persetujuan.ts
  statusPersetujuan StatusPersetujuan       @default(DRAFT)
  diajukanOlehId    String?
  diajukanOleh      Pengguna?               @relation("AjukanPesananPembelian", fields: [diajukanOlehId], references: [id])
  diajukanPada      DateTime?
  disetujuiOlehId   String?
  disetujuiOleh     Pengguna?               @relation("SetujuiPesananPembelian", fields: [disetujuiOlehId], references: [id])
  disetujuiPada     DateTime?
  ditolakOlehId     String?
  ditolakOleh       Pengguna?               @relation("TolakPesananPembelian", fields: [ditolakOlehId], references: [id])
