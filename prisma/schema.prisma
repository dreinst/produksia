// Produksia: skema data (seluruh penamaan dalam bahasa Indonesia)
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/prisma-klien"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enum ----------

enum StatusDokumen {
  DRAF
  DIKONVERSI
  DIPROSES
  LUNAS
  SEBAGIAN
  DIBATALKAN
}

enum JenisBarang {
  BARANG
  JASA
}

enum PeranPengguna {
  SUPERADMIN
  PEMILIK
  ADMIN
  KASIR
  GUDANG
}

enum JenisAkun {
  ASET
  KEWAJIBAN
  MODAL
  PENDAPATAN
  BEBAN
}

enum SumberJurnal {
  MANUAL
  /// Penilaian kembali piutang/hutang mata uang asing ke kurs akhir periode (src/lib/selisihKurs.ts)
  SELISIH_KURS
  PENUTUP
  PAJAK
  PRIVE
  KAS_MASUK
  KAS_KELUAR
  PENJUALAN
  PEMBELIAN
  PENYUSUTAN
  PERSEDIAAN
  ASET_TETAP
  PENGGAJIAN
}

enum StatusAset {
  AKTIF
  DIJUAL
  DIHAPUS
}

/// Alur persetujuan dokumen (maker-checker / pemisahan tugas):
/// DRAFT = baru dibuat, belum masuk buku besar · MENUNGGU = sudah diajukan, menunggu pemeriksa ·
/// DISETUJUI = jurnalnya sudah dicatat · DITOLAK = dikembalikan ke pembuat dengan catatan.
enum StatusPersetujuan {
  DRAFT
  MENUNGGU
  DISETUJUI
  DITOLAK
}

enum JenisDokumenKas {
  MASUK
  KELUAR
}

/// Tahap foto bukti pada Peminjaman Barang: saat barang keluar (loading out) atau kembali (loading in)
enum TahapFoto {
  KELUAR
  KEMBALI
}

// ---------- Pengguna ----------

model Pengguna {
  id                           String                  @id @default(cuid())
  /// Identitas masuk (huruf kecil, unik); email hanya kontak opsional
  namaPengguna                 String                  @unique
  email                        String?                 @unique
  nama                         String
  kataSandiHash                String
  peran                        PeranPengguna           @default(KASIR)
  aktif                        Boolean                 @default(true)
  karyawan                     Karyawan?
  sesi                         Sesi[]
  permintaanAturUlang          PermintaanAturUlang[]
  dibuatPada                   DateTime                @default(now())
  /// Relasi balik alur persetujuan: siapa mengajukan / menyetujui / menolak tiap jenis dokumen
  ajukanPenawaranPenjualan     PenawaranPenjualan[]    @relation("AjukanPenawaranPenjualan")
  setujuiPenawaranPenjualan    PenawaranPenjualan[]    @relation("SetujuiPenawaranPenjualan")
  tolakPenawaranPenjualan      PenawaranPenjualan[]    @relation("TolakPenawaranPenjualan")
  ajukanPesananPenjualan       PesananPenjualan[]      @relation("AjukanPesananPenjualan")
  setujuiPesananPenjualan      PesananPenjualan[]      @relation("SetujuiPesananPenjualan")
  tolakPesananPenjualan        PesananPenjualan[]      @relation("TolakPesananPenjualan")
  ajukanUangMukaPelanggan      UangMukaPelanggan[]     @relation("AjukanUangMukaPelanggan")
  setujuiUangMukaPelanggan     UangMukaPelanggan[]     @relation("SetujuiUangMukaPelanggan")
  tolakUangMukaPelanggan       UangMukaPelanggan[]     @relation("TolakUangMukaPelanggan")
  ajukanPengirimanPesanan      PengirimanPesanan[]     @relation("AjukanPengirimanPesanan")
  setujuiPengirimanPesanan     PengirimanPesanan[]     @relation("SetujuiPengirimanPesanan")
  tolakPengirimanPesanan       PengirimanPesanan[]     @relation("TolakPengirimanPesanan")
  ajukanFakturPenjualan        FakturPenjualan[]       @relation("AjukanFakturPenjualan")
  setujuiFakturPenjualan       FakturPenjualan[]       @relation("SetujuiFakturPenjualan")
  tolakFakturPenjualan         FakturPenjualan[]       @relation("TolakFakturPenjualan")
  ajukanPenerimaanPenjualan    PenerimaanPenjualan[]   @relation("AjukanPenerimaanPenjualan")
  setujuiPenerimaanPenjualan   PenerimaanPenjualan[]   @relation("SetujuiPenerimaanPenjualan")
  tolakPenerimaanPenjualan     PenerimaanPenjualan[]   @relation("TolakPenerimaanPenjualan")
  ajukanReturPenjualan         ReturPenjualan[]        @relation("AjukanReturPenjualan")
  setujuiReturPenjualan        ReturPenjualan[]        @relation("SetujuiReturPenjualan")
  tolakReturPenjualan          ReturPenjualan[]        @relation("TolakReturPenjualan")
  ajukanPesananPembelian       PesananPembelian[]      @relation("AjukanPesananPembelian")
  setujuiPesananPembelian      PesananPembelian[]      @relation("SetujuiPesananPembelian")
  tolakPesananPembelian        PesananPembelian[]      @relation("TolakPesananPembelian")
  ajukanPenerimaanBarang       PenerimaanBarang[]      @relation("AjukanPenerimaanBarang")
  setujuiPenerimaanBarang      PenerimaanBarang[]      @relation("SetujuiPenerimaanBarang")
  tolakPenerimaanBarang        PenerimaanBarang[]      @relation("TolakPenerimaanBarang")
  ajukanFakturPembelian        FakturPembelian[]       @relation("AjukanFakturPembelian")
  setujuiFakturPembelian       FakturPembelian[]       @relation("SetujuiFakturPembelian")
  tolakFakturPembelian         FakturPembelian[]       @relation("TolakFakturPembelian")
  ajukanPembayaranPembelian    PembayaranPembelian[]   @relation("AjukanPembayaranPembelian")
  setujuiPembayaranPembelian   PembayaranPembelian[]   @relation("SetujuiPembayaranPembelian")
  tolakPembayaranPembelian     PembayaranPembelian[]   @relation("TolakPembayaranPembelian")
  ajukanReturPembelian         ReturPembelian[]        @relation("AjukanReturPembelian")
  setujuiReturPembelian        ReturPembelian[]        @relation("SetujuiReturPembelian")
  tolakReturPembelian          ReturPembelian[]        @relation("TolakReturPembelian")
  ajukanJurnal                 Jurnal[]                @relation("AjukanJurnal")
  setujuiJurnal                Jurnal[]                @relation("SetujuiJurnal")
  tolakJurnal                  Jurnal[]                @relation("TolakJurnal")
  ajukanPenyesuaianPersediaan  PenyesuaianPersediaan[] @relation("AjukanPenyesuaianPersediaan")
  setujuiPenyesuaianPersediaan PenyesuaianPersediaan[] @relation("SetujuiPenyesuaianPersediaan")
  tolakPenyesuaianPersediaan   PenyesuaianPersediaan[] @relation("TolakPenyesuaianPersediaan")
  ajukanPindahBarang           PindahBarang[]          @relation("AjukanPindahBarang")
  setujuiPindahBarang          PindahBarang[]          @relation("SetujuiPindahBarang")
  tolakPindahBarang            PindahBarang[]          @relation("TolakPindahBarang")
  ajukanAsetTetap              AsetTetap[]             @relation("AjukanAsetTetap")
  setujuiAsetTetap             AsetTetap[]             @relation("SetujuiAsetTetap")
  tolakAsetTetap               AsetTetap[]             @relation("TolakAsetTetap")
  ajukanPelepasanAset          PelepasanAset[]         @relation("AjukanPelepasanAset")
  setujuiPelepasanAset         PelepasanAset[]         @relation("SetujuiPelepasanAset")
  tolakPelepasanAset           PelepasanAset[]         @relation("TolakPelepasanAset")
  ajukanPrive                  Prive[]                 @relation("AjukanPrive")
  setujuiPrive                 Prive[]                 @relation("SetujuiPrive")
  tolakPrive                   Prive[]                 @relation("TolakPrive")
  ajukanPenggajian             Penggajian[]            @relation("AjukanPenggajian")
  setujuiPenggajian            Penggajian[]            @relation("SetujuiPenggajian")
  tolakPenggajian              Penggajian[]            @relation("TolakPenggajian")
  ajukanTutupBuku              TutupBuku[]             @relation("AjukanTutupBuku")
  setujuiTutupBuku             TutupBuku[]             @relation("SetujuiTutupBuku")
  tolakTutupBuku               TutupBuku[]             @relation("TolakTutupBuku")
  ajukanPphFinalBulanan        PphFinalBulanan[]       @relation("AjukanPphFinalBulanan")
  setujuiPphFinalBulanan       PphFinalBulanan[]       @relation("SetujuiPphFinalBulanan")
  tolakPphFinalBulanan         PphFinalBulanan[]       @relation("TolakPphFinalBulanan")
  ajukanDokumenKas             DokumenKas[]            @relation("AjukanDokumenKas")
  setujuiDokumenKas            DokumenKas[]            @relation("SetujuiDokumenKas")
  tolakDokumenKas              DokumenKas[]            @relation("TolakDokumenKas")
  catatPeminjamanBarang        PeminjamanBarang[]      @relation("CatatPeminjamanBarang")
}

/// Sesi login berbasis basis data: cookie hanya menyimpan token acak, yang disimpan di sini dalam bentuk hash.
model Sesi {
  id          String   @id @default(cuid())
  tokenHash   String   @unique
  penggunaId  String
  pengguna    Pengguna @relation(fields: [penggunaId], references: [id], onDelete: Cascade)
  kedaluwarsa DateTime
  dibuatPada  DateTime @default(now())

  @@index([penggunaId])
  @@index([kedaluwarsa])
}

/// Catatan percobaan masuk yang GAGAL, untuk membatasi laju (anti brute-force/credential-stuffing).
/// Dikunci per akun DAN per IP; baris lama dibersihkan otomatis saat percobaan baru dicatat.
model PercobaanMasuk {
  id           String   @id @default(cuid())
  namaPengguna String
  ip           String
  waktu        DateTime @default(now())

  @@index([namaPengguna, waktu])
  @@index([ip, waktu])
}

// ---------- Mata uang & kurs ----------

/// Mata uang transaksi. IDR adalah mata uang fungsional (mata uang pelaporan): seluruh buku besar
/// tetap dicatat dalam IDR, mata uang asing hanya melekat pada dokumen dan saldo piutang/hutangnya.
model MataUang {
  id         String   @id @default(cuid())
  /// Kode ISO 4217, mis. IDR, USD, EUR, SGD
  kode       String   @unique
  nama       String
  simbol     String   @default("")
  /// Jumlah angka desimal yang lazim (IDR 0, USD 2, JPY 0)
  desimal    Int      @default(2)
  aktif      Boolean  @default(true)
  /// Mata uang fungsional/pelaporan (IDR); tepat satu baris bernilai true dan kursnya selalu 1
  fungsional Boolean  @default(false)
  dibuatPada DateTime @default(now())

  kurs                KursMataUang[]
  pelanggan           Pelanggan[]
  pemasok             Pemasok[]
  fakturPenjualan     FakturPenjualan[]
  fakturPembelian     FakturPembelian[]
  penerimaanPenjualan PenerimaanPenjualan[]
  pembayaranPembelian PembayaranPembelian[]
  barisJurnalAsli     BarisJurnal[]         @relation("MataUangAsliBarisJurnal")
}

/// Riwayat kurs terhadap IDR: 1 unit mata uang = `kurs` rupiah pada `tanggal`.
/// Dokumen menyimpan kurs yang dipakai (snapshot), jadi jurnal lama tidak berubah saat kurs baru dimasukkan.
model KursMataUang {
  id          String   @id @default(cuid())
  mataUangId  String
  mataUang    MataUang @relation(fields: [mataUangId], references: [id], onDelete: Cascade)
  tanggal     DateTime
  kurs        Decimal  @db.Decimal(18, 6)
  sumber      String?
  dicatatOleh String?
  dibuatPada  DateTime @default(now())

  @@unique([mataUangId, tanggal])
  @@index([mataUangId, tanggal])
}

// ---------- Data induk ----------

model Departemen {
  id       String     @id @default(cuid())
  nama     String
  karyawan Karyawan[]
}

model Karyawan {
  id               String            @id @default(cuid())
  kode             String            @unique
  nama             String
  departemenId     String?
  departemen       Departemen?       @relation(fields: [departemenId], references: [id])
  penggunaId       String?           @unique
  pengguna         Pengguna?         @relation(fields: [penggunaId], references: [id])
  pelanggan        Pelanggan[]
  /// Siklus SDM: data kepegawaian dan komponen gaji bulanan bawaan (bisa disesuaikan per baris saat Proses Gaji)
  jabatan          String?
  tanggalBergabung DateTime?
  status           String            @default("AKTIF") // AKTIF | NONAKTIF
  gajiPokok        Decimal           @default(0) @db.Decimal(18, 2)
  tunjangan        Decimal           @default(0) @db.Decimal(18, 2)
  /// Akun beban khusus karyawan ini (mis. Upah Harian/Honor Volunteer alih-alih Gaji Pokok); kosong = pemetaan tambahan "bebanGaji"
  akunBebanId      String?
  akunBeban        Akun?             @relation("AkunBebanKaryawan", fields: [akunBebanId], references: [id])
  barisPenggajian  BarisPenggajian[]
  dibuatPada       DateTime          @default(now())

  @@index([departemenId])
  @@index([akunBebanId])
}

model Pelanggan {
  id         String    @id @default(cuid())
  kode       String    @unique
  nama       String
  alamat     String?
  telepon    String?
  npwp       String?
  penjualId  String?
  penjual    Karyawan? @relation(fields: [penjualId], references: [id])
  /// Mata uang transaksi bawaan pelanggan (kosong = IDR / mata uang fungsional)
  mataUangId String?
  mataUang   MataUang? @relation(fields: [mataUangId], references: [id])

  penawaran  PenawaranPenjualan[]
  pesanan    PesananPenjualan[]
  faktur     FakturPenjualan[]
  penerimaan PenerimaanPenjualan[]
  proyek     Proyek[]
  uangMuka   UangMukaPelanggan[]
  dibuatPada DateTime              @default(now())

  @@index([penjualId])
}

model Pemasok {
  id         String    @id @default(cuid())
  kode       String    @unique
  nama       String
  alamat     String?
  telepon    String?
  /// Mata uang transaksi bawaan pemasok (kosong = IDR / mata uang fungsional)
  mataUangId String?
  mataUang   MataUang? @relation(fields: [mataUangId], references: [id])
  dibuatPada DateTime  @default(now())

  pesanan    PesananPembelian[]
  faktur     FakturPembelian[]
  pembayaran PembayaranPembelian[]
}

/// Proyek = event/pekerjaan: dimensi transaksi untuk Laba Rugi per event dan Rekonsiliasi Event (LPJ)
model Proyek {
  id             String     @id @default(cuid())
  kode           String     @unique
  nama           String
  pelangganId    String?
  pelanggan      Pelanggan? @relation(fields: [pelangganId], references: [id])
  status         String     @default("BERJALAN")
  /// Nilai proposal/kontrak yang disetujui klien dan anggaran biaya — pembanding realisasi di LPJ
  nilaiKontrak   Decimal?   @db.Decimal(18, 2)
  anggaranBiaya  Decimal?   @db.Decimal(18, 2)
  tanggalMulai   DateTime?
  tanggalSelesai DateTime?
  keterangan     String?

  penawaran        PenawaranPenjualan[]
  pesanan          PesananPenjualan[]
  pesananPembelian PesananPembelian[]
  jurnal           Jurnal[]
  penggajian       Penggajian[]
  dokumenKas       DokumenKas[]
  peminjaman       PeminjamanBarang[]

  @@index([pelangganId])
}

model Gudang {
  id     String  @id @default(cuid())
  kode   String  @unique
  nama   String
  alamat String?

  stok             StokBarang[]
  pengiriman       PengirimanPesanan[]
  returPenjualan   ReturPenjualan[]
  penerimaanBarang PenerimaanBarang[]
  returPembelian   ReturPembelian[]
  penyesuaian      PenyesuaianPersediaan[]
  pindahAsal       PindahBarang[]          @relation("GudangAsalPindah")
  pindahTujuan     PindahBarang[]          @relation("GudangTujuanPindah")
  peminjaman       PeminjamanBarang[]
}

model KelompokBarang {
  id      String           @id @default(cuid())
  nama    String
  indukId String?
  induk   KelompokBarang?  @relation("PohonKelompok", fields: [indukId], references: [id])
  anak    KelompokBarang[] @relation("PohonKelompok")
  barang  Barang[]

  @@index([indukId])
}

model Barang {
  id           String          @id @default(cuid())
  kode         String          @unique
  nama         String
  jenis        JenisBarang     @default(BARANG)
  kelompokId   String?
  kelompok     KelompokBarang? @relation(fields: [kelompokId], references: [id])
  satuan       String          @default("pcs")
  warna        String?
  hargaBeli    Decimal         @default(0) @db.Decimal(18, 2)
  hargaJual    Decimal         @default(0) @db.Decimal(18, 2)
  /// Batas bawah harga saat nego dengan klien (0 = tanpa batas)
  hargaMinimum Decimal         @default(0) @db.Decimal(18, 2)
  stokMinimum  Decimal         @default(0) @db.Decimal(18, 2)

  stok                  StokBarang[]
  barisPenawaran        BarisPenawaranPenjualan[]
  barisPesananPenjualan BarisPesananPenjualan[]
  barisPengiriman       BarisPengiriman[]
  barisFakturPenjualan  BarisFakturPenjualan[]
  barisReturPenjualan   BarisReturPenjualan[]
  barisPesananPembelian BarisPesananPembelian[]
  barisPenerimaanBarang BarisPenerimaanBarang[]
  barisFakturPembelian  BarisFakturPembelian[]
  barisReturPembelian   BarisReturPembelian[]
  dibuatPada            DateTime                  @default(now())

  /// Akun khusus per barang (opsional; kosong = pakai PemetaanAkun)
  akunPendapatanId String?
  akunPendapatan   Akun?                        @relation("AkunPendapatanBarang", fields: [akunPendapatanId], references: [id])
  akunHppId        String?
  akunHpp          Akun?                        @relation("AkunHppBarang", fields: [akunHppId], references: [id])
  akunPersediaanId String?
  akunPersediaan   Akun?                        @relation("AkunPersediaanBarang", fields: [akunPersediaanId], references: [id])
  /// Untuk JASA yang dibeli: beban yang didebit saat Faktur Pembelian
  akunBebanId      String?
  akunBeban        Akun?                        @relation("AkunBebanBarang", fields: [akunBebanId], references: [id])
  barisPenyesuaian BarisPenyesuaianPersediaan[]
  barisPindah      BarisPindahBarang[]
  barisPeminjaman  BarisPeminjamanBarang[]
  foto             Foto[]

  @@index([kelompokId])
  @@index([akunPendapatanId])
  @@index([akunHppId])
  @@index([akunPersediaanId])
  @@index([akunBebanId])
}

model StokBarang {
  barangId String
  barang   Barang  @relation(fields: [barangId], references: [id])
  gudangId String
  gudang   Gudang  @relation(fields: [gudangId], references: [id])
  jumlah   Decimal @default(0) @db.Decimal(18, 2)

  @@id([barangId, gudangId])
  @@index([barangId])
  @@index([gudangId])
}

// ---------- Siklus Penjualan ----------

model PenawaranPenjualan {
  id          String        @id @default(cuid())
  nomor       String        @unique
  tanggal     DateTime      @default(now())
  pelangganId String
  pelanggan   Pelanggan     @relation(fields: [pelangganId], references: [id])
  status      StatusDokumen @default(DRAF)
  proyekId    String?
  proyek      Proyek?       @relation(fields: [proyekId], references: [id])
  total       Decimal       @default(0) @db.Decimal(18, 2)

  baris             BarisPenawaranPenjualan[]
  pesanan           PesananPenjualan?
  /// Persetujuan (maker-checker); lihat src/lib/persetujuan.ts
  statusPersetujuan StatusPersetujuan         @default(DRAFT)
  diajukanOlehId    String?
  diajukanOleh      Pengguna?                 @relation("AjukanPenawaranPenjualan", fields: [diajukanOlehId], references: [id])
  diajukanPada      DateTime?
  disetujuiOlehId   String?
  disetujuiOleh     Pengguna?                 @relation("SetujuiPenawaranPenjualan", fields: [disetujuiOlehId], references: [id])
  disetujuiPada     DateTime?
  ditolakOlehId     String?
  ditolakOleh       Pengguna?                 @relation("TolakPenawaranPenjualan", fields: [ditolakOlehId], references: [id])
  ditolakPada       DateTime?
  catatanPenolakan  String?

  @@index([pelangganId])
  @@index([proyekId])
  @@index([status])
  @@index([tanggal])
  @@index([statusPersetujuan])
}

model BarisPenawaranPenjualan {
  id          String             @id @default(cuid())
  penawaranId String
  penawaran   PenawaranPenjualan @relation(fields: [penawaranId], references: [id])
  barangId    String
  barang      Barang             @relation(fields: [barangId], references: [id])
  jumlah      Decimal            @db.Decimal(18, 2)
  harga       Decimal            @db.Decimal(18, 2)
  subtotal    Decimal            @db.Decimal(18, 2)

  @@index([penawaranId])
  @@index([barangId])
}

model PesananPenjualan {
  id          String              @id @default(cuid())
  nomor       String              @unique
  tanggal     DateTime            @default(now())
  pelangganId String
  pelanggan   Pelanggan           @relation(fields: [pelangganId], references: [id])
  penawaranId String?             @unique
  penawaran   PenawaranPenjualan? @relation(fields: [penawaranId], references: [id])
  status      StatusDokumen       @default(DRAF)
  proyekId    String?
  proyek      Proyek?             @relation(fields: [proyekId], references: [id])
  total       Decimal             @default(0) @db.Decimal(18, 2)

  baris             BarisPesananPenjualan[]
  pengiriman        PengirimanPesanan[]
  faktur            FakturPenjualan[]
  uangMuka          UangMukaPelanggan[]
  /// Persetujuan (maker-checker); lihat src/lib/persetujuan.ts
  statusPersetujuan StatusPersetujuan       @default(DRAFT)
  diajukanOlehId    String?
  diajukanOleh      Pengguna?               @relation("AjukanPesananPenjualan", fields: [diajukanOlehId], references: [id])
  diajukanPada      DateTime?
  disetujuiOlehId   String?
  disetujuiOleh     Pengguna?               @relation("SetujuiPesananPenjualan", fields: [disetujuiOlehId], references: [id])
  disetujuiPada     DateTime?
  ditolakOlehId     String?
  ditolakOleh       Pengguna?               @relation("TolakPesananPenjualan", fields: [ditolakOlehId], references: [id])
  ditolakPada       DateTime?
  catatanPenolakan  String?

  @@index([pelangganId])
  @@index([proyekId])
  @@index([status])
  @@index([tanggal])
  @@index([statusPersetujuan])
}

model BarisPesananPenjualan {
  id             String           @id @default(cuid())
  pesananId      String
  pesanan        PesananPenjualan @relation(fields: [pesananId], references: [id])
  barangId       String
  barang         Barang           @relation(fields: [barangId], references: [id])
  jumlah         Decimal          @db.Decimal(18, 2)
  harga          Decimal          @db.Decimal(18, 2)
  jumlahTerkirim Decimal          @default(0) @db.Decimal(18, 2)
  jumlahDifaktur Decimal          @default(0) @db.Decimal(18, 2)

  barisPengiriman BarisPengiriman[]

  @@index([pesananId])
  @@index([barangId])
}

model PengirimanPesanan {
  id        String           @id @default(cuid())
  nomor     String           @unique
  tanggal   DateTime         @default(now())
  pesananId String
  pesanan   PesananPenjualan @relation(fields: [pesananId], references: [id])
  gudangId  String
  gudang    Gudang           @relation(fields: [gudangId], references: [id])
  status    StatusDokumen    @default(DRAF)
  jurnalId  String?          @unique
  jurnal    Jurnal?          @relation("JurnalPengiriman", fields: [jurnalId], references: [id])

  baris             BarisPengiriman[]
  faktur            FakturPenjualan[]
  /// Persetujuan (maker-checker); lihat src/lib/persetujuan.ts
  statusPersetujuan StatusPersetujuan @default(DRAFT)
  diajukanOlehId    String?
  diajukanOleh      Pengguna?         @relation("AjukanPengirimanPesanan", fields: [diajukanOlehId], references: [id])
  diajukanPada      DateTime?
  disetujuiOlehId   String?
  disetujuiOleh     Pengguna?         @relation("SetujuiPengirimanPesanan", fields: [disetujuiOlehId], references: [id])
  disetujuiPada     DateTime?
  ditolakOlehId     String?
  ditolakOleh       Pengguna?         @relation("TolakPengirimanPesanan", fields: [ditolakOlehId], references: [id])
  ditolakPada       DateTime?
  catatanPenolakan  String?

  @@index([pesananId])
  @@index([gudangId])
  @@index([tanggal])
  @@index([statusPersetujuan])
}

model BarisPengiriman {
  id             String                @id @default(cuid())
  pengirimanId   String
  pengiriman     PengirimanPesanan     @relation(fields: [pengirimanId], references: [id])
  barisPesananId String
  barisPesanan   BarisPesananPenjualan @relation(fields: [barisPesananId], references: [id])
  barangId       String
  barang         Barang                @relation(fields: [barangId], references: [id])
  jumlah         Decimal               @db.Decimal(18, 2)
  /// harga pokok rata-rata saat barang keluar (menilai akun Barang Terkirim Belum Ditagih)
  hargaPokok     Decimal               @default(0) @db.Decimal(18, 2)
  /// bagian dari baris ini yang sudah dikonsumsi Faktur Penjualan (HPP sudah diakui)
  jumlahDifaktur Decimal               @default(0) @db.Decimal(18, 2)

  @@index([pengirimanId])
  @@index([barisPesananId])
  @@index([barangId])
}

model FakturPenjualan {
  id                String              @id @default(cuid())
  nomor             String              @unique
  tanggal           DateTime            @default(now())
  jatuhTempo        DateTime?
  pelangganId       String
  pelanggan         Pelanggan           @relation(fields: [pelangganId], references: [id])
  pesananId         String?
  pesanan           PesananPenjualan?   @relation(fields: [pesananId], references: [id])
  pengirimanId      String?
  pengiriman        PengirimanPesanan?  @relation(fields: [pengirimanId], references: [id])
  status            StatusDokumen       @default(DRAF)
  total             Decimal             @default(0) @db.Decimal(18, 2)
  /// Diskon faktur (kontra-pendapatan, akun Diskon Penjualan); dpp = Σ baris − diskon
  diskon            Decimal             @default(0) @db.Decimal(18, 2)
  /// Dasar pengenaan pajak (Σ baris − diskon) dan PPN; total = dpp + ppn
  dpp               Decimal             @default(0) @db.Decimal(18, 2)
  ppnPersen         Decimal             @default(0) @db.Decimal(5, 2)
  ppn               Decimal             @default(0) @db.Decimal(18, 2)
  /// Uang muka pelanggan (DP pesanan) yang dipakai mengurangi piutang faktur ini
  uangMuka          Decimal             @default(0) @db.Decimal(18, 2)
  /// Mata uang transaksi (kosong = IDR). `kurs` = kurs ke IDR yang dipakai saat dokumen dibuat (snapshot),
  /// `nilaiAsli` = nilai total dalam mata uang transaksi. Kolom uang lain (total/dpp/ppn/diskon) selalu IDR.
  mataUangId        String?             @map("mataUangId")
  mataUang          MataUang?           @relation(fields: [mataUangId], references: [id])
  kurs              Decimal             @default(1) @db.Decimal(18, 6)
  nilaiAsli         Decimal?            @db.Decimal(18, 2)
  /// Kurs yang saldo terbukanya saat ini dibawa di buku besar. Kosong = masih kurs dokumen (`kurs`).
  /// Diisi penilaian kembali (src/lib/selisihKurs.ts) supaya penilaian berikutnya hanya mencatat
  /// selisih sejak penilaian terakhir, bukan menghitung ulang dari kurs asli (idempoten).
  kursRevaluasi     Decimal?            @db.Decimal(18, 6)
  revaluasiPada     DateTime?
  jurnalId          String?             @unique
  jurnal            Jurnal?             @relation("JurnalFakturPenjualan", fields: [jurnalId], references: [id])
  pemakaianUangMuka PemakaianUangMuka[]

  baris             BarisFakturPenjualan[]
  penerimaan        PenerimaanPenjualan[]
  retur             ReturPenjualan[]
  /// Persetujuan (maker-checker); lihat src/lib/persetujuan.ts
  statusPersetujuan StatusPersetujuan      @default(DRAFT)
  diajukanOlehId    String?
  diajukanOleh      Pengguna?              @relation("AjukanFakturPenjualan", fields: [diajukanOlehId], references: [id])
  diajukanPada      DateTime?
  disetujuiOlehId   String?
  disetujuiOleh     Pengguna?              @relation("SetujuiFakturPenjualan", fields: [disetujuiOlehId], references: [id])
  disetujuiPada     DateTime?
  ditolakOlehId     String?
  ditolakOleh       Pengguna?              @relation("TolakFakturPenjualan", fields: [ditolakOlehId], references: [id])
  ditolakPada       DateTime?
  catatanPenolakan  String?

  @@index([pelangganId])
  @@index([pesananId])
  @@index([pengirimanId])
  @@index([status])
  @@index([tanggal])
  @@index([statusPersetujuan])
}

model BarisFakturPenjualan {
  id           String          @id @default(cuid())
  fakturId     String
  faktur       FakturPenjualan @relation(fields: [fakturId], references: [id])
  barangId     String
  barang       Barang          @relation(fields: [barangId], references: [id])
  jumlah       Decimal         @db.Decimal(18, 2)
  harga        Decimal         @db.Decimal(18, 2)
  subtotal     Decimal         @db.Decimal(18, 2)
  /// Nilai "Barang Terkirim Belum Ditagih" yang dikonsumsi baris ini saat faktur dibuat (surat jalan
  /// mendahului faktur). Disimpan karena jurnal HPP baru dicatat saat faktur DISETUJUI, sedangkan
  /// konsumsi baris surat jalannya sudah terjadi saat draf dibuat.
  nilaiTransit Decimal         @default(0) @db.Decimal(18, 2)

  @@index([fakturId])
  @@index([barangId])
}

model UangMukaPelanggan {
  id            String           @id @default(cuid())
  nomor         String           @unique
  tanggal       DateTime         @default(now())
  pelangganId   String
  pelanggan     Pelanggan        @relation(fields: [pelangganId], references: [id])
  pesananId     String
  pesanan       PesananPenjualan @relation(fields: [pesananId], references: [id])
  akunId        String
  akun          Akun             @relation("AkunUangMuka", fields: [akunId], references: [id])
  /// DP yang diterima; jumlahDipakai = bagian yang sudah mengurangi faktur
  jumlah        Decimal          @db.Decimal(18, 2)
  jumlahDipakai Decimal          @default(0) @db.Decimal(18, 2)
  metodeBayar   String           @default("TRANSFER")
  keterangan    String?
  jurnalId      String?          @unique
  jurnal        Jurnal?          @relation("JurnalUangMuka", fields: [jurnalId], references: [id])

  pemakaian         PemakaianUangMuka[]
