// Produksia: skema data (seluruh penamaan dalam bahasa Indonesia)
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/prisma-klien"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enum ----------

enum StatusDokumen {
  DRAF
  DIKONVERSI
  DIPROSES
  LUNAS
  SEBAGIAN
  DIBATALKAN
}

enum JenisBarang {
  BARANG
  JASA
}

enum PeranPengguna {
  SUPERADMIN
  PEMILIK
  ADMIN
  KASIR
  GUDANG
  /// Kru lapangan (internal): hanya bisa ajukan/ajukan-kembali Peminjaman Barang, menunggu persetujuan Gudang
  KRU
  /// Tamu/pihak luar: sama seperti Kru tapi TANPA Laporan Kerusakan Barang, dan tanpa wajib nomor WhatsApp saat didaftarkan
  GUEST
  /// Pengelola media sosial (HKA social_media_manager): konten, permintaan dan persetujuan tugas desain
  SOSMED
  /// Pengelola iklan (HKA ads_manager): kampanye iklan Meta, permintaan tugas desain
  IKLAN
  /// Desainer (HKA designer): mengerjakan tugas desain, tanpa membuat atau menyetujui tugas
  DESAINER
}

enum JenisAkun {
  ASET
  KEWAJIBAN
  MODAL
  PENDAPATAN
  BEBAN
}

enum SumberJurnal {
  MANUAL
  /// Penilaian kembali piutang/hutang mata uang asing ke kurs akhir periode (src/lib/selisihKurs.ts)
  SELISIH_KURS
  PENUTUP
  PAJAK
  PRIVE
  KAS_MASUK
  KAS_KELUAR
  PENJUALAN
  PEMBELIAN
  PENYUSUTAN
  PERSEDIAAN
  ASET_TETAP
  PENGGAJIAN
  /// Jurnal berpasangan transaksi antar perusahaan (model TransaksiAntarPerusahaan); dihapus lewat dokumennya
  ANTAR_PERUSAHAAN
  /// Jurnal dokumen mitra proyek: Talangan Mitra (JU-TLM) dan Pembayaran ke Mitra (JU-BYM), lihat src/lib/keuanganProyek.ts
  MITRA_PROYEK
}

enum StatusAset {
  AKTIF
  DIJUAL
  DIHAPUS
}

/// Alur persetujuan dokumen (maker-checker / pemisahan tugas):
/// DRAFT = baru dibuat, belum masuk buku besar · MENUNGGU = sudah diajukan, menunggu pemeriksa ·
/// DISETUJUI = jurnalnya sudah dicatat · DITOLAK = dikembalikan ke pembuat dengan catatan.
enum StatusPersetujuan {
  DRAFT
  MENUNGGU
  DISETUJUI
  DITOLAK
}

enum JenisDokumenKas {
  MASUK
  KELUAR
}

/// Tahap foto bukti pada Peminjaman Barang: saat barang keluar (loading out) atau kembali (loading in)
enum TahapFoto {
  KELUAR
  KEMBALI
}

/// Jenis entitas (paritas HKA companies.type: agency | brand | client). Hanya informasi tampilan.
enum JenisPerusahaan {
  AGENSI
  MEREK
  KLIEN
}

/// Arah transaksi antar perusahaan (lihat model TransaksiAntarPerusahaan).
/// TAGIH = pemberi menanggung/membayarkan sesuatu untuk penerima, timbul piutang (pemberi) dan hutang (penerima) antar perusahaan.
/// LUNAS = penerima melunasi hutang antar perusahaannya ke pemberi.
enum JenisAntarPerusahaan {
  TAGIH
  LUNAS
}

/// Penanda lampiran (HKA tag reference/output/document). null dibaca REFERENSI.
/// DOKUMEN = PDF buatan sistem yang disimpan dari halaman cetak (D3).
enum TagBerkas {
  REFERENSI
  HASIL
  DOKUMEN
}

/// Jenis notifikasi dalam aplikasi. Padanan HKA: assignment, status, approval, approval_result,
/// revision, follow_up, invoice_due. Nilai INFO HKA tidak dipakai pemanggil mana pun, jadi tidak dibawa.
enum JenisNotifikasi {
  PENUGASAN
  STATUS
  PERSETUJUAN
  HASIL_PERSETUJUAN
  REVISI
  TINDAK_LANJUT
  JATUH_TEMPO
}

// ---------- Pengguna ----------

model Pengguna {
  id                           String                   @id @default(cuid())
  /// Identitas masuk (huruf kecil, unik); email hanya kontak opsional
  namaPengguna                 String                   @unique
  email                        String?                  @unique
  /// Wajib untuk semua peran KECUALI GUEST (lihat pastikanNomorTelepon di src/lib/aksi/pengguna.ts).
  /// Format +62..., dipakai untuk kirim template WhatsApp saat peminjaman/kerusakan menunggu konfirmasi.
  nomorTelepon                 String?
  nama                         String
  kataSandiHash                String
  peran                        PeranPengguna            @default(KASIR)
  aktif                        Boolean                  @default(true)
  /// Peran tambahan (HKA: banyak peran per pengguna). Hanya SOSMED, IKLAN, DESAINER (dijaga src/lib/aksi/pengguna.ts).
  /// Hak efektif = gabungan peran utama dan tambahan. Logika lama yang membaca `peran` tetap memakai peran utama.
  peranTambahan                PeranPengguna[]          @default([])
  karyawan                     Karyawan?
  /// Foto profil (opsional); satu-satunya bidang profil yang boleh diubah sendiri oleh peran non-Superadmin/Pemilik
  fotoProfil                   Foto?
  sesi                         Sesi[]
  permintaanAturUlang          PermintaanAturUlang[]
  dibuatPada                   DateTime                 @default(now())
  /// Relasi balik alur persetujuan: siapa mengajukan / menyetujui / menolak tiap jenis dokumen
  ajukanPenawaranPenjualan     PenawaranPenjualan[]     @relation("AjukanPenawaranPenjualan")
  setujuiPenawaranPenjualan    PenawaranPenjualan[]     @relation("SetujuiPenawaranPenjualan")
  tolakPenawaranPenjualan      PenawaranPenjualan[]     @relation("TolakPenawaranPenjualan")
  ajukanPesananPenjualan       PesananPenjualan[]       @relation("AjukanPesananPenjualan")
  setujuiPesananPenjualan      PesananPenjualan[]       @relation("SetujuiPesananPenjualan")
  tolakPesananPenjualan        PesananPenjualan[]       @relation("TolakPesananPenjualan")
  ajukanUangMukaPelanggan      UangMukaPelanggan[]      @relation("AjukanUangMukaPelanggan")
  setujuiUangMukaPelanggan     UangMukaPelanggan[]      @relation("SetujuiUangMukaPelanggan")
  tolakUangMukaPelanggan       UangMukaPelanggan[]      @relation("TolakUangMukaPelanggan")
  ajukanPengirimanPesanan      PengirimanPesanan[]      @relation("AjukanPengirimanPesanan")
  setujuiPengirimanPesanan     PengirimanPesanan[]      @relation("SetujuiPengirimanPesanan")
  tolakPengirimanPesanan       PengirimanPesanan[]      @relation("TolakPengirimanPesanan")
  ajukanFakturPenjualan        FakturPenjualan[]        @relation("AjukanFakturPenjualan")
  setujuiFakturPenjualan       FakturPenjualan[]        @relation("SetujuiFakturPenjualan")
  tolakFakturPenjualan         FakturPenjualan[]        @relation("TolakFakturPenjualan")
  ajukanPenerimaanPenjualan    PenerimaanPenjualan[]    @relation("AjukanPenerimaanPenjualan")
  setujuiPenerimaanPenjualan   PenerimaanPenjualan[]    @relation("SetujuiPenerimaanPenjualan")
  tolakPenerimaanPenjualan     PenerimaanPenjualan[]    @relation("TolakPenerimaanPenjualan")
  ajukanReturPenjualan         ReturPenjualan[]         @relation("AjukanReturPenjualan")
  setujuiReturPenjualan        ReturPenjualan[]         @relation("SetujuiReturPenjualan")
  tolakReturPenjualan          ReturPenjualan[]         @relation("TolakReturPenjualan")
  ajukanPesananPembelian       PesananPembelian[]       @relation("AjukanPesananPembelian")
  setujuiPesananPembelian      PesananPembelian[]       @relation("SetujuiPesananPembelian")
  tolakPesananPembelian        PesananPembelian[]       @relation("TolakPesananPembelian")
  ajukanPenerimaanBarang       PenerimaanBarang[]       @relation("AjukanPenerimaanBarang")
  setujuiPenerimaanBarang      PenerimaanBarang[]       @relation("SetujuiPenerimaanBarang")
  tolakPenerimaanBarang        PenerimaanBarang[]       @relation("TolakPenerimaanBarang")
  ajukanFakturPembelian        FakturPembelian[]        @relation("AjukanFakturPembelian")
  setujuiFakturPembelian       FakturPembelian[]        @relation("SetujuiFakturPembelian")
  tolakFakturPembelian         FakturPembelian[]        @relation("TolakFakturPembelian")
  ajukanPembayaranPembelian    PembayaranPembelian[]    @relation("AjukanPembayaranPembelian")
  setujuiPembayaranPembelian   PembayaranPembelian[]    @relation("SetujuiPembayaranPembelian")
  tolakPembayaranPembelian     PembayaranPembelian[]    @relation("TolakPembayaranPembelian")
  ajukanReturPembelian         ReturPembelian[]         @relation("AjukanReturPembelian")
  setujuiReturPembelian        ReturPembelian[]         @relation("SetujuiReturPembelian")
  tolakReturPembelian          ReturPembelian[]         @relation("TolakReturPembelian")
  ajukanJurnal                 Jurnal[]                 @relation("AjukanJurnal")
  setujuiJurnal                Jurnal[]                 @relation("SetujuiJurnal")
  tolakJurnal                  Jurnal[]                 @relation("TolakJurnal")
  ajukanPenyesuaianPersediaan  PenyesuaianPersediaan[]  @relation("AjukanPenyesuaianPersediaan")
  setujuiPenyesuaianPersediaan PenyesuaianPersediaan[]  @relation("SetujuiPenyesuaianPersediaan")
  tolakPenyesuaianPersediaan   PenyesuaianPersediaan[]  @relation("TolakPenyesuaianPersediaan")
  ajukanPindahBarang           PindahBarang[]           @relation("AjukanPindahBarang")
  setujuiPindahBarang          PindahBarang[]           @relation("SetujuiPindahBarang")
  tolakPindahBarang            PindahBarang[]           @relation("TolakPindahBarang")
  ajukanAsetTetap              AsetTetap[]              @relation("AjukanAsetTetap")
  setujuiAsetTetap             AsetTetap[]              @relation("SetujuiAsetTetap")
  tolakAsetTetap               AsetTetap[]              @relation("TolakAsetTetap")
  ajukanPelepasanAset          PelepasanAset[]          @relation("AjukanPelepasanAset")
  setujuiPelepasanAset         PelepasanAset[]          @relation("SetujuiPelepasanAset")
  tolakPelepasanAset           PelepasanAset[]          @relation("TolakPelepasanAset")
  ajukanPrive                  Prive[]                  @relation("AjukanPrive")
  setujuiPrive                 Prive[]                  @relation("SetujuiPrive")
  tolakPrive                   Prive[]                  @relation("TolakPrive")
  ajukanPenggajian             Penggajian[]             @relation("AjukanPenggajian")
  setujuiPenggajian            Penggajian[]             @relation("SetujuiPenggajian")
  tolakPenggajian              Penggajian[]             @relation("TolakPenggajian")
  ajukanTutupBuku              TutupBuku[]              @relation("AjukanTutupBuku")
  setujuiTutupBuku             TutupBuku[]              @relation("SetujuiTutupBuku")
  tolakTutupBuku               TutupBuku[]              @relation("TolakTutupBuku")
  ajukanPphFinalBulanan        PphFinalBulanan[]        @relation("AjukanPphFinalBulanan")
  setujuiPphFinalBulanan       PphFinalBulanan[]        @relation("SetujuiPphFinalBulanan")
  tolakPphFinalBulanan         PphFinalBulanan[]        @relation("TolakPphFinalBulanan")
  ajukanDokumenKas             DokumenKas[]             @relation("AjukanDokumenKas")
  setujuiDokumenKas            DokumenKas[]             @relation("SetujuiDokumenKas")
  tolakDokumenKas              DokumenKas[]             @relation("TolakDokumenKas")
  catatPeminjamanBarang        PeminjamanBarang[]       @relation("CatatPeminjamanBarang")
  ajukanPeminjamanBarang       PeminjamanBarang[]       @relation("AjukanPeminjamanBarang")
  setujuiPeminjamanBarang      PeminjamanBarang[]       @relation("SetujuiPeminjamanBarang")
  tolakPeminjamanBarang        PeminjamanBarang[]       @relation("TolakPeminjamanBarang")
  catatKerusakanBarang         LaporanKerusakanBarang[] @relation("CatatKerusakanBarang")
  ajukanKerusakanBarang        LaporanKerusakanBarang[] @relation("AjukanKerusakanBarang")
  setujuiKerusakanBarang       LaporanKerusakanBarang[] @relation("SetujuiKerusakanBarang")
  tolakKerusakanBarang         LaporanKerusakanBarang[] @relation("TolakKerusakanBarang")

  // ---- multi perusahaan (D1) ----
  catatAntarPerusahaan TransaksiAntarPerusahaan[] @relation("CatatAntarPerusahaan")

  // ---- platform (D7): berkas, tautan bagi, akses proyek, notifikasi ----
  unggahBerkas          Berkas[]                    @relation("UnggahBerkas")
  buangBerkas           Berkas[]                    @relation("BuangBerkas")
  buatTautanBagi        TautanBagiBerkas[]          @relation("BuatTautanBagi")
  cabutTautanBagi       TautanBagiBerkas[]          @relation("CabutTautanBagi")
  ubahAksesBerkasProyek AksesBerkasProyek[]         @relation("UbahAksesBerkasProyek")
  aksesBerkasProyek     AksesBerkasProyekPengguna[] @relation("AksesBerkasProyekPengguna")
  notifikasi            Notifikasi[]                @relation("NotifikasiPengguna")

  // ---- modul CRM (D4) ----
  picLead                Lead[]          @relation("PicLead")
  buatLead               Lead[]          @relation("BuatLead")
  arsipkanLead           Lead[]          @relation("ArsipkanLead")
  aktivitasLead          AktivitasLead[] @relation("PelakuAktivitasLead")
  tindakLanjutDitugaskan TindakLanjut[]  @relation("TindakLanjutDitugaskan")
  buatTindakLanjut       TindakLanjut[]  @relation("BuatTindakLanjut")

  // ---- keuangan proyek (D5) ----
  catatTalanganMitra     TalanganMitra[]   @relation("CatatTalanganMitra")
  ajukanTalanganMitra    TalanganMitra[]   @relation("AjukanTalanganMitra")
  setujuiTalanganMitra   TalanganMitra[]   @relation("SetujuiTalanganMitra")
  tolakTalanganMitra     TalanganMitra[]   @relation("TolakTalanganMitra")
  catatPembayaranMitra   PembayaranMitra[] @relation("CatatPembayaranMitra")
  ajukanPembayaranMitra  PembayaranMitra[] @relation("AjukanPembayaranMitra")
  setujuiPembayaranMitra PembayaranMitra[] @relation("SetujuiPembayaranMitra")
  tolakPembayaranMitra   PembayaranMitra[] @relation("TolakPembayaranMitra")

  // ---- modul Pemasaran (D6) ----
  kontenSmm       Konten[]      @relation("SmmKonten")
  kontenDesainer  Konten[]      @relation("DesainerKonten")
  kontenDibuat    Konten[]      @relation("BuatKonten")
  tugasDesainSaya TugasDesain[] @relation("DesainerTugas")
}

/// Sesi login berbasis basis data: cookie hanya menyimpan token acak, yang disimpan di sini dalam bentuk hash.
model Sesi {
  id          String   @id @default(cuid())
  tokenHash   String   @unique
  penggunaId  String
  pengguna    Pengguna @relation(fields: [penggunaId], references: [id], onDelete: Cascade)
  kedaluwarsa DateTime
  dibuatPada  DateTime @default(now())

  /// Lingkup perusahaan pilihan pengguna di sesi ini; null = belum memilih (gabungan bila berhak, selain itu utama)
  perusahaanAktifId String?
  perusahaanAktif   Perusahaan? @relation(fields: [perusahaanAktifId], references: [id], onDelete: SetNull)

  @@index([penggunaId])
  @@index([kedaluwarsa])
  @@index([perusahaanAktifId])
}

/// Catatan percobaan masuk yang GAGAL, untuk membatasi laju (anti brute-force/credential-stuffing).
/// Dikunci per akun DAN per IP; baris lama dibersihkan otomatis saat percobaan baru dicatat.
model PercobaanMasuk {
  id           String   @id @default(cuid())
  namaPengguna String
  ip           String
  waktu        DateTime @default(now())

  @@index([namaPengguna, waktu])
  @@index([ip, waktu])
}

// ---------- Perusahaan (multi entitas) ----------

/// Satu entitas/badan usaha dengan pembukuan sendiri. id "utama" = D'Production (DPRO): pemilik semua data
/// sebelum multi perusahaan dan nilai bawaan setiap kolom perusahaanId. Perusahaan utama tidak boleh dinonaktifkan.
/// id perusahaan standar D'Pro berupa slug tetap (utama, tapussa, smara, bonanova, sahara, nawasena); perusahaan
/// yang dibuat lewat UI memakai cuid. Tidak ada hapus fisik: arsip = aktif false (relasi Restrict menolak hapus).
model Perusahaan {
  id                   String          @id @default(cuid())
  /// Kode tampilan (lencana, kolom laporan, pemilih): ^[A-Z0-9]{2,12}$, unik. BUKAN bagian nomor cetak.
  kode                 String          @unique
  /// Nama tampilan, 1-120 karakter
  nama                 String
  /// Nama badan hukum (mis. "CV Tapussa Bhallika"); kosong = sama dengan nama
  namaLegal            String?
  jenis                JenisPerusahaan @default(AGENSI)
  industri             String?
  alamat               String?
  kota                 String?
  telepon              String?
  email                String?
  website              String?
  instagram            String?
  /// NPWP 15 atau 16 digit (tanda baca boleh); dipakai cetak & SPT
  npwp                 String?
  /// Keterangan pajak bebas (paritas HKA tax_info)
  infoPajak            String?
  /// Rekening bawaan untuk teks cetak (paritas HKA bank_name/bank_account/bank_holder). Bukan akun buku besar.
  namaBank             String?
  cabangBank           String?
  nomorRekening        String?
  atasNamaRekening     String?
  /// Penanda tangan bawaan dokumen cetak
  penandaTangan        String?
  jabatanPenandaTangan String?
  /// Warna merek #RRGGBB untuk lencana perusahaan di UI
  warna                String?
  catatan              String?
  /// false = diarsipkan: tidak bisa dipakai dokumen baru, pembukuannya tetap tampil di laporan
  aktif                Boolean         @default(true)
  /// Urutan tampil di pemilih dan tabel
  urutan               Int             @default(0)
  dibuatPada           DateTime        @default(now())
  diubahPada           DateTime        @updatedAt

  // ---- multi perusahaan (D1) ----
  pengaturan             PengaturanPerusahaan?
  sesiAktif              Sesi[]
  akun                   Akun[]
  gudang                 Gudang[]
  barang                 Barang[]
  proyek                 Proyek[]
  karyawan               Karyawan[]
  jurnal                 Jurnal[]
  penawaranPenjualan     PenawaranPenjualan[]
  pesananPenjualan       PesananPenjualan[]
  pengirimanPesanan      PengirimanPesanan[]
  fakturPenjualan        FakturPenjualan[]
  uangMukaPelanggan      UangMukaPelanggan[]
  penerimaanPenjualan    PenerimaanPenjualan[]
  returPenjualan         ReturPenjualan[]
  pesananPembelian       PesananPembelian[]
  penerimaanBarang       PenerimaanBarang[]
  fakturPembelian        FakturPembelian[]
  pembayaranPembelian    PembayaranPembelian[]
  returPembelian         ReturPembelian[]
  dokumenKas             DokumenKas[]
  asetTetap              AsetTetap[]
  pindahBarang           PindahBarang[]
  penyesuaianPersediaan  PenyesuaianPersediaan[]
  peminjamanBarang       PeminjamanBarang[]
  laporanKerusakanBarang LaporanKerusakanBarang[]
  prive                  Prive[]
  penggajian             Penggajian[]
  pphFinalBulanan        PphFinalBulanan[]
  tutupBuku              TutupBukuPerusahaan[]
  antarSebagaiPemberi    TransaksiAntarPerusahaan[] @relation("PemberiAntarPerusahaan")
  antarSebagaiPenerima   TransaksiAntarPerusahaan[] @relation("PenerimaAntarPerusahaan")

  // ---- platform (D7) ----
  berkas     Berkas[]
  notifikasi Notifikasi[]

  // ---- dokumen penjualan (D2) ----
  rencanaTermin              RencanaTermin[]
  formatNomor                FormatNomor[]
  penghitungNomor            PenghitungNomor[]
  pengaturanDokumenPenjualan PengaturanDokumenPenjualan?

  // ---- cetak & kop surat (D3) ----
  kopSurat KopSurat[]

  // ---- modul CRM (D4) ----
  lead         Lead[]
  tahapLead    TahapLead[]
  sumberLead   SumberLead[]
  tindakLanjut TindakLanjut[]

  // ---- keuangan proyek (D5) ----
  talanganMitra   TalanganMitra[]
  pembayaranMitra PembayaranMitra[]

  // ---- modul Pemasaran (D6) ----
  konten              Konten[]
  tugasDesain         TugasDesain[]
  kampanye            Kampanye[]
  pengaturanPemasaran PengaturanPemasaran?

  @@index([aktif, urutan])
}

/// Rincian tutup buku serentak (K4): satu baris per perusahaan yang punya saldo pendapatan/beban di tahun itu,
/// dengan JU-TUTUP milik perusahaan itu. TutupBuku.tahun tetap unik global (satu kunci tahun untuk semua perusahaan).
model TutupBukuPerusahaan {
  id           String     @id @default(cuid())
  tutupBukuId  String
  tutupBuku    TutupBuku  @relation(fields: [tutupBukuId], references: [id], onDelete: Cascade)
  perusahaanId String     @default("utama")
  perusahaan   Perusahaan @relation(fields: [perusahaanId], references: [id])
  labaBersih   Decimal    @db.Decimal(18, 2)
  jurnalId     String?    @unique
  jurnal       Jurnal?    @relation("JurnalTutupBukuPerusahaan", fields: [jurnalId], references: [id])

  @@unique([tutupBukuId, perusahaanId])
  @@index([perusahaanId])
}

/// Transaksi antar perusahaan grup (K5): DUA jurnal dalam satu transaksi basis data, satu di buku tiap perusahaan,
/// masing-masing seimbang. Pengecualian kontrak "satu perusahaanId per dokumen": dokumen ini milik dua perusahaan.
/// TAGIH: pemberi  Dr Piutang Antar Perusahaan / Cr akunPemberi;  penerima Dr akunPenerima / Cr Hutang Antar Perusahaan.
/// LUNAS: penerima Dr Hutang Antar Perusahaan / Cr akunPenerima;  pemberi  Dr akunPemberi / Cr Piutang Antar Perusahaan.
model TransaksiAntarPerusahaan {
  id               String               @id @default(cuid())
  /// "AP-YYYY-NNNN" (nomorDokumenBerikutnya)
  nomor            String               @unique
  tanggal          DateTime
  jenis            JenisAntarPerusahaan
  /// Perusahaan yang memegang piutang antar perusahaan
  pemberiId        String
  pemberi          Perusahaan           @relation("PemberiAntarPerusahaan", fields: [pemberiId], references: [id])
  /// Perusahaan yang memegang hutang antar perusahaan
  penerimaId       String
  penerima         Perusahaan           @relation("PenerimaAntarPerusahaan", fields: [penerimaId], references: [id])
  jumlah           Decimal              @db.Decimal(18, 2)
  keterangan       String
  /// Akun lawan di buku pemberi (TAGIH: dikredit, mis. Kas pemberi; LUNAS: didebit, mis. Kas pemberi)
  akunPemberiId    String
  akunPemberi      Akun                 @relation("AkunPemberiAntarPerusahaan", fields: [akunPemberiId], references: [id])
  /// Akun lawan di buku penerima (TAGIH: didebit, mis. Beban/Aset/Hutang Usaha; LUNAS: dikredit, mis. Kas penerima)
  akunPenerimaId   String
  akunPenerima     Akun                 @relation("AkunPenerimaAntarPerusahaan", fields: [akunPenerimaId], references: [id])
  proyekPemberiId  String?
  proyekPemberi    Proyek?              @relation("ProyekPemberiAntarPerusahaan", fields: [proyekPemberiId], references: [id])
  proyekPenerimaId String?
  proyekPenerima   Proyek?              @relation("ProyekPenerimaAntarPerusahaan", fields: [proyekPenerimaId], references: [id])
  jurnalPemberiId  String?              @unique
  jurnalPemberi    Jurnal?              @relation("JurnalPemberiAntarPerusahaan", fields: [jurnalPemberiId], references: [id])
  jurnalPenerimaId String?              @unique
  jurnalPenerima   Jurnal?              @relation("JurnalPenerimaAntarPerusahaan", fields: [jurnalPenerimaId], references: [id])
  dicatatOlehId    String?
  dicatatOleh      Pengguna?            @relation("CatatAntarPerusahaan", fields: [dicatatOlehId], references: [id], onDelete: SetNull)
  dicatatOlehNama  String
  dibuatPada       DateTime             @default(now())

  @@index([pemberiId])
  @@index([penerimaId])
  @@index([tanggal])
  @@index([akunPemberiId])
  @@index([akunPenerimaId])
  @@index([proyekPemberiId])
  @@index([proyekPenerimaId])
  @@index([dicatatOlehId])
}

// ---------- Mata uang & kurs ----------

/// Mata uang transaksi. IDR adalah mata uang fungsional (mata uang pelaporan): seluruh buku besar
/// tetap dicatat dalam IDR, mata uang asing hanya melekat pada dokumen dan saldo piutang/hutangnya.
model MataUang {
  id         String   @id @default(cuid())
  /// Kode ISO 4217, mis. IDR, USD, EUR, SGD
  kode       String   @unique
  nama       String
  simbol     String   @default("")
  /// Jumlah angka desimal yang lazim (IDR 0, USD 2, JPY 0)
  desimal    Int      @default(2)
  aktif      Boolean  @default(true)
  /// Mata uang fungsional/pelaporan (IDR); tepat satu baris bernilai true dan kursnya selalu 1
  fungsional Boolean  @default(false)
  dibuatPada DateTime @default(now())

  kurs                KursMataUang[]
  pelanggan           Pelanggan[]
  pemasok             Pemasok[]
  fakturPenjualan     FakturPenjualan[]
  fakturPembelian     FakturPembelian[]
  penerimaanPenjualan PenerimaanPenjualan[]
  pembayaranPembelian PembayaranPembelian[]
  barisJurnalAsli     BarisJurnal[]         @relation("MataUangAsliBarisJurnal")
}

/// Riwayat kurs terhadap IDR: 1 unit mata uang = `kurs` rupiah pada `tanggal`.
/// Dokumen menyimpan kurs yang dipakai (snapshot), jadi jurnal lama tidak berubah saat kurs baru dimasukkan.
model KursMataUang {
  id          String   @id @default(cuid())
  mataUangId  String
  mataUang    MataUang @relation(fields: [mataUangId], references: [id], onDelete: Cascade)
  tanggal     DateTime
  kurs        Decimal  @db.Decimal(18, 6)
  sumber      String?
  dicatatOleh String?
  dibuatPada  DateTime @default(now())

  @@unique([mataUangId, tanggal])
  @@index([mataUangId, tanggal])
}

// ---------- Data induk ----------

model Departemen {
  id       String     @id @default(cuid())
  nama     String
  karyawan Karyawan[]
}

model Karyawan {
  id               String            @id @default(cuid())
  kode             String            @unique
  nama             String
  departemenId     String?
  departemen       Departemen?       @relation(fields: [departemenId], references: [id])
  penggunaId       String?           @unique
  pengguna         Pengguna?         @relation(fields: [penggunaId], references: [id])
  pelanggan        Pelanggan[]
  /// Siklus SDM: data kepegawaian dan komponen gaji bulanan bawaan (bisa disesuaikan per baris saat Proses Gaji)
  jabatan          String?
  tanggalBergabung DateTime?
  status           String            @default("AKTIF") // AKTIF | NONAKTIF
  gajiPokok        Decimal           @default(0) @db.Decimal(18, 2)
  tunjangan        Decimal           @default(0) @db.Decimal(18, 2)
  /// Akun beban khusus karyawan ini (mis. Upah Harian/Honor Volunteer alih-alih Gaji Pokok); kosong = pemetaan tambahan "bebanGaji"
  akunBebanId      String?
  akunBeban        Akun?             @relation("AkunBebanKaryawan", fields: [akunBebanId], references: [id])
  barisPenggajian  BarisPenggajian[]
  dibuatPada       DateTime          @default(now())

  /// Pemilik data (lihat model Perusahaan); dipilih wajib di formulir data induk
  perusahaanId String     @default("utama")
  perusahaan   Perusahaan @relation(fields: [perusahaanId], references: [id])

  @@index([departemenId])
  @@index([akunBebanId])
  @@index([perusahaanId])
}

model Pelanggan {
  id         String    @id @default(cuid())
  kode       String    @unique
  nama       String
  alamat     String?
  telepon    String?
  /// Nama orang yang dihubungi (konversi lead, cetak dokumen). Kolom bersama CRM (D4) dan dokumen penjualan (D2).
  namaKontak String?
  /// Email kontak pelanggan. Kolom bersama CRM (D4) dan dokumen penjualan (D2).
  email      String?
  npwp       String?
  penjualId  String?
  penjual    Karyawan? @relation(fields: [penjualId], references: [id])
  /// Mata uang transaksi bawaan pelanggan (kosong = IDR / mata uang fungsional)
  mataUangId String?
  mataUang   MataUang? @relation(fields: [mataUangId], references: [id])

  penawaran  PenawaranPenjualan[]
  pesanan    PesananPenjualan[]
  faktur     FakturPenjualan[]
  penerimaan PenerimaanPenjualan[]
  proyek     Proyek[]
  uangMuka   UangMukaPelanggan[]
  dibuatPada DateTime              @default(now())

  // ---- modul CRM (D4) ----
  lead Lead[]

  @@index([penjualId])
}

model Pemasok {
  id         String    @id @default(cuid())
  kode       String    @unique
  nama       String
  alamat     String?
  telepon    String?
  /// Mata uang transaksi bawaan pemasok (kosong = IDR / mata uang fungsional)
  mataUangId String?
  mataUang   MataUang? @relation(fields: [mataUangId], references: [id])
  dibuatPada DateTime  @default(now())

  pesanan    PesananPembelian[]
  faktur     FakturPembelian[]
  pembayaran PembayaranPembelian[]
}

/// Proyek = event/pekerjaan: dimensi transaksi untuk Laba Rugi per event dan Rekonsiliasi Event (LPJ)
model Proyek {
  id             String     @id @default(cuid())
  kode           String     @unique
  nama           String
  pelangganId    String?
  pelanggan      Pelanggan? @relation(fields: [pelangganId], references: [id])
  status         String     @default("BERJALAN")
  /// Nilai proposal/kontrak yang disetujui klien dan anggaran biaya — pembanding realisasi di LPJ
  nilaiKontrak   Decimal?   @db.Decimal(18, 2)
  anggaranBiaya  Decimal?   @db.Decimal(18, 2)
  tanggalMulai   DateTime?
  tanggalSelesai DateTime?
  keterangan     String?
  /// Warna lencana proyek, format #rrggbb huruf kecil (HKA color). Kosong = abu-abu bawaan (#71717a)
  warna          String?
  /// Nama klien teks bebas (HKA client_name, ≤160). Dipakai bila pelangganId kosong
  namaKlien      String?

  /// Pemilik data (lihat model Perusahaan); dipilih wajib di formulir data induk
  perusahaanId String     @default("utama")
  perusahaan   Perusahaan @relation(fields: [perusahaanId], references: [id])

  penawaran        PenawaranPenjualan[]
  pesanan          PesananPenjualan[]
  pesananPembelian PesananPembelian[]
  jurnal           Jurnal[]
  penggajian       Penggajian[]
  dokumenKas       DokumenKas[]
  peminjaman       PeminjamanBarang[]
  kerusakan        LaporanKerusakanBarang[]

  // ---- multi perusahaan (D1) ----
  antarSebagaiProyekPemberi  TransaksiAntarPerusahaan[] @relation("ProyekPemberiAntarPerusahaan")
  antarSebagaiProyekPenerima TransaksiAntarPerusahaan[] @relation("ProyekPenerimaAntarPerusahaan")

  // ---- platform (D7) ----
  berkas      Berkas[]
  aksesBerkas AksesBerkasProyek?

  // ---- keuangan proyek (D5) ----
  barisAnggaran   BarisAnggaranProyek[]
  mitra           MitraProyek[]
  talanganMitra   TalanganMitra[]
  pembayaranMitra PembayaranMitra[]

  // ---- modul Pemasaran (D6) ----
  konten      Konten[]
  tugasDesain TugasDesain[]
  kampanye    Kampanye[]

  @@index([pelangganId])
  @@index([perusahaanId])
  @@index([status])
}

model Gudang {
  id     String  @id @default(cuid())
  kode   String  @unique
  nama   String
  alamat String?

  /// Pemilik gudang (opsional). null = gudang fisik bersama, boleh menyimpan barang milik beberapa perusahaan.
  /// Terisi = hanya dokumen perusahaan itu. Kepemilikan stok ditentukan Barang.perusahaanId, bukan gudang.
  perusahaanId String?
  perusahaan   Perusahaan? @relation(fields: [perusahaanId], references: [id], onDelete: Restrict)

  stok             StokBarang[]
  pengiriman       PengirimanPesanan[]
  returPenjualan   ReturPenjualan[]
  penerimaanBarang PenerimaanBarang[]
  returPembelian   ReturPembelian[]
  penyesuaian      PenyesuaianPersediaan[]
  pindahAsal       PindahBarang[]           @relation("GudangAsalPindah")
  pindahTujuan     PindahBarang[]           @relation("GudangTujuanPindah")
  peminjaman       PeminjamanBarang[]
  kerusakan        LaporanKerusakanBarang[]

  @@index([perusahaanId])
}

model KelompokBarang {
  id      String           @id @default(cuid())
  nama    String
  indukId String?
  induk   KelompokBarang?  @relation("PohonKelompok", fields: [indukId], references: [id])
  anak    KelompokBarang[] @relation("PohonKelompok")
  barang  Barang[]

  @@index([indukId])
}

model Barang {
  id           String          @id @default(cuid())
  kode         String          @unique
  nama         String
  jenis        JenisBarang     @default(BARANG)
  kelompokId   String?
  kelompok     KelompokBarang? @relation(fields: [kelompokId], references: [id])
  satuan       String          @default("pcs")
  warna        String?
  hargaBeli    Decimal         @default(0) @db.Decimal(18, 2)
  hargaJual    Decimal         @default(0) @db.Decimal(18, 2)
  /// Batas bawah harga saat nego dengan klien (0 = tanpa batas)
  hargaMinimum Decimal         @default(0) @db.Decimal(18, 2)
  stokMinimum  Decimal         @default(0) @db.Decimal(18, 2)
  /// deskripsi katalog; hanya isian awal deskripsi baris dokumen penjualan (≤ 3000)
  deskripsi    String?

  /// Pemilik barang. BARANG (stok) WAJIB terisi (CHECK DB Barang_barang_wajib_milik_perusahaan) sehingga harga pokok
  /// rata-rata satu barang hanya memuat stok satu perusahaan dan src/lib/stok.ts tidak berubah (K3).
  /// JASA boleh null = jasa bersama. Bawaan "utama" supaya create lama tanpa isian tetap sah.
  perusahaanId String?     @default("utama")
  perusahaan   Perusahaan? @relation(fields: [perusahaanId], references: [id], onDelete: Restrict)

  stok                  StokBarang[]
  barisPenawaran        BarisPenawaranPenjualan[]
  barisPesananPenjualan BarisPesananPenjualan[]
  barisPengiriman       BarisPengiriman[]
  barisFakturPenjualan  BarisFakturPenjualan[]
  barisReturPenjualan   BarisReturPenjualan[]
  barisPesananPembelian BarisPesananPembelian[]
  barisPenerimaanBarang BarisPenerimaanBarang[]
  barisFakturPembelian  BarisFakturPembelian[]
  barisReturPembelian   BarisReturPembelian[]
  dibuatPada            DateTime                  @default(now())

  /// Akun khusus per barang (opsional; kosong = pakai PemetaanAkun)
  akunPendapatanId String?
  akunPendapatan   Akun?                        @relation("AkunPendapatanBarang", fields: [akunPendapatanId], references: [id])
  akunHppId        String?
  akunHpp          Akun?                        @relation("AkunHppBarang", fields: [akunHppId], references: [id])
  akunPersediaanId String?
  akunPersediaan   Akun?                        @relation("AkunPersediaanBarang", fields: [akunPersediaanId], references: [id])
  /// Untuk JASA yang dibeli: beban yang didebit saat Faktur Pembelian
  akunBebanId      String?
  akunBeban        Akun?                        @relation("AkunBebanBarang", fields: [akunBebanId], references: [id])
  barisPenyesuaian BarisPenyesuaianPersediaan[]
  barisPindah      BarisPindahBarang[]
  barisPeminjaman  BarisPeminjamanBarang[]
  barisKerusakan   BarisKerusakanBarang[]
  foto             Foto[]

  @@index([kelompokId])
  @@index([akunPendapatanId])
  @@index([akunHppId])
  @@index([akunPersediaanId])
  @@index([akunBebanId])
  @@index([perusahaanId])
}

model StokBarang {
  barangId String
  barang   Barang  @relation(fields: [barangId], references: [id])
  gudangId String
  gudang   Gudang  @relation(fields: [gudangId], references: [id])
  jumlah   Decimal @default(0) @db.Decimal(18, 2)

  @@id([barangId, gudangId])
  @@index([barangId])
  @@index([gudangId])
}

// ---------- Siklus Penjualan ----------

model PenawaranPenjualan {
  id          String        @id @default(cuid())
  nomor       String        @unique
  tanggal     DateTime      @default(now())
  pelangganId String
  pelanggan   Pelanggan     @relation(fields: [pelangganId], references: [id])
  status      StatusDokumen @default(DRAF)
  proyekId    String?
  proyek      Proyek?       @relation(fields: [proyekId], references: [id])
  total       Decimal       @default(0) @db.Decimal(18, 2)

  /// Pemilik pembukuan (lihat model Perusahaan). Dokumen anak mewarisi induknya; jurnal mewarisi dokumennya.
  perusahaanId String     @default("utama")
  perusahaan   Perusahaan @relation(fields: [perusahaanId], references: [id])

  baris             BarisPenawaranPenjualan[]
  pesanan           PesananPenjualan?
  /// Persetujuan (maker-checker); lihat src/lib/persetujuan.ts
  statusPersetujuan StatusPersetujuan         @default(DRAFT)
  diajukanOlehId    String?
  diajukanOleh      Pengguna?                 @relation("AjukanPenawaranPenjualan", fields: [diajukanOlehId], references: [id])
  diajukanPada      DateTime?
  disetujuiOlehId   String?
  disetujuiOleh     Pengguna?                 @relation("SetujuiPenawaranPenjualan", fields: [disetujuiOlehId], references: [id])
  disetujuiPada     DateTime?
  ditolakOlehId     String?
  ditolakOleh       Pengguna?                 @relation("TolakPenawaranPenjualan", fields: [ditolakOlehId], references: [id])
  ditolakPada       DateTime?
  catatanPenolakan  String?

  // --- D2: mode event, diskon, fee, PPN tampilan ---
  mode                ModeDokumen     @default(STANDAR)
  tampilanEvent       TampilanEvent   @default(RINCI)
  namaEvent           String?
  venue               String?
  /// teks tampilan bebas, mis. "27-30 Agustus 2026"; kosong = rentang tanggal proyek saat dicetak
  tanggalEvent        String?
  jenisDiskon         JenisNilai      @default(NOMINAL)
  /// isian pengguna: rupiah (NOMINAL) atau persen (PERSEN)
  nilaiDiskon         Decimal         @default(0) @db.Decimal(18, 2)
  /// hasil hitung (rupiah)
  diskon              Decimal         @default(0) @db.Decimal(18, 2)
  jenisFee            JenisNilai      @default(PERSEN)
  nilaiFee            Decimal         @default(0) @db.Decimal(18, 2)
  /// management fee hasil hitung (rupiah); total = Σ nilai baris − diskon + fee (tanpa PPN, sama seperti sebelumnya)
  fee                 Decimal         @default(0) @db.Decimal(18, 2)
  /// tarif PPN untuk tampilan dan nilai termin termasuk PPN (0 bila non-PKP); tidak masuk total
  ppnPersen           Decimal         @default(0) @db.Decimal(5, 2)
  /// ADD ON proposal D'Pro: informatif, TIDAK masuk total, termin, DP, maupun jurnal
  nilaiAddOn          Decimal?        @db.Decimal(18, 2)
  keteranganAddOn     String?
  // --- D2: teks surat & cetak (tidak pernah dibaca jurnal) ---
  judulCetak          String?
  nomorCetak          String?
  perihal             String?
  lampiran            String?
  referensi           String?
  teksPembuka         String?
  teksPenutup         String?
  catatan             String?
  catatanKanan        String?
  syaratPembayaran    String?
  infoBank            String?
  /// nama/kontak/alamat tujuan di cetakan; kosong = data induk pelanggan saat dicetak
  kepada              String?
  kepadaUp            String?
  kepadaAlamat        String?
  kepadaTelepon       String?
  kepadaEmail         String?
  kopSuratId          String?
  kopSurat            KopSurat?       @relation(fields: [kopSuratId], references: [id], onDelete: SetNull)
  /// Lead CRM asal penawaran (opsional). Lead hanya diarsipkan, jadi SetNull hanya terjadi saat reset/uji.
  leadId              String?
  lead                Lead?           @relation(fields: [leadId], references: [id], onDelete: SetNull)
  statusKomersial     StatusKomersial @default(DRAF)
  statusKomersialPada DateTime?
  berlakuSampai       DateTime?
  rencanaTermin       RencanaTermin[]

  // ---- keuangan proyek (D5) ----
  barisAnggaranProyek BarisAnggaranProyek[] @relation("SumberPenawaranAnggaran")

  @@unique([perusahaanId, nomorCetak])
  @@index([pelangganId])
  @@index([proyekId])
  @@index([status])
  @@index([tanggal])
  @@index([statusPersetujuan])
  @@index([perusahaanId])
  @@index([kopSuratId])
  @@index([leadId])
  @@index([statusKomersial])
}

model BarisPenawaranPenjualan {
  id          String             @id @default(cuid())
  penawaranId String
  penawaran   PenawaranPenjualan @relation(fields: [penawaranId], references: [id])
  barangId    String
  barang      Barang             @relation(fields: [barangId], references: [id])
  jumlah      Decimal            @db.Decimal(18, 2)
  harga       Decimal            @db.Decimal(18, 2)
  subtotal    Decimal            @db.Decimal(18, 2)

  /// frekuensi mode event (malam/hari/kali). Hanya mengalikan nilai uang; TIDAK PERNAH kuantitas stok, SJ, atau HPP
  frekuensi       Decimal @default(1) @db.Decimal(18, 2)
  satuanFrekuensi String?
  /// seksi baris (mode event); baris berurutan dengan seksi sama dicetak di bawah satu judul
  bagian          String?
  urutan          Int     @default(0)
  /// nama tampil; kosong = Barang.nama. Baris bebas memakai Barang sistem JASA-LAIN dengan nama di sini
  nama            String?
  /// satu poin per baris: "- " butir, "-- " sub-butir, **tebal** (src/lib/teksBerbutir.ts)
  deskripsi       String?
  /// satuan tampil; kosong = Barang.satuan
  satuan          String?
  /// kolom "Keterangan" proposal D'Pro
  keterangan      String?

  @@index([penawaranId])
  @@index([barangId])
}

model PesananPenjualan {
  id          String              @id @default(cuid())
  nomor       String              @unique
  tanggal     DateTime            @default(now())
  pelangganId String
  pelanggan   Pelanggan           @relation(fields: [pelangganId], references: [id])
  penawaranId String?             @unique
  penawaran   PenawaranPenjualan? @relation(fields: [penawaranId], references: [id])
  status      StatusDokumen       @default(DRAF)
  proyekId    String?
  proyek      Proyek?             @relation(fields: [proyekId], references: [id])
  total       Decimal             @default(0) @db.Decimal(18, 2)

  /// Pemilik pembukuan (lihat model Perusahaan). Dokumen anak mewarisi induknya; jurnal mewarisi dokumennya.
  perusahaanId String     @default("utama")
  perusahaan   Perusahaan @relation(fields: [perusahaanId], references: [id])

  baris             BarisPesananPenjualan[]
  pengiriman        PengirimanPesanan[]
  faktur            FakturPenjualan[]
  uangMuka          UangMukaPelanggan[]
  /// Persetujuan (maker-checker); lihat src/lib/persetujuan.ts
  statusPersetujuan StatusPersetujuan       @default(DRAFT)
  diajukanOlehId    String?
  diajukanOleh      Pengguna?               @relation("AjukanPesananPenjualan", fields: [diajukanOlehId], references: [id])
  diajukanPada      DateTime?
  disetujuiOlehId   String?
  disetujuiOleh     Pengguna?               @relation("SetujuiPesananPenjualan", fields: [disetujuiOlehId], references: [id])
  disetujuiPada     DateTime?
  ditolakOlehId     String?
  ditolakOleh       Pengguna?               @relation("TolakPesananPenjualan", fields: [ditolakOlehId], references: [id])
  ditolakPada       DateTime?
  catatanPenolakan  String?

  // --- D2: mode event, diskon, fee, teks surat ---
  mode             ModeDokumen     @default(STANDAR)
  tampilanEvent    TampilanEvent   @default(RINCI)
  namaEvent        String?
  venue            String?
  tanggalEvent     String?
  jenisDiskon      JenisNilai      @default(NOMINAL)
  nilaiDiskon      Decimal         @default(0) @db.Decimal(18, 2)
  diskon           Decimal         @default(0) @db.Decimal(18, 2)
  jenisFee         JenisNilai      @default(PERSEN)
  nilaiFee         Decimal         @default(0) @db.Decimal(18, 2)
  fee              Decimal         @default(0) @db.Decimal(18, 2)
  ppnPersen        Decimal         @default(0) @db.Decimal(5, 2)
  perihal          String?
  lampiran         String?
  referensi        String?
  teksPembuka      String?
  teksPenutup      String?
  catatan          String?
  catatanKanan     String?
  syaratPembayaran String?
  infoBank         String?
  /// nama/kontak/alamat tujuan di cetakan; kosong = data induk pelanggan saat dicetak
  kepada           String?
  kepadaUp         String?
  kepadaAlamat     String?
  kepadaTelepon    String?
  kepadaEmail      String?
  kopSuratId       String?
  kopSurat         KopSurat?       @relation(fields: [kopSuratId], references: [id], onDelete: SetNull)
  /// Lead CRM asal (disalin dari penawaran saat konversi)
  leadId           String?
  lead             Lead?           @relation(fields: [leadId], references: [id], onDelete: SetNull)
  rencanaTermin    RencanaTermin[]

  // ---- keuangan proyek (D5) ----
  barisAnggaranProyek BarisAnggaranProyek[] @relation("SumberPesananAnggaran")

  @@index([pelangganId])
  @@index([proyekId])
  @@index([status])
  @@index([tanggal])
  @@index([statusPersetujuan])
  @@index([perusahaanId])
  @@index([kopSuratId])
  @@index([leadId])
}

model BarisPesananPenjualan {
  id             String           @id @default(cuid())
  pesananId      String
  pesanan        PesananPenjualan @relation(fields: [pesananId], references: [id])
  barangId       String
  barang         Barang           @relation(fields: [barangId], references: [id])
  jumlah         Decimal          @db.Decimal(18, 2)
  harga          Decimal          @db.Decimal(18, 2)
  jumlahTerkirim Decimal          @default(0) @db.Decimal(18, 2)
  jumlahDifaktur Decimal          @default(0) @db.Decimal(18, 2)

  /// frekuensi mode event (malam/hari/kali). Hanya mengalikan nilai uang; TIDAK PERNAH kuantitas stok, SJ, atau HPP
  frekuensi       Decimal @default(1) @db.Decimal(18, 2)
  satuanFrekuensi String?
  /// seksi baris (mode event); baris berurutan dengan seksi sama dicetak di bawah satu judul
  bagian          String?
  urutan          Int     @default(0)
  /// nama tampil; kosong = Barang.nama. Baris bebas memakai Barang sistem JASA-LAIN dengan nama di sini
  nama            String?
  /// satu poin per baris: "- " butir, "-- " sub-butir, **tebal** (src/lib/teksBerbutir.ts)
  deskripsi       String?
  /// satuan tampil; kosong = Barang.satuan
  satuan          String?
  /// kolom "Keterangan" proposal D'Pro
  keterangan      String?

  barisPengiriman BarisPengiriman[]
  barisFaktur     BarisFakturPenjualan[]

  @@index([pesananId])
  @@index([barangId])
