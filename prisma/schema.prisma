// Accurate Copy — skema data (seluruh penamaan dalam bahasa Indonesia)
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/prisma-klien"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enum ----------

enum StatusDokumen {
  DRAF
  DIKONVERSI
  DIPROSES
  LUNAS
  SEBAGIAN
  DIBATALKAN
}

enum JenisBarang {
  BARANG
  JASA
}

enum PeranPengguna {
  PEMILIK
  ADMIN
  KASIR
  GUDANG
}

enum JenisAkun {
  ASET
  KEWAJIBAN
  MODAL
  PENDAPATAN
  BEBAN
}

enum SumberJurnal {
  MANUAL
  KAS_MASUK
  KAS_KELUAR
  PENJUALAN
  PEMBELIAN
  PENYUSUTAN
}

enum StatusAset {
  AKTIF
  DIJUAL
  DIHAPUS
}

// ---------- Pengguna ----------

model Pengguna {
  id            String        @id @default(cuid())
  email         String        @unique
  nama          String
  kataSandiHash String
  peran         PeranPengguna @default(KASIR)
  aktif         Boolean       @default(true)
  karyawan      Karyawan?
  sesi          Sesi[]
  dibuatPada    DateTime      @default(now())
}

/// Sesi login berbasis basis data: cookie hanya menyimpan token acak, yang disimpan di sini dalam bentuk hash.
model Sesi {
  id          String   @id @default(cuid())
  tokenHash   String   @unique
  penggunaId  String
  pengguna    Pengguna @relation(fields: [penggunaId], references: [id], onDelete: Cascade)
  kedaluwarsa DateTime
  dibuatPada  DateTime @default(now())

  @@index([penggunaId])
}

// ---------- Data induk ----------

model Departemen {
  id       String     @id @default(cuid())
  nama     String
  karyawan Karyawan[]
}

model Karyawan {
  id           String      @id @default(cuid())
  kode         String      @unique
  nama         String
  departemenId String?
  departemen   Departemen? @relation(fields: [departemenId], references: [id])
  penggunaId   String?     @unique
  pengguna     Pengguna?   @relation(fields: [penggunaId], references: [id])
  pelanggan    Pelanggan[]
  dibuatPada   DateTime    @default(now())
}

model Pelanggan {
  id        String    @id @default(cuid())
  kode      String    @unique
  nama      String
  alamat    String?
  telepon   String?
  npwp      String?
  penjualId String?
  penjual   Karyawan? @relation(fields: [penjualId], references: [id])

  penawaran  PenawaranPenjualan[]
  pesanan    PesananPenjualan[]
  faktur     FakturPenjualan[]
  penerimaan PenerimaanPenjualan[]
  proyek     Proyek[]
  dibuatPada DateTime @default(now())
}

model Pemasok {
  id         String   @id @default(cuid())
  kode       String   @unique
  nama       String
  alamat     String?
  telepon    String?
  dibuatPada DateTime @default(now())

  pesanan    PesananPembelian[]
  faktur     FakturPembelian[]
  pembayaran PembayaranPembelian[]
}

model Proyek {
  id          String     @id @default(cuid())
  kode        String     @unique
  nama        String
  pelangganId String?
  pelanggan   Pelanggan? @relation(fields: [pelangganId], references: [id])
  status      String     @default("BERJALAN")
}

model Gudang {
  id     String  @id @default(cuid())
  kode   String  @unique
  nama   String
  alamat String?

  stok             StokBarang[]
  pengiriman       PengirimanPesanan[]
  returPenjualan   ReturPenjualan[]
  penerimaanBarang PenerimaanBarang[]
  returPembelian   ReturPembelian[]
}

model KelompokBarang {
  id      String           @id @default(cuid())
  nama    String
  indukId String?
  induk   KelompokBarang?  @relation("PohonKelompok", fields: [indukId], references: [id])
  anak    KelompokBarang[] @relation("PohonKelompok")
  barang  Barang[]
}

model Barang {
  id          String          @id @default(cuid())
  kode        String          @unique
  nama        String
  jenis       JenisBarang     @default(BARANG)
  kelompokId  String?
  kelompok    KelompokBarang? @relation(fields: [kelompokId], references: [id])
  satuan      String          @default("pcs")
  hargaBeli   Decimal         @default(0) @db.Decimal(18, 2)
  hargaJual   Decimal         @default(0) @db.Decimal(18, 2)
  stokMinimum Decimal         @default(0) @db.Decimal(18, 2)

  stok                    StokBarang[]
  barisPenawaran          BarisPenawaranPenjualan[]
  barisPesananPenjualan   BarisPesananPenjualan[]
  barisPengiriman         BarisPengiriman[]
  barisFakturPenjualan    BarisFakturPenjualan[]
  barisReturPenjualan     BarisReturPenjualan[]
  barisPesananPembelian   BarisPesananPembelian[]
  barisPenerimaanBarang   BarisPenerimaanBarang[]
  barisFakturPembelian    BarisFakturPembelian[]
  barisReturPembelian     BarisReturPembelian[]
  dibuatPada              DateTime @default(now())
}

model StokBarang {
  barangId String
  barang   Barang  @relation(fields: [barangId], references: [id])
  gudangId String
  gudang   Gudang  @relation(fields: [gudangId], references: [id])
  jumlah   Decimal @default(0) @db.Decimal(18, 2)

  @@id([barangId, gudangId])
}

// ---------- Siklus Penjualan ----------

model PenawaranPenjualan {
  id          String        @id @default(cuid())
  nomor       String        @unique
  tanggal     DateTime      @default(now())
  pelangganId String
  pelanggan   Pelanggan     @relation(fields: [pelangganId], references: [id])
  status      StatusDokumen @default(DRAF)
  total       Decimal       @default(0) @db.Decimal(18, 2)

  baris   BarisPenawaranPenjualan[]
  pesanan PesananPenjualan?
}

model BarisPenawaranPenjualan {
  id          String             @id @default(cuid())
  penawaranId String
  penawaran   PenawaranPenjualan @relation(fields: [penawaranId], references: [id])
  barangId    String
  barang      Barang             @relation(fields: [barangId], references: [id])
  jumlah      Decimal            @db.Decimal(18, 2)
  harga       Decimal            @db.Decimal(18, 2)
  subtotal    Decimal            @db.Decimal(18, 2)
}

model PesananPenjualan {
  id          String              @id @default(cuid())
  nomor       String              @unique
  tanggal     DateTime            @default(now())
  pelangganId String
  pelanggan   Pelanggan           @relation(fields: [pelangganId], references: [id])
  penawaranId String?             @unique
  penawaran   PenawaranPenjualan? @relation(fields: [penawaranId], references: [id])
  status      StatusDokumen       @default(DRAF)
  total       Decimal             @default(0) @db.Decimal(18, 2)

  baris      BarisPesananPenjualan[]
  pengiriman PengirimanPesanan[]
  faktur     FakturPenjualan[]
}

model BarisPesananPenjualan {
  id             String           @id @default(cuid())
  pesananId      String
  pesanan        PesananPenjualan @relation(fields: [pesananId], references: [id])
  barangId       String
  barang         Barang           @relation(fields: [barangId], references: [id])
  jumlah         Decimal          @db.Decimal(18, 2)
  harga          Decimal          @db.Decimal(18, 2)
  jumlahTerkirim Decimal          @default(0) @db.Decimal(18, 2)
  jumlahDifaktur Decimal          @default(0) @db.Decimal(18, 2)

  barisPengiriman BarisPengiriman[]
}

model PengirimanPesanan {
  id        String           @id @default(cuid())
  nomor     String           @unique
  tanggal   DateTime         @default(now())
  pesananId String
  pesanan   PesananPenjualan @relation(fields: [pesananId], references: [id])
  gudangId  String
  gudang    Gudang           @relation(fields: [gudangId], references: [id])
  status    StatusDokumen    @default(DRAF)

  baris  BarisPengiriman[]
  faktur FakturPenjualan[]
}

model BarisPengiriman {
  id             String                @id @default(cuid())
  pengirimanId   String
  pengiriman     PengirimanPesanan     @relation(fields: [pengirimanId], references: [id])
  barisPesananId String
  barisPesanan   BarisPesananPenjualan @relation(fields: [barisPesananId], references: [id])
  barangId       String
  barang         Barang                @relation(fields: [barangId], references: [id])
  jumlah         Decimal               @db.Decimal(18, 2)
}

model FakturPenjualan {
  id           String             @id @default(cuid())
  nomor        String             @unique
  tanggal      DateTime           @default(now())
  jatuhTempo   DateTime?
  pelangganId  String
  pelanggan    Pelanggan          @relation(fields: [pelangganId], references: [id])
  pesananId    String?
  pesanan      PesananPenjualan?  @relation(fields: [pesananId], references: [id])
  pengirimanId String?
  pengiriman   PengirimanPesanan? @relation(fields: [pengirimanId], references: [id])
  status       StatusDokumen      @default(DRAF)
  total        Decimal            @default(0) @db.Decimal(18, 2)

  baris      BarisFakturPenjualan[]
  penerimaan PenerimaanPenjualan[]
  retur      ReturPenjualan[]
}

model BarisFakturPenjualan {
  id       String          @id @default(cuid())
  fakturId String
  faktur   FakturPenjualan @relation(fields: [fakturId], references: [id])
  barangId String
  barang   Barang          @relation(fields: [barangId], references: [id])
  jumlah   Decimal         @db.Decimal(18, 2)
  harga    Decimal         @db.Decimal(18, 2)
  subtotal Decimal         @db.Decimal(18, 2)
}

model PenerimaanPenjualan {
  id          String          @id @default(cuid())
  nomor       String          @unique
  tanggal     DateTime        @default(now())
  pelangganId String
  pelanggan   Pelanggan       @relation(fields: [pelangganId], references: [id])
  fakturId    String
  faktur      FakturPenjualan @relation(fields: [fakturId], references: [id])
  akunId      String
  akun        Akun            @relation("AkunPenerimaanPenjualan", fields: [akunId], references: [id])
  jumlah      Decimal         @db.Decimal(18, 2)
  metodeBayar String          @default("TUNAI")
}

model ReturPenjualan {
  id       String          @id @default(cuid())
  nomor    String          @unique
  tanggal  DateTime        @default(now())
  fakturId String
  faktur   FakturPenjualan @relation(fields: [fakturId], references: [id])
  gudangId String
  gudang   Gudang          @relation(fields: [gudangId], references: [id])
  alasan   String?

  baris BarisReturPenjualan[]
}

model BarisReturPenjualan {
  id       String         @id @default(cuid())
  returId  String
  retur    ReturPenjualan @relation(fields: [returId], references: [id])
  barangId String
  barang   Barang         @relation(fields: [barangId], references: [id])
  jumlah   Decimal        @db.Decimal(18, 2)
}

// ---------- Siklus Pembelian ----------

model PesananPembelian {
  id        String        @id @default(cuid())
  nomor     String        @unique
  tanggal   DateTime      @default(now())
  pemasokId String
  pemasok   Pemasok       @relation(fields: [pemasokId], references: [id])
  status    StatusDokumen @default(DRAF)
  total     Decimal       @default(0) @db.Decimal(18, 2)

  baris            BarisPesananPembelian[]
  penerimaanBarang PenerimaanBarang[]
  faktur           FakturPembelian[]
}

model BarisPesananPembelian {
  id             String           @id @default(cuid())
  pesananId      String
  pesanan        PesananPembelian @relation(fields: [pesananId], references: [id])
  barangId       String
  barang         Barang           @relation(fields: [barangId], references: [id])
  jumlah         Decimal          @db.Decimal(18, 2)
  harga          Decimal          @db.Decimal(18, 2)
  jumlahDiterima Decimal          @default(0) @db.Decimal(18, 2)
  jumlahDifaktur Decimal          @default(0) @db.Decimal(18, 2)

  barisPenerimaan BarisPenerimaanBarang[]
}

model PenerimaanBarang {
  id        String           @id @default(cuid())
  nomor     String           @unique
  tanggal   DateTime         @default(now())
  pesananId String
  pesanan   PesananPembelian @relation(fields: [pesananId], references: [id])
  gudangId  String
  gudang    Gudang           @relation(fields: [gudangId], references: [id])
  status    StatusDokumen    @default(DRAF)

  baris  BarisPenerimaanBarang[]
  faktur FakturPembelian[]
}

model BarisPenerimaanBarang {
  id             String                @id @default(cuid())
  penerimaanId   String
  penerimaan     PenerimaanBarang      @relation(fields: [penerimaanId], references: [id])
  barisPesananId String
  barisPesanan   BarisPesananPembelian @relation(fields: [barisPesananId], references: [id])
  barangId       String
  barang         Barang                @relation(fields: [barangId], references: [id])
  jumlah         Decimal               @db.Decimal(18, 2)
}

model FakturPembelian {
  id           String            @id @default(cuid())
  nomor        String            @unique
  tanggal      DateTime          @default(now())
  jatuhTempo   DateTime?
  pemasokId    String
  pemasok      Pemasok           @relation(fields: [pemasokId], references: [id])
  pesananId    String?
  pesanan      PesananPembelian? @relation(fields: [pesananId], references: [id])
  penerimaanId String?
  penerimaan   PenerimaanBarang? @relation(fields: [penerimaanId], references: [id])
  status       StatusDokumen     @default(DRAF)
  total        Decimal           @default(0) @db.Decimal(18, 2)

  baris      BarisFakturPembelian[]
  pembayaran PembayaranPembelian[]
  retur      ReturPembelian[]
}

model BarisFakturPembelian {
  id       String          @id @default(cuid())
  fakturId String
  faktur   FakturPembelian @relation(fields: [fakturId], references: [id])
  barangId String
  barang   Barang          @relation(fields: [barangId], references: [id])
  jumlah   Decimal         @db.Decimal(18, 2)
  harga    Decimal         @db.Decimal(18, 2)
  subtotal Decimal         @db.Decimal(18, 2)
}

model PembayaranPembelian {
  id          String          @id @default(cuid())
  nomor       String          @unique
  tanggal     DateTime        @default(now())
  pemasokId   String
  pemasok     Pemasok         @relation(fields: [pemasokId], references: [id])
  fakturId    String
  faktur      FakturPembelian @relation(fields: [fakturId], references: [id])
  akunId      String
  akun        Akun            @relation("AkunPembayaranPembelian", fields: [akunId], references: [id])
  jumlah      Decimal         @db.Decimal(18, 2)
  metodeBayar String          @default("TRANSFER")
}

model ReturPembelian {
  id       String          @id @default(cuid())
  nomor    String          @unique
  tanggal  DateTime        @default(now())
  fakturId String
  faktur   FakturPembelian @relation(fields: [fakturId], references: [id])
  gudangId String
  gudang   Gudang          @relation(fields: [gudangId], references: [id])
  alasan   String?

  baris BarisReturPembelian[]
}

model BarisReturPembelian {
  id       String         @id @default(cuid())
  returId  String
  retur    ReturPembelian @relation(fields: [returId], references: [id])
  barangId String
  barang   Barang         @relation(fields: [barangId], references: [id])
  jumlah   Decimal        @db.Decimal(18, 2)
}

// ---------- Buku Besar & Kas/Bank ----------

model Akun {
  id      String    @id @default(cuid())
  kode    String    @unique
  nama    String
  jenis   JenisAkun
  /// Akun kelompok/induk: hanya wadah untuk anak-anaknya, tidak boleh menerima jurnal
  kelompok   Boolean @default(false)
  /// Tampil sebagai pilihan akun Kas/Bank (penerimaan, pembayaran, kas masuk/keluar)
  kasBank    Boolean @default(false)
  keterangan String?
  indukId String?
  induk   Akun?     @relation("PohonAkun", fields: [indukId], references: [id])
  anak    Akun[]    @relation("PohonAkun")

  barisJurnal         BarisJurnal[]
  penerimaanPenjualan PenerimaanPenjualan[] @relation("AkunPenerimaanPenjualan")
  pembayaranPembelian PembayaranPembelian[] @relation("AkunPembayaranPembelian")

  pemetaanPiutang    PemetaanAkun? @relation("PetaPiutang")
  pemetaanPersediaan PemetaanAkun? @relation("PetaPersediaan")
  pemetaanHpp        PemetaanAkun? @relation("PetaHpp")
  pemetaanPendapatan PemetaanAkun? @relation("PetaPendapatan")
  pemetaanUtang      PemetaanAkun? @relation("PetaUtang")

  asetSebagaiAkunAset       AsetTetap[] @relation("AkunAsetTetap")
  asetSebagaiAkunBeban      AsetTetap[] @relation("AkunBebanPenyusutan")
  asetSebagaiAkunAkumulasi  AsetTetap[] @relation("AkunAkumulasiPenyusutan")
}

model PemetaanAkun {
  id String @id @default("default")

  piutangUsahaId String @unique
  piutangUsaha   Akun   @relation("PetaPiutang", fields: [piutangUsahaId], references: [id])

  persediaanId String @unique
  persediaan   Akun   @relation("PetaPersediaan", fields: [persediaanId], references: [id])

  hppId String @unique
  hpp   Akun   @relation("PetaHpp", fields: [hppId], references: [id])

  pendapatanPenjualanId String @unique
  pendapatanPenjualan   Akun   @relation("PetaPendapatan", fields: [pendapatanPenjualanId], references: [id])

  utangUsahaId String @unique
  utangUsaha   Akun   @relation("PetaUtang", fields: [utangUsahaId], references: [id])
}

model Jurnal {
  id         String       @id @default(cuid())
  nomor      String       @unique
  tanggal    DateTime     @default(now())
  keterangan String?
  sumber     SumberJurnal @default(MANUAL)

  baris          BarisJurnal[]
  penyusutanAset PenyusutanAset[]
}

model BarisJurnal {
  id         String  @id @default(cuid())
  jurnalId   String
  jurnal     Jurnal  @relation(fields: [jurnalId], references: [id])
  akunId     String
  akun       Akun    @relation(fields: [akunId], references: [id])
  debit      Decimal @default(0) @db.Decimal(18, 2)
  kredit     Decimal @default(0) @db.Decimal(18, 2)
  keterangan String?
}

// ---------- Aset Tetap ----------

model AsetTetap {
  id               String     @id @default(cuid())
  kode             String     @unique
  nama             String
  tanggalPerolehan DateTime   @default(now())
  hargaPerolehan   Decimal    @db.Decimal(18, 2)
  nilaiSisa        Decimal    @default(0) @db.Decimal(18, 2)
  umurBulan        Int
  status           StatusAset @default(AKTIF)

  akunAsetId                String
  akunAset                  Akun   @relation("AkunAsetTetap", fields: [akunAsetId], references: [id])
  akunBebanPenyusutanId     String
  akunBebanPenyusutan       Akun   @relation("AkunBebanPenyusutan", fields: [akunBebanPenyusutanId], references: [id])
  akunAkumulasiPenyusutanId String
  akunAkumulasiPenyusutan   Akun   @relation("AkunAkumulasiPenyusutan", fields: [akunAkumulasiPenyusutanId], references: [id])

  penyusutan PenyusutanAset[]
}

model PenyusutanAset {
  id       String    @id @default(cuid())
  asetId   String
  aset     AsetTetap @relation(fields: [asetId], references: [id])
  periode  DateTime
  jumlah   Decimal   @db.Decimal(18, 2)
  jurnalId String?
  jurnal   Jurnal?   @relation(fields: [jurnalId], references: [id])

  @@unique([asetId, periode])
}
