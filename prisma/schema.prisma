/// Siklus SDM: satu proses gaji per periode (bulan), mencakup semua karyawan yang diikutkan.
/// Jurnal: Dr Beban Gaji Pokok (per akun) + Dr Beban Tunjangan (per akun) / Cr Hutang Potongan Gaji (bila ada potongan) / Cr Kas-Bank (gaji bersih).
model Penggajian {
  id             String   @id @default(cuid())
  nomor          String   @unique
  /// KUNCI unik periode (dipertahankan @unique demi kueri lama findUnique({ where: { periode } })):
  /// perusahaan utama = "YYYY-MM" (sama persis dengan `bulan`, perilaku lama); perusahaan lain = "YYYY-MM@<perusahaanId>".
  /// Dibentuk HANYA oleh kunciPeriodeGaji() di src/lib/sdm.ts. Kode baru membaca `bulan`, bukan kolom ini.
  periode        String   @unique
  /// Bulan gaji "YYYY-MM" untuk semua perusahaan: tampilan, pencarian, keterangan jurnal.
  /// Satu proses per bulan per perusahaan; koreksi = hapus lalu buat ulang
  bulan          String
  tanggal        DateTime @default(now())
  akunKasId      String
  akunKas        Akun     @relation("AkunKasPenggajian", fields: [akunKasId], references: [id])
  proyekId       String?
  proyek         Proyek?  @relation(fields: [proyekId], references: [id])
  totalGajiPokok Decimal  @default(0) @db.Decimal(18, 2)
  totalTunjangan Decimal  @default(0) @db.Decimal(18, 2)
  totalPotongan  Decimal  @default(0) @db.Decimal(18, 2)
  totalDibayar   Decimal  @default(0) @db.Decimal(18, 2)
  keterangan     String?
  jurnalId       String?  @unique
  jurnal         Jurnal?  @relation("JurnalPenggajian", fields: [jurnalId], references: [id])
  penggunaNama   String
  dibuatPada     DateTime @default(now())

  /// Pemilik pembukuan (lihat model Perusahaan). Dokumen anak mewarisi induknya; jurnal mewarisi dokumennya.
  perusahaanId String     @default("utama")
  perusahaan   Perusahaan @relation(fields: [perusahaanId], references: [id])

  baris             BarisPenggajian[]
  /// Persetujuan (maker-checker); lihat src/lib/persetujuan.ts
  statusPersetujuan StatusPersetujuan @default(DRAFT)
  diajukanOlehId    String?
  diajukanOleh      Pengguna?         @relation("AjukanPenggajian", fields: [diajukanOlehId], references: [id])
  diajukanPada      DateTime?
  disetujuiOlehId   String?
  disetujuiOleh     Pengguna?         @relation("SetujuiPenggajian", fields: [disetujuiOlehId], references: [id])
  disetujuiPada     DateTime?
  ditolakOlehId     String?
  ditolakOleh       Pengguna?         @relation("TolakPenggajian", fields: [ditolakOlehId], references: [id])
  ditolakPada       DateTime?
  catatanPenolakan  String?

  @@unique([perusahaanId, bulan])
  @@index([akunKasId])
  @@index([proyekId])
  @@index([tanggal])
  @@index([statusPersetujuan])
  @@index([perusahaanId])
}

/// Rincian gaji per karyawan dalam satu proses Penggajian; diterima = gajiPokok + tunjangan − potongan.
model BarisPenggajian {
  id                 String     @id @default(cuid())
  penggajianId       String
  penggajian         Penggajian @relation(fields: [penggajianId], references: [id])
  karyawanId         String
  karyawan           Karyawan   @relation(fields: [karyawanId], references: [id])
  gajiPokok          Decimal    @db.Decimal(18, 2)
  tunjangan          Decimal    @db.Decimal(18, 2)
  potongan           Decimal    @default(0) @db.Decimal(18, 2)
  keteranganPotongan String?
  diterima           Decimal    @db.Decimal(18, 2)

  @@index([penggajianId])
  @@index([karyawanId])
}

/// Pemetaan akun tambahan buatan pengguna (mis. "prive" → 3-4000) untuk peran yang belum ada di PemetaanAkun
model PemetaanAkunTambahan {
  id         String   @id @default(cuid())
  kunci      String   @unique
  label      String
  akunId     String
  akun       Akun     @relation("AkunPemetaanTambahan", fields: [akunId], references: [id])
  keterangan String?
  dibuatOleh String
  dibuatPada DateTime @default(now())

  @@index([akunId])
}

model LogAktivitas {
  id           String   @id @default(cuid())
  waktu        DateTime @default(now())
  penggunaId   String?
  penggunaNama String
  /// HAPUS, TUTUP_BUKU, dll.
  aksi         String
  /// jenis dokumen (FakturPenjualan, PenerimaanBarang, ...)
  jenis        String
  nomor        String
  keterangan   String?
  /// Modul asal (null = catatan lama/akuntansi umum). Nilai dan hak lihatnya: MODUL_LOG di src/lib/log.ts
  modul        String?
  /// id entitas yang disentuh (tanpa FK supaya log tidak pernah tersangkut penghapusan)
  entitasId    String?
  /// Rincian terstruktur. Untuk modul "berkas" kunci folder dan proyekId SELALU ditulis (boleh null)
  meta         Json?
  /// Perusahaan tempat kejadian (null = tingkat sistem). Tanpa FK, sama alasannya dengan penggunaId
  perusahaanId String?

  @@index([waktu])
  @@index([modul, waktu])
  @@index([aksi, waktu])
  @@index([penggunaId, waktu])
  @@index([perusahaanId, waktu])
  @@index([entitasId])
}

// ---------- Berkas (D7) ----------

/// Folder logis berkas (pengganti subfolder Drive HKA). Global untuk semua perusahaan.
/// Folder sistem dibuat migrasi dan tidak bisa dihapus/diganti kode; folder buatan boleh ditambah Superadmin/Pemilik.
/// terbatas = file_restrictions HKA: hanya peran di peranBoleh + pemegang berkas.akses-penuh yang bisa melihat isinya.
model FolderBerkas {
  kode       String          @id
  nama       String
  urutan     Int             @default(0)
  sistem     Boolean         @default(false)
  terbatas   Boolean         @default(false)
  peranBoleh PeranPengguna[] @default([])
  diubahPada DateTime        @updatedAt
  berkas     Berkas[]

  @@index([urutan])
}

/// Metadata berkas yang disimpan di server. Isi biner di IsiBerkas (tabel terpisah supaya daftar, cek hak,
/// dan jawaban 304 tidak pernah membaca biner). Lampiran polimorfik lewat jenisEntitas + entitasId
/// (daftar jenis dan haknya di JENIS_LAMPIRAN, src/lib/berkas.ts). null = unggahan umum dari halaman Berkas.
model Berkas {
  id               String             @id @default(cuid())
  perusahaanId     String             @default("utama")
  perusahaan       Perusahaan         @relation(fields: [perusahaanId], references: [id])
  folderKode       String             @default("LAINNYA")
  folder           FolderBerkas       @relation(fields: [folderKode], references: [kode])
  /// Nama tampil yang sudah dibersihkan (1-200 karakter, ekstensi dipertahankan). Tidak pernah dipakai sebagai path.
  namaBerkas       String
  /// Hasil deteksi magic bytes di server (src/lib/tipeBerkas.ts), bukan dari klien
  tipeMime         String
  /// Byte, 1 sampai 26.214.400 (25 MB)
  ukuran           Int
  /// SHA-256 heksadesimal: ETag, verifikasi, deteksi ganda (tidak unik)
  sha256           String
  jenisEntitas     String?
  entitasId        String?
  tag              TagBerkas?
  /// Diwarisi dari entitas bila lampiran; dipilih bebas untuk unggahan umum (harus satu perusahaan).
  /// Restrict: proyek yang masih punya berkas (termasuk di sampah) tidak bisa dihapus, supaya pembatasan
  /// berkas proyek tidak terbuka diam-diam.
  proyekId         String?
  proyek           Proyek?            @relation(fields: [proyekId], references: [id], onDelete: Restrict)
  diunggahOlehId   String?
  diunggahOleh     Pengguna?          @relation("UnggahBerkas", fields: [diunggahOlehId], references: [id], onDelete: SetNull)
  diunggahOlehNama String
  dibuatPada       DateTime           @default(now())
  diubahPada       DateTime           @updatedAt
  /// Buang (hapus lunak): tampil di Sampah, bisa dipulihkan
  dihapusPada      DateTime?
  dihapusOlehId    String?
  dihapusOleh      Pengguna?          @relation("BuangBerkas", fields: [dihapusOlehId], references: [id], onDelete: SetNull)
  dihapusOlehNama  String?
  /// Hapus permanen: isi dibuang, metadata tetap untuk riwayat (mis. riwayat revisi desain D6)
  isiDihapusPada   DateTime?
  isi              IsiBerkas?
  tautanBagi       TautanBagiBerkas[]

  // ---- relasi balik domain lain ----
  /// Aset gambar kop surat yang memakai berkas ini (D3)
  asetKopSurat AsetKopSurat?
  /// Iklan yang memakai berkas ini sebagai kreatif (D6)
  iklanKreatif Iklan[]       @relation("KreatifIklan")

  @@index([perusahaanId, folderKode, dihapusPada])
  @@index([jenisEntitas, entitasId])
  @@index([proyekId])
  @@index([diunggahOlehId])
  @@index([dihapusOlehId])
  @@index([dibuatPada])
}

/// Isi biner berkas. Kolom isi memakai STORAGE EXTERNAL (SQL manual di migrasi): media sudah terkompresi,
/// jadi kompresi pglz hanya membuang CPU, dan substring bytea tetap murah bila kelak dukungan Range ditambah.
model IsiBerkas {
  berkasId String @id
  berkas   Berkas @relation(fields: [berkasId], references: [id], onDelete: Cascade)
  isi      Bytes
}

/// Tautan bagi publik bertoken (pengganti tautan publik Drive). Token asli hanya ditampilkan sekali;
/// yang disimpan SHA-256-nya (pola Sesi.tokenHash). Satu berkas boleh punya beberapa tautan.
model TautanBagiBerkas {
  id              String    @id @default(cuid())
  berkasId        String
  berkas          Berkas    @relation(fields: [berkasId], references: [id], onDelete: Cascade)
  tokenHash       String    @unique
  kedaluwarsa     DateTime
  dibuatOlehId    String?
  dibuatOleh      Pengguna? @relation("BuatTautanBagi", fields: [dibuatOlehId], references: [id], onDelete: SetNull)
  dibuatOlehNama  String
  dibuatPada      DateTime  @default(now())
  dicabutPada     DateTime?
  dicabutOlehId   String?
  dicabutOleh     Pengguna? @relation("CabutTautanBagi", fields: [dicabutOlehId], references: [id], onDelete: SetNull)
  jumlahUnduh     Int       @default(0)
  terakhirDiunduh DateTime?

  @@index([berkasId])
  @@index([dibuatOlehId])
  @@index([dicabutOlehId])
}

/// Pembatasan berkas per proyek (file_access HKA). Baris ada = terbatas. Berkas proyek ini hanya terlihat oleh
/// peran di peranBoleh, pengguna di daftar pengguna, dan pemegang berkas.akses-penuh. Hapus baris = buka pembatasan.
model AksesBerkasProyek {
  proyekId     String                      @id
  proyek       Proyek                      @relation(fields: [proyekId], references: [id], onDelete: Cascade)
  peranBoleh   PeranPengguna[]             @default([])
  diubahOlehId String?
  diubahOleh   Pengguna?                   @relation("UbahAksesBerkasProyek", fields: [diubahOlehId], references: [id], onDelete: SetNull)
  diubahPada   DateTime                    @updatedAt
  pengguna     AksesBerkasProyekPengguna[]

  @@index([diubahOlehId])
}

model AksesBerkasProyekPengguna {
  proyekId   String
  akses      AksesBerkasProyek @relation(fields: [proyekId], references: [proyekId], onDelete: Cascade)
  penggunaId String
  pengguna   Pengguna          @relation("AksesBerkasProyekPengguna", fields: [penggunaId], references: [id], onDelete: Cascade)

  @@id([proyekId, penggunaId])
  @@index([penggunaId])
}

// ---------- Notifikasi (D7) ----------

/// Notifikasi dalam aplikasi milik satu pengguna (lintas perusahaan, seperti HKA). Teks disimpan jadi (bahasa Indonesia).
/// perusahaanId = perusahaan data yang dirujuk; dipakai untuk mengganti lingkup aktif saat diklik (null = tidak perlu).
/// kunci = pencegah ganda untuk pengingat otomatis (mis. "jatuh-tempo:faktur:<id>"); null untuk notifikasi biasa.
model Notifikasi {
  id           String          @id @default(cuid())
  penggunaId   String
  pengguna     Pengguna        @relation("NotifikasiPengguna", fields: [penggunaId], references: [id], onDelete: Cascade)
  perusahaanId String?
  perusahaan   Perusahaan?     @relation(fields: [perusahaanId], references: [id], onDelete: SetNull)
  jenis        JenisNotifikasi
  judul        String
  isi          String?
  /// Path internal Produksia (diawali "/", bukan "//"); dijaga CHECK di migrasi
  tautan       String?
  kunci        String?
  dibaca       Boolean         @default(false)
  dibacaPada   DateTime?
  dibuatPada   DateTime        @default(now())

  @@unique([penggunaId, kunci])
  @@index([penggunaId, dibaca, dibuatPada])
  @@index([perusahaanId])
  @@index([dibuatPada])
}

// ---------- Dokumen penjualan gaya HKA / D'Pro (D2) ----------

/// Mode dokumen penjualan. EVENT membuka frekuensi dan seksi per baris (kolom Qty × Freq).
enum ModeDokumen {
  STANDAR
  EVENT
}

/// Tampilan cetak dokumen mode event: RINCI = satu halaman rinci; RINGKAS = ringkasan + lampiran RAB (penawaran: RAB saja)
enum TampilanEvent {
  RINCI
  RINGKAS
}

/// Cara hitung diskon dokumen, management fee, dan butir rencana termin
enum JenisNilai {
  NOMINAL
  PERSEN
}

/// Status komersial penawaran, diisi tangan, tidak menyentuh jurnal. Terpisah dari StatusDokumen yang diturunkan dari progres.
enum StatusKomersial {
  DRAF
  TERKIRIM
  DITERIMA
  DITOLAK
  KEDALUWARSA
}

/// Kapan penghitung nomor cetak kembali ke 1
enum ResetNomor {
  TAHUNAN
  BULANAN
  TIDAK_PERNAH
}

/// Jadwal termin pembayaran penawaran/pesanan. TIDAK berjurnal: tagihan termin hanya cetakan;
/// uang yang masuk dicatat sebagai UangMukaPelanggan dengan rencanaTerminId; pendapatan tetap diakui di faktur (K9, PSAK 72).
/// Tepat satu dari penawaranId / pesananId terisi (CHECK di migration.sql). Disalin dari penawaran ke pesanan saat konversi.
model RencanaTermin {
  id           String              @id @default(cuid())
  /// selalu sama dengan perusahaan dokumen induknya; disimpan supaya nomorCetak unik per perusahaan
  perusahaanId String              @default("utama")
  perusahaan   Perusahaan          @relation(fields: [perusahaanId], references: [id])
  penawaranId  String?
  penawaran    PenawaranPenjualan? @relation(fields: [penawaranId], references: [id], onDelete: Cascade)
  pesananId    String?
  pesanan      PesananPenjualan?   @relation(fields: [pesananId], references: [id], onDelete: Cascade)
  /// 1..4, urut tampil; butir terakhir selalu "sisa"
  no           Int
  /// ≤ 40 karakter; kosong saat simpan = "Termin {no}"
  label        String
  mode         JenisNilai          @default(PERSEN)
  /// isian pengguna (persen atau rupiah sebelum PPN); diabaikan untuk butir terakhir
  nilai        Decimal             @default(0) @db.Decimal(18, 2)
  /// hasil penyelesaian: rupiah DPP termin (sebelum PPN), > 0
  jumlah       Decimal             @db.Decimal(18, 2)
  /// jumlah / basis × 100, dua desimal
  persen       Decimal             @db.Decimal(7, 2)
  jatuhTempo   DateTime?
  /// nomor tagihan termin (diisi saat diterbitkan, bila format nomor "tagihan-termin" aktif atau diisi manual)
  nomorCetak   String?
  /// kapan tagihan termin diterbitkan; null = belum ditagih
  ditagihPada  DateTime?
  dibuatPada   DateTime            @default(now())

  uangMuka UangMukaPelanggan[]

  @@unique([penawaranId, no])
  @@unique([pesananId, no])
  @@unique([perusahaanId, nomorCetak])
  @@index([pesananId])
}

/// Format nomor cetak per perusahaan per jenis dokumen, mis. "{SEQ3}/{KODE}-INV2/{ROMAN}/{YYYY}".
/// Tidak ada baris (atau aktif = false) = nomor cetak mati untuk jenis itu; cetakan memakai nomor internal.
model FormatNomor {
  id           String     @id @default(cuid())
  perusahaanId String     @default("utama")
  perusahaan   Perusahaan @relation(fields: [perusahaanId], references: [id])
  /// "penawaran" | "faktur" | "kwitansi" | "kwitansi-dp" | "tagihan-termin" (daftar JENIS_NOMOR_CETAK di src/lib/nomorCetak.ts)
  jenis        String
  /// 3-60 karakter, wajib memuat {SEQ}, {SEQ2}, atau {SEQ3}
  pola         String
  /// nilai {PREFIX}: ^[A-Z0-9]{0,8}$
  prefiks      String     @default("")
  /// nilai {KODE}: ^[A-Z0-9-]{0,12}$; kosong = Perusahaan.kode
  kode         String     @default("")
  /// lebar {SEQ}: 3-8
  digit        Int        @default(4)
  /// deret penghitung: jenis yang memakai kunci sama berbagi urutan (buku agenda surat). Bawaan = jenis
  kunciDeret   String
  reset        ResetNomor @default(TAHUNAN)
  aktif        Boolean    @default(true)
  dibuatPada   DateTime   @default(now())
  diubahPada   DateTime   @updatedAt

  @@unique([perusahaanId, jenis])
}

/// Penghitung atomik nomor cetak. Kunci gabungan (bukan cuid) karena dinaikkan lewat
/// INSERT ... ON CONFLICT DO UPDATE ... RETURNING di dalam transaksi dokumen (src/lib/nomorCetak.ts).
model PenghitungNomor {
  perusahaanId String     @default("utama")
  perusahaan   Perusahaan @relation(fields: [perusahaanId], references: [id])
  kunciDeret   String
  /// "2026" (TAHUNAN), "2026-09" (BULANAN), "-" (TIDAK_PERNAH), dihitung dari tanggal dokumen di ZONA_WAKTU
  periode      String
  /// nomor terakhir yang sudah dibagikan
  nilai        Int        @default(0)

  @@id([perusahaanId, kunciDeret, periode])
}

/// Bawaan dokumen penjualan per perusahaan (isian awal formulir). Tidak ada baris = konstanta bawaan di src/lib/dokumenPenjualan.ts
/// (daftar seksi HKA dan teks pembuka/penutup proposal D'Pro).
model PengaturanDokumenPenjualan {
  id                   String        @id @default(cuid())
  perusahaanId         String        @unique @default("utama")
  perusahaan           Perusahaan    @relation(fields: [perusahaanId], references: [id])
  /// isian awal syarat pembayaran (≤ 3000)
  syaratPembayaran     String?
  tampilanEvent        TampilanEvent @default(RINCI)
  /// pilihan seksi baris (≤ 60 butir, tiap ≤ 60 karakter, unik tanpa beda huruf besar)
  daftarSeksi          String[]      @default([])
  /// isian awal paragraf pembuka/penutup penawaran (≤ 3000)
  teksPembukaPenawaran String?
  teksPenutupPenawaran String?
  diubahPada           DateTime      @updatedAt
}

// ---------- Cetak & kop surat (D3) ----------

/// Jenis dokumen yang punya template cetak per kop. Laporan proyek tidak memakai template.
enum JenisDokumenCetak {
  PENAWARAN
  TAGIHAN_TERMIN
  FAKTUR
  KWITANSI
  KWITANSI_DP
}

/// Tata letak PDF. HKA_* = tata letak generik HKA (dokumen mode event otomatis memakai tampilan event HKA
/// bertema kop ini). DPRO_* = desain Figma D'Pro. KWITANSI_ENTITAS = kwitansi/invoice tulisan per gaya entitas
/// (butuh KopSurat.gayaEntitas). KWITANSI_POLOS = kwitansi teks tanpa gambar (pola SMARA).
enum TataLetakCetak {
  HKA_STANDAR
  HKA_BERMEREK
  HKA_SURAT
  HKA_MINIMAL
  DPRO_INVOICE
  DPRO_PROPOSAL
  KWITANSI_ENTITAS
  KWITANSI_POLOS
}

enum UkuranKertas {
  A4
  A5
  A5_LANDSCAPE
}

/// TITIK = "Rp 1.234.567" (gaya Indonesia, HKA, kwitansi D'Pro). KOMA = "1,234,567" (invoice & proposal Figma D'Pro).
enum GayaAngka {
  TITIK
  KOMA
}

/// Gaya entitas D'Pro: folder aset bawaan src/aset-cetak/<gaya huruf kecil> dan parameter kwitansi per entitas.
enum GayaEntitas {
  DPRO
  TAPUSSA
  BONANOVA
  SAHARA
  NAWASENA
}

/// Slot gambar kop. TANDA_TANGAN dan STEMPEL tidak pernah punya aset bawaan (hanya unggahan privat).
enum JenisAsetKop {
  KOP
  KAKI
  WATERMARK
  LOGO
  JUDUL_INVOICE
  JUDUL_KWITANSI
  LABEL_PEMBAYARAN
  LABEL_SALAM
  TANDA_TANGAN
  STEMPEL
}

/// Kop surat milik satu perusahaan: gaya, warna, tata letak, aset gambar, dan penimpa identitas cetak.
/// Kolom identitas kosong = kolom bernama sama di Perusahaan (D1). Hapus lunak: dokumen lama boleh tetap
/// menunjuknya, tetapi saat dicetak kop terhapus diganti kop bawaan perusahaan (src/lib/cetak/kop.ts).
model KopSurat {
  id            String         @id @default(cuid())
  perusahaanId  String         @default("utama")
  perusahaan    Perusahaan     @relation(fields: [perusahaanId], references: [id], onDelete: Restrict)
  /// 1-80 karakter; unik tanpa beda huruf besar di antara kop belum terhapus milik perusahaan yang sama (dicek aplikasi)
  nama          String
  /// Satu kop bawaan per perusahaan, dijaga aksi kop dalam satu transaksi (bukan indeks parsial, lihat D3 §2.4)
  bawaan        Boolean        @default(false)
  /// null = kop generik HKA (tanpa aset bawaan repo); selain itu folder aset bawaan + parameter kwitansi entitas
  gayaEntitas   GayaEntitas?
  /// Tata letak untuk jenis dokumen yang tidak punya baris TemplateCetak; hanya nilai HKA_*
  tataLetakUmum TataLetakCetak @default(HKA_STANDAR)

  // Khusus kop (tidak ada di Perusahaan)
  /// ≤60, judul merek di kepala tengah/minimal (HKA brand_title); kosong = nama perusahaan
  judulMerek    String?
  /// ≤120, tagline kepala (HKA header_text)
  teksKepala    String?
  /// ≤60
  facebook      String?
  /// ≤200, teks putih di pita gelombang bermerek/surat (maks 3 baris × 45 karakter tercetak)
  alamatKaki    String?
  /// ≤150, kaki tengah tata letak standar/minimal
  teksKaki      String?
  /// ≤20, nama bank singkat untuk kwitansi dan Nb. proposal, mis. "BCA"; kosong = namaBank
  singkatanBank String?
  /// ≤120, baris di atas tabel rekening bermerek (HKA bank_note)
  catatanBank   String?
  /// ≤120; kosong saat simpan dikembalikan ke "Hormat kami,"
  teksSalam     String  @default("Hormat kami,")
  /// ≤80, kontak "Nb." proposal D'Pro; kosong = penandaTangan
  namaKontak    String?
  /// ≤40; kosong = telepon
  teleponKontak String?

  // Penimpa identitas Perusahaan (D1); kosong = nilai Perusahaan. Dipakai untuk varian kop (mis. rekening atau penanda tangan lain)
  namaLegal            String?
  alamat               String?
  kota                 String?
  telepon              String?
  email                String?
  website              String?
  instagram            String?
  npwp                 String?
  namaBank             String?
  cabangBank           String?
  nomorRekening        String?
  atasNamaRekening     String?
  penandaTangan        String?
  jabatanPenandaTangan String?

  // Tampilan (semua warna ^#[0-9A-F]{6}$, disimpan huruf besar)
  /// HKA: kepala tabel, garis, gelombang. D'Pro: merah kepala tabel
  warnaAksen      String  @default("#111111")
  /// HKA: judul bermerek. D'Pro: navy label, garis tabel, Grand Total
  warnaUtama      String  @default("#1F3550")
  /// D'Pro: biru baris Total / TOTAL BIAYA LANGSUNG
  warnaSekunder   String  @default("#003E9F")
  /// D'Pro: latar Management Fee / DISCOUNT / ADD ON
  warnaLembut     String  @default("#DBE4F0")
  /// Teks isi
  warnaTinta      String  @default("#111111")
  /// Hanya tata letak HKA_STANDAR (sama seperti HKA show_logo)
  tampilLogo      Boolean @default(true)
  /// Logo pudar 22% di tengah halaman (tata letak HKA_*)
  tampilWatermark Boolean @default(false)

  dibuatPada  DateTime  @default(now())
  diubahPada  DateTime  @updatedAt
  dihapusPada DateTime?

  aset       AsetKopSurat[]
  template   TemplateCetak[]
  // relasi balik kolom kopSuratId milik D2
  penawaran  PenawaranPenjualan[]
  pesanan    PesananPenjualan[]
  faktur     FakturPenjualan[]
  penerimaan PenerimaanPenjualan[]
  uangMuka   UangMukaPelanggan[]

  @@index([perusahaanId, dihapusPada])
}

/// Pilihan tata letak per kop per jenis dokumen. Tidak ada baris = KopSurat.tataLetakUmum, A4, gaya angka bawaan.
model TemplateCetak {
  id                String            @id @default(cuid())
  kopSuratId        String
  kopSurat          KopSurat          @relation(fields: [kopSuratId], references: [id], onDelete: Cascade)
  jenis             JenisDokumenCetak
  tataLetak         TataLetakCetak
  ukuran            UkuranKertas      @default(A4)
  /// null = bawaan tata letak (DPRO_INVOICE, DPRO_PROPOSAL: KOMA; lainnya: TITIK)
  gayaAngka         GayaAngka?
  /// ≤60; null = judul bawaan jenis. Kalah oleh judulCetak dokumen (D2)
  judul             String?
  /// Nilai awal kotak "Bubuhkan tanda tangan & stempel" di panel cetak
  tandaTanganBawaan Boolean           @default(true)
  diubahPada        DateTime          @updatedAt

  @@unique([kopSuratId, jenis])
}

/// Gambar unggahan untuk satu slot kop. Isi biner ada di Berkas/IsiBerkas (D7, jenisEntitas "kop-surat",
/// folder KOP, hak lihat = pengaturan.tulis). Slot tanpa baris ini memakai aset bawaan repo menurut
/// KopSurat.gayaEntitas (kecuali TANDA_TANGAN dan STEMPEL).
model AsetKopSurat {
  id         String       @id @default(cuid())
  kopSuratId String
  kopSurat   KopSurat     @relation(fields: [kopSuratId], references: [id], onDelete: Cascade)
  jenis      JenisAsetKop
  berkasId   String       @unique
  berkas     Berkas       @relation(fields: [berkasId], references: [id], onDelete: Cascade)
  /// Dimensi asli (dibaca periksaGambar saat unggah), untuk menjaga rasio dan validasi
  lebarPx    Int
  tinggiPx   Int
  dibuatPada DateTime     @default(now())

  @@unique([kopSuratId, jenis])
}

// ---------- CRM (hasil peleburan HKA Console, D4) ----------

/// Jenis tahap pipeline. Status lead = jenis tahapnya (tidak disimpan terpisah).
enum JenisTahapLead {
  BERJALAN
  MENANG
  KALAH
}

/// Status pengingat tindak lanjut. "Terlambat" tidak disimpan: dihitung saat tampil (MENUNGGU dan jatuh tempo sudah lewat).
enum StatusTindakLanjut {
  MENUNGGU
  SELESAI
  DIBATALKAN
}

/// Jenis entri linimasa lead. Teks tampilan dirangkai saat tampil dari jenis + meta (src/lib/crm.ts, teksAktivitas).
enum JenisAktivitasLead {
  DIBUAT
  DIUBAH
  TAHAP_DIUBAH
  MENANG
  KALAH
  CATATAN
  TINDAK_LANJUT_DIJADWALKAN
  TINDAK_LANJUT_STATUS
  DIKONVERSI
  PENAWARAN_DIBUAT
  DIARSIPKAN
  DIPULIHKAN
}

/// Tahap pipeline per perusahaan. Urutan = urutan kolom kanban dan corong; tahap urutan terkecil = tahap awal lead baru (wajib BERJALAN).
model TahapLead {
  id           String         @id @default(cuid())
  perusahaanId String         @default("utama")
  perusahaan   Perusahaan     @relation(fields: [perusahaanId], references: [id], onDelete: Cascade)
  nama         String
  jenis        JenisTahapLead @default(BERJALAN)
  /// 1, 2, 3, ... rapat tanpa celah (dirapikan ulang setiap tambah/hapus/geser)
  urutan       Int
  dibuatPada   DateTime       @default(now())

  lead Lead[]

  @@unique([perusahaanId, nama])
  @@index([perusahaanId, urutan])
}

/// Daftar pilihan sumber lead per perusahaan. Lead menyimpan NAMA sumber (teks), jadi menghapus sumber tidak mengubah lead lama.
model SumberLead {
  id           String     @id @default(cuid())
  perusahaanId String     @default("utama")
  perusahaan   Perusahaan @relation(fields: [perusahaanId], references: [id], onDelete: Cascade)
  nama         String
  urutan       Int        @default(0)
  dibuatPada   DateTime   @default(now())

  @@unique([perusahaanId, nama])
  @@index([perusahaanId, urutan])
}

/// Calon klien (lead) CRM. Milik satu perusahaan; perusahaan tidak bisa diganti setelah dibuat (tahap per perusahaan berbeda).
model Lead {
  id                String     @id @default(cuid())
  perusahaanId      String     @default("utama")
  perusahaan        Perusahaan @relation(fields: [perusahaanId], references: [id])
  /// Nama orang yang dihubungi
  nama              String
  /// Nama perusahaan/usaha calon klien; disalin ke Pelanggan.nama saat konversi
  namaUsaha         String
  telepon           String
  whatsapp          String
  email             String?
  instagram         String?
  website           String?
  industri          String?
  lokasi            String?
  /// Nama sumber lead saat dicatat (teks dari daftar SumberLead perusahaan lead)
  sumber            String
  picId             String?
  pic               Pengguna?  @relation("PicLead", fields: [picId], references: [id], onDelete: SetNull)
  nilaiEstimasi     Decimal    @default(0) @db.Decimal(18, 2)
  /// Catatan tetap pada lead (berbeda dari catatan linimasa di AktivitasLead)
  catatan           String?
  /// Tag huruf kecil, tanpa duplikat, maksimal 20
  tag               String[]   @default([])
  /// Pasangan nama → nilai teks bebas (custom_fields HKA), maksimal 30 pasangan
  fieldTambahan     Json       @default("{}")
  tahapId           String
  tahap             TahapLead  @relation(fields: [tahapId], references: [id], onDelete: Restrict)
  /// Alasan menang/kalah; wajib saat masuk tahap KALAH, dikosongkan saat kembali ke BERJALAN
  alasanMenangKalah String?
  /// Diisi saat masuk tahap MENANG/KALAH, dikosongkan saat kembali ke BERJALAN
  ditutupPada       DateTime?
  pelangganId       String?
  pelanggan         Pelanggan? @relation(fields: [pelangganId], references: [id], onDelete: SetNull)
  dikonversiPada    DateTime?
  dibuatOlehId      String?
  dibuatOleh        Pengguna?  @relation("BuatLead", fields: [dibuatOlehId], references: [id], onDelete: SetNull)
  dibuatOlehNama    String
  dibuatPada        DateTime   @default(now())
  diubahPada        DateTime   @updatedAt
  /// Arsip (hapus lunak). Lead terarsip disembunyikan dari daftar, kanban, statistik, pencarian, dan pengingat.
  dihapusPada       DateTime?
  dihapusOlehId     String?
  dihapusOleh       Pengguna?  @relation("ArsipkanLead", fields: [dihapusOlehId], references: [id], onDelete: SetNull)
  dihapusOlehNama   String?

  aktivitas    AktivitasLead[]
  tindakLanjut TindakLanjut[]
  penawaran    PenawaranPenjualan[]
  /// Pesanan yang leadId-nya disalin dari penawaran saat konversi (kolom milik D2)
  pesanan      PesananPenjualan[]

  @@index([perusahaanId, dihapusPada, dibuatPada])
  @@index([tahapId])
  @@index([picId])
  @@index([pelangganId])
  @@index([dibuatOlehId])
  @@index([dihapusOlehId])
}

/// Entri linimasa lead. Tidak bisa diubah atau dihapus dari aplikasi.
model AktivitasLead {
  id           String             @id @default(cuid())
  leadId       String
  lead         Lead               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  jenis        JenisAktivitasLead
  /// Isi catatan (jenis CATATAN), 1-5000 karakter
  isi          String?
  /// Rincian per jenis (tabel D4 §3.6), dipakai merangkai teks saat tampil
  meta         Json               @default("{}")
  penggunaId   String?
  pengguna     Pengguna?          @relation("PelakuAktivitasLead", fields: [penggunaId], references: [id], onDelete: SetNull)
  penggunaNama String
  dibuatPada   DateTime           @default(now())

  @@index([leadId, dibuatPada])
  @@index([penggunaId])
}

/// Pengingat tindak lanjut; boleh tanpa lead (pengingat umum). Bila ada lead, perusahaanId = perusahaan lead.
model TindakLanjut {
  id             String             @id @default(cuid())
  perusahaanId   String             @default("utama")
  perusahaan     Perusahaan         @relation(fields: [perusahaanId], references: [id])
  leadId         String?
  lead           Lead?              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  judul          String
  jatuhTempo     DateTime
  catatan        String?
  status         StatusTindakLanjut @default(MENUNGGU)
  ditugaskanKeId String?
  ditugaskanKe   Pengguna?          @relation("TindakLanjutDitugaskan", fields: [ditugaskanKeId], references: [id], onDelete: SetNull)
  /// Waktu notifikasi jatuh tempo dikirim; null = belum. Dikosongkan lagi bila jatuh tempo diubah.
  diingatkanPada DateTime?
  selesaiPada    DateTime?
  dibuatOlehId   String?
  dibuatOleh     Pengguna?          @relation("BuatTindakLanjut", fields: [dibuatOlehId], references: [id], onDelete: SetNull)
  dibuatOlehNama String
  dibuatPada     DateTime           @default(now())
  diubahPada     DateTime           @updatedAt

  @@index([perusahaanId, status, jatuhTempo])
  @@index([ditugaskanKeId, status, diingatkanPada, jatuhTempo])
  @@index([leadId, jatuhTempo])
  @@index([dibuatOlehId])
}

// ---------- Keuangan proyek (peleburan HKA, D5) ----------

/// Mode bagian mitra (HKA partner.mode): PERSEN dari sisa setelah nominal tetap, atau NOMINAL rupiah tetap
enum ModeBagiHasil {
  PERSEN
  NOMINAL
}

/// Jenis Pembayaran ke Mitra (HKA payout.kind): MODAL = pengembalian talangan, LABA = bagi laba
enum JenisPembayaranMitra {
  MODAL
  LABA
}

/// Kategori anggaran proyek (HKA CATEGORIES + kategori buatan pengguna/impor). Global untuk semua
/// perusahaan karena bagan akun dan pemetaannya bersama (K2). Realisasi per kategori dibaca dari jurnal
/// bertanda proyek lewat AkunKategoriAnggaran.
model KategoriAnggaran {
  id         String   @id @default(cuid())
  /// Nama tampil, spasi dirapikan, 1-60 karakter
  nama       String
  /// nama huruf kecil dengan spasi tunggal: kunci unik tanpa beda huruf besar (pengganti _canon HKA)
  namaKunci  String   @unique
  /// Urutan tampil; kategori bawaan 10, 20, ... 90, buatan pengguna/impor 1000
  urutan     Int      @default(1000)
  /// true untuk 9 kategori bawaan HKA (boleh diganti nama, tidak boleh dihapus selama dipakai)
  bawaan     Boolean  @default(false)
  dibuatPada DateTime @default(now())

  akun          AkunKategoriAnggaran[]
  barisAnggaran BarisAnggaranProyek[]

  @@index([urutan])
}

/// Pemetaan akun beban → kategori anggaran. Satu akun paling banyak satu kategori (akunId sebagai PK).
/// Akun kelompok boleh dipetakan: berlaku untuk seluruh keturunannya kecuali keturunan yang dipetakan
/// sendiri (pemetaan terdekat menang, lihat kategoriUntukAkun di src/lib/kategoriAnggaran.ts).
model AkunKategoriAnggaran {
  akunId     String           @id
  akun       Akun             @relation(fields: [akunId], references: [id], onDelete: Cascade)
  kategoriId String
  kategori   KategoriAnggaran @relation(fields: [kategoriId], references: [id], onDelete: Cascade)

  @@index([kategoriId])
}

/// Baris anggaran (rencana biaya) proyek per kategori (HKA project_budget_lines). Tanpa jurnal.
/// Perusahaan dibaca dari proyek (anak proyek, tanpa kolom perusahaanId sendiri).
model BarisAnggaranProyek {
  id                String              @id @default(cuid())
  proyekId          String
  proyek            Proyek              @relation(fields: [proyekId], references: [id], onDelete: Cascade)
  kategoriId        String
  kategori          KategoriAnggaran    @relation(fields: [kategoriId], references: [id], onDelete: Restrict)
  /// Uraian item (HKA description), 1-200 karakter
  deskripsi         String
  /// Vendor/mitra rencana, teks bebas ≤120
  vendor            String?
  /// Rencana biaya tanpa PPN (HKA planned), 0 s.d. 10 triliun
  rencana           Decimal             @default(0) @db.Decimal(18, 2)
  /// Catatan ≤1000
  catatan           String?
  /// Nilai baris di dokumen sumber saat terakhir disinkron (HKA ref_amount); acuan, tidak masuk hitungan
  nilaiAcuan        Decimal?            @db.Decimal(18, 2)
  /// Dokumen sumber impor (paling banyak satu terisi, CHECK di migrasi). SetNull supaya hapus penawaran/pesanan lama tidak terhalang
  sumberPenawaranId String?
  sumberPenawaran   PenawaranPenjualan? @relation("SumberPenawaranAnggaran", fields: [sumberPenawaranId], references: [id], onDelete: SetNull)
  sumberPesananId   String?
  sumberPesanan     PesananPenjualan?   @relation("SumberPesananAnggaran", fields: [sumberPesananId], references: [id], onDelete: SetNull)
  /// Kunci baris sumber "{nama}|{bagian}|{n}" huruf kecil (HKA source_key)
  kunciSumber       String?
  /// 16 karakter awal SHA-1 isi dokumen sumber saat terakhir disinkron (HKA source_sig)
  tandaSumber       String?
  disinkronPada     DateTime?
  /// true bila baris ini tidak ada lagi di dokumen sumber (HKA removed_from_quotation); tetap dihitung di anggaran
  dihapusDariSumber Boolean             @default(false)
  dibuatPada        DateTime            @default(now())
  diubahPada        DateTime            @updatedAt

  @@index([proyekId])
  @@index([kategoriId])
  @@index([sumberPenawaranId])
  @@index([sumberPesananId])
}

/// Mitra bagi hasil proyek (HKA project_partners). Urutan (naik) menentukan siapa yang dibayar dulu di
/// antara mitra NOMINAL. Anak proyek: perusahaan dibaca dari proyek.
model MitraProyek {
  id         String        @id @default(cuid())
  proyekId   String
  proyek     Proyek        @relation(fields: [proyekId], references: [id], onDelete: Cascade)
  /// 1-120 karakter, tidak harus unik (HKA)
  nama       String
  mode       ModeBagiHasil @default(PERSEN)
  /// PERSEN: 0 < nilai ≤ 100 (persen dari sisa setelah nominal tetap). NOMINAL: 0 < nilai ≤ 10 triliun rupiah
  nilai      Decimal       @db.Decimal(18, 2)
  /// Catatan ≤1000
  catatan    String?
  /// Bawaan = urutan terbesar di proyek + 1 saat dibuat (setara urutan created_at HKA)
  urutan     Int           @default(0)
  dibuatPada DateTime      @default(now())
  diubahPada DateTime      @updatedAt

  talangan   TalanganMitra[]
  pembayaran PembayaranMitra[]

  @@index([proyekId, urutan])
}

/// Talangan Mitra (TLM): biaya proyek yang dibayar mitra dengan uangnya sendiri (HKA cost funded_by = mitra).
/// Jurnal JU-TLM saat disetujui: Dr akun beban pilihan / Cr Hutang Mitra Proyek, bertanda proyek.
/// Ikut alur persetujuan (BERKAS "talanganMitra" di src/lib/persetujuan.ts).
model TalanganMitra {
  id                String            @id @default(cuid())
  nomor             String            @unique
  /// Tanggal biaya (dipilih pengguna, tidak boleh di masa depan); jurnal memakai tanggal ini
  tanggal           DateTime
  /// Diwarisi dari proyek (bukan dari formulir)
  perusahaanId      String            @default("utama")
  perusahaan        Perusahaan        @relation(fields: [perusahaanId], references: [id])
  proyekId          String
  proyek            Proyek            @relation(fields: [proyekId], references: [id], onDelete: Restrict)
  mitraId           String
  mitra             MitraProyek       @relation(fields: [mitraId], references: [id], onDelete: Restrict)
  /// Akun beban rinci yang didebit; kategorinya mengikuti pemetaan akun (tidak disimpan di sini)
  akunBebanId       String
  akunBeban         Akun              @relation("AkunBebanTalanganMitra", fields: [akunBebanId], references: [id], onDelete: Restrict)
  jumlah            Decimal           @db.Decimal(18, 2)
  /// Uraian (HKA description) 1-200; vendor ≤120; catatan ≤1000
  deskripsi         String
  vendor            String?
  catatan           String?
  /// Terisi setelah dijurnal (langsung bila persetujuan mati, atau saat disetujui)
  jurnalId          String?           @unique
  jurnal            Jurnal?           @relation("JurnalTalanganMitra", fields: [jurnalId], references: [id], onDelete: SetNull)
  dicatatOlehId     String?
  dicatatOleh       Pengguna?         @relation("CatatTalanganMitra", fields: [dicatatOlehId], references: [id], onDelete: SetNull)
  dicatatOlehNama   String
  dibuatPada        DateTime          @default(now())
  /// Persetujuan (maker-checker); lihat src/lib/persetujuan.ts
  statusPersetujuan StatusPersetujuan @default(DRAFT)
  diajukanOlehId    String?
  diajukanOleh      Pengguna?         @relation("AjukanTalanganMitra", fields: [diajukanOlehId], references: [id])
  diajukanPada      DateTime?
  disetujuiOlehId   String?
  disetujuiOleh     Pengguna?         @relation("SetujuiTalanganMitra", fields: [disetujuiOlehId], references: [id])
  disetujuiPada     DateTime?
  ditolakOlehId     String?
  ditolakOleh       Pengguna?         @relation("TolakTalanganMitra", fields: [ditolakOlehId], references: [id])
  ditolakPada       DateTime?
  catatanPenolakan  String?

  @@index([perusahaanId])
  @@index([proyekId])
  @@index([mitraId])
  @@index([akunBebanId])
  @@index([dicatatOlehId])
  @@index([tanggal])
  @@index([statusPersetujuan])
}

/// Pembayaran ke Mitra (BYM): MODAL = pengembalian talangan (Dr Hutang Mitra Proyek / Cr Kas),
/// LABA = bagi laba (Dr Bagi Hasil Mitra Proyek / Cr Kas). Jurnal JU-BYM bertanda proyek.
/// Ikut alur persetujuan (BERKAS "pembayaranMitra").
model PembayaranMitra {
  id                String               @id @default(cuid())
  nomor             String               @unique
  tanggal           DateTime
  perusahaanId      String               @default("utama")
  perusahaan        Perusahaan           @relation(fields: [perusahaanId], references: [id])
  proyekId          String
  proyek            Proyek               @relation(fields: [proyekId], references: [id], onDelete: Restrict)
  mitraId           String
  mitra             MitraProyek          @relation(fields: [mitraId], references: [id], onDelete: Restrict)
  /// Bawaan LABA mengikuti HKA (kind = profit); formulir memilih MODAL bila masih ada modal terutang
  jenis             JenisPembayaranMitra @default(LABA)
  jumlah            Decimal              @db.Decimal(18, 2)
  /// Akun kas/bank sumber pembayaran (kasBank, rinci, milik perusahaan dokumen atau bersama)
  akunKasId         String
  akunKas           Akun                 @relation("AkunKasPembayaranMitra", fields: [akunKasId], references: [id], onDelete: Restrict)
  /// Catatan/referensi transfer ≤1000
  catatan           String?
  jurnalId          String?              @unique
  jurnal            Jurnal?              @relation("JurnalPembayaranMitra", fields: [jurnalId], references: [id], onDelete: SetNull)
  dicatatOlehId     String?
  dicatatOleh       Pengguna?            @relation("CatatPembayaranMitra", fields: [dicatatOlehId], references: [id], onDelete: SetNull)
  dicatatOlehNama   String
  dibuatPada        DateTime             @default(now())
  /// Persetujuan (maker-checker); lihat src/lib/persetujuan.ts
  statusPersetujuan StatusPersetujuan    @default(DRAFT)
  diajukanOlehId    String?
  diajukanOleh      Pengguna?            @relation("AjukanPembayaranMitra", fields: [diajukanOlehId], references: [id])
  diajukanPada      DateTime?
  disetujuiOlehId   String?
  disetujuiOleh     Pengguna?            @relation("SetujuiPembayaranMitra", fields: [disetujuiOlehId], references: [id])
  disetujuiPada     DateTime?
  ditolakOlehId     String?
  ditolakOleh       Pengguna?            @relation("TolakPembayaranMitra", fields: [ditolakOlehId], references: [id])
  ditolakPada       DateTime?
  catatanPenolakan  String?

  @@index([perusahaanId])
  @@index([proyekId])
  @@index([mitraId, jenis])
  @@index([akunKasId])
  @@index([dicatatOlehId])
  @@index([tanggal])
  @@index([statusPersetujuan])
}

// ============================================================================
// Modul Pemasaran (D6): perencana konten, tugas desain, perencana iklan Meta.
// Tidak ada yang menjurnal. Kepala data punya perusahaanId; anak membaca dari induk.
// ============================================================================

enum PlatformKonten {
  INSTAGRAM
  FACEBOOK
  TIKTOK
  THREADS
}

/// Status kerja konten, urutan = kolom kanban. DITINJAU hanya dicapai lewat ajukanKonten.
enum StatusKonten {
  IDE
  DRAF
  DESAIN
  DITINJAU
  DISETUJUI
  TERJADWAL
  TERBIT
}

/// Persetujuan konten oleh pemegang konten.setujui. Terpisah dari StatusPersetujuan (maker-checker dokumen berjurnal).
enum StatusPersetujuanKonten {
  TIDAK_ADA
  MENUNGGU
  DISETUJUI
  DITOLAK
}

enum AksiRiwayatKonten {
  DIAJUKAN
  DISETUJUI
  DITOLAK
  DITARIK
}

/// Status tugas desain, urutan = kolom kanban. DISETUJUI dan SELESAI hanya oleh pemegang tugas-desain.setujui.
enum StatusTugasDesain {
  PERMINTAAN
  DITUGASKAN
  DIKERJAKAN
  DITINJAU
  REVISI
  DISETUJUI
  SELESAI
}

enum PrioritasDesain {
  RENDAH
  SEDANG
  TINGGI
  MENDESAK
}

enum SumberTugasDesain {
  MANUAL
  KONTEN
}

enum KeputusanRevisiDesain {
  DISETUJUI
  MINTA_REVISI
}

/// Tujuan kampanye mengikuti istilah Meta Ads Manager berbahasa Indonesia.
enum TujuanKampanye {
  KESADARAN
  TRAFFIC
  INTERAKSI
  PROSPEK
  PROMOSI_APLIKASI
  PENJUALAN
}

enum StatusKampanye {
  DIRENCANAKAN
  AKTIF
  DIJEDA
  SELESAI
}

enum GenderAudiens {
  SEMUA
  PEREMPUAN
  LAKI_LAKI
}

/// Konten media sosial (HKA social_posts). Milik satu perusahaan; hapus = arsip lunak.
model Konten {
  id                 String                  @id @default(cuid())
  perusahaanId       String                  @default("utama")
  perusahaan         Perusahaan              @relation(fields: [perusahaanId], references: [id])
  judul              String
  platform           PlatformKonten          @default(INSTAGRAM)
  /// Teks bebas; pilihan formulir dari PengaturanPemasaran.jenisKonten
  jenisKonten        String?
  /// Teks bebas; pilihan formulir dari PengaturanPemasaran.pilarKonten
  pilar              String?
  caption            String?
  cta                String?
  /// Satu string, mis. "#dpro #event" (seperti HKA)
  tagar              String?
  /// Tanggal terbit, disimpan pukul 12.00 waktu server seperti tanggal dokumen lain; null = belum dijadwalkan
  tanggalTerbit      DateTime?
  /// "HH:MM" dibaca dalam ZONA_WAKTU; hanya boleh diisi bila tanggalTerbit diisi
  jamTerbit          String?
  status             StatusKonten            @default(IDE)
  statusPersetujuan  StatusPersetujuanKonten @default(TIDAK_ADA)
  smmId              String?
  smm                Pengguna?               @relation("SmmKonten", fields: [smmId], references: [id], onDelete: SetNull)
  desainerId         String?
  desainer           Pengguna?               @relation("DesainerKonten", fields: [desainerId], references: [id], onDelete: SetNull)
  proyekId           String?
  proyek             Proyek?                 @relation(fields: [proyekId], references: [id], onDelete: SetNull)
  /// Satu-satunya sumber brief untuk desainer; tugas desain membacanya langsung (tidak disalin)
  briefDesain        String?
  catatan            String?
  dibuatOlehId       String?
  dibuatOleh         Pengguna?               @relation("BuatKonten", fields: [dibuatOlehId], references: [id], onDelete: SetNull)
  dibuatOlehNama     String
  dibuatPada         DateTime                @default(now())
  diubahPada         DateTime                @updatedAt
  diarsipkanPada     DateTime?
  diarsipkanOlehNama String?

  riwayat     RiwayatPersetujuanKonten[]
  tugasDesain TugasDesain[]

  @@index([perusahaanId, tanggalTerbit])
  @@index([perusahaanId, status])
  @@index([proyekId])
  @@index([smmId])
  @@index([desainerId])
  @@index([dibuatOlehId])
  @@index([diarsipkanPada])
}

/// Riwayat persetujuan konten (HKA social_approvals), hanya ditambah.
model RiwayatPersetujuanKonten {
  id           String            @id @default(cuid())
  kontenId     String
  konten       Konten            @relation(fields: [kontenId], references: [id], onDelete: Cascade)
  aksi         AksiRiwayatKonten
  /// Catatan pengaju (DIAJUKAN) atau masukan penyetuju (DISETUJUI/DITOLAK)
  masukan      String?
  /// Tanpa relasi Prisma (pola LogAktivitas): riwayat tetap utuh bila pengguna dihapus
  penggunaId   String?
  penggunaNama String
  dibuatPada   DateTime          @default(now())

  @@index([kontenId, dibuatPada])
}

/// Tugas desain (HKA design_tasks). Milik satu perusahaan; hapus = arsip lunak.
model TugasDesain {
  id                 String            @id @default(cuid())
  perusahaanId       String            @default("utama")
  perusahaan         Perusahaan        @relation(fields: [perusahaanId], references: [id])
  judul              String
  /// Bila tertaut konten: instruksi tambahan (brief tetap di konten). Bila tidak: brief tugas ini.
  deskripsi          String?
  prioritas          PrioritasDesain   @default(SEDANG)
  tenggat            DateTime?
  status             StatusTugasDesain @default(PERMINTAAN)
  desainerId         String?
  desainer           Pengguna?         @relation("DesainerTugas", fields: [desainerId], references: [id], onDelete: SetNull)
  kontenId           String?
  /// Restrict: konten hanya diarsipkan, tidak pernah dihapus fisik oleh aplikasi; hapus fisik (reset, uji)
  /// harus menghapus tugasnya dulu. SetNull akan bentrok dengan CHECK TugasDesain_kunci_konten_cocok.
  konten             Konten?           @relation(fields: [kontenId], references: [id], onDelete: Restrict)
  /// Salinan kontenId selama tugas belum diarsipkan (null bila tanpa konten atau sudah diarsipkan).
  /// Unik: satu tugas desain aktif per konten di semua jalur.
  kunciKontenAktif   String?           @unique
  kampanyeId         String?
  kampanye           Kampanye?         @relation(fields: [kampanyeId], references: [id], onDelete: SetNull)
  proyekId           String?
  proyek             Proyek?           @relation(fields: [proyekId], references: [id], onDelete: SetNull)
  jumlahRevisi       Int               @default(0)
  /// Catatan tinjauan terakhir (null bila disetujui tanpa catatan)
  catatanRevisi      String?
  sumber             SumberTugasDesain @default(MANUAL)
  dibuatOlehNama     String
  dibuatPada         DateTime          @default(now())
  diubahPada         DateTime          @updatedAt
  diarsipkanPada     DateTime?
  diarsipkanOlehNama String?

  revisi RevisiDesain[]

  @@index([perusahaanId, status])
  @@index([desainerId, status])
  @@index([kontenId])
  @@index([kampanyeId])
  @@index([proyekId])
  @@index([tenggat])
  @@index([diarsipkanPada])
}

/// Satu baris per keputusan tinjauan desain (HKA design_revisions).
model RevisiDesain {
  id               String                @id @default(cuid())
  tugasId          String
  tugas            TugasDesain           @relation(fields: [tugasId], references: [id], onDelete: Cascade)
  nomorRevisi      Int
  keputusan        KeputusanRevisiDesain
  catatan          String?
  /// [{ "id": string, "nama": string }] = berkasBaru baris RevisiDesain sebelumnya (atau [])
  berkasSebelumnya Json
  /// [{ "id": string, "nama": string }] berkas hasil aktif saat tinjauan; nama disalin supaya tetap terbaca walau berkas dihapus
  berkasBaru       Json
  peninjauId       String?
  peninjauNama     String
  dibuatPada       DateTime              @default(now())

  @@index([tugasId, dibuatPada])
}

/// Kampanye iklan Meta (HKA campaigns). Perencanaan saja, tidak menjurnal.
model Kampanye {
  id                 String         @id @default(cuid())
  perusahaanId       String         @default("utama")
  perusahaan         Perusahaan     @relation(fields: [perusahaanId], references: [id])
  nama               String
  tujuan             TujuanKampanye @default(PROSPEK)
  /// Anggaran rencana, satu angka seperti HKA (tanpa pembeda harian/lifetime)
  anggaran           Decimal        @default(0) @db.Decimal(18, 2)
  tanggalMulai       DateTime?
  tanggalSelesai     DateTime?
  status             StatusKampanye @default(DIRENCANAKAN)
  proyekId           String?
  proyek             Proyek?        @relation(fields: [proyekId], references: [id], onDelete: SetNull)
  catatan            String?
  dibuatOlehNama     String
  dibuatPada         DateTime       @default(now())
  diubahPada         DateTime       @updatedAt
  diarsipkanPada     DateTime?
  diarsipkanOlehNama String?

  setIklan    SetIklan[]
  metrik      MetrikIklan[]
  tugasDesain TugasDesain[]

  @@index([perusahaanId, status])
  @@index([proyekId])
  @@index([diarsipkanPada])
}

/// Set iklan (Meta: ad set). Proyek dan perusahaan mengikuti kampanye.
model SetIklan {
  id         String        @id @default(cuid())
  kampanyeId String
  kampanye   Kampanye      @relation(fields: [kampanyeId], references: [id], onDelete: Cascade)
  nama       String
  audiens    String?
  lokasi     String?
  /// Teks bebas, mis. "22-40"
  usia       String?
  gender     GenderAudiens @default(SEMUA)
  penempatan String?
  anggaran   Decimal       @default(0) @db.Decimal(18, 2)
  catatan    String?
  dibuatPada DateTime      @default(now())
  diubahPada DateTime      @updatedAt

  iklan Iklan[]

  @@index([kampanyeId])
}

/// Iklan di dalam set iklan. Kampanye dibaca lewat setIklan.
model Iklan {
  id              String   @id @default(cuid())
  setIklanId      String
  /// Restrict: set iklan yang masih punya iklan tidak bisa dihapus
  setIklan        SetIklan @relation(fields: [setIklanId], references: [id], onDelete: Restrict)
  nama            String
  berkasKreatifId String?
  berkasKreatif   Berkas?  @relation("KreatifIklan", fields: [berkasKreatifId], references: [id], onDelete: SetNull)
  teksUtama       String?
  judulIklan      String?
  cta             String?
  /// Wajib diawali http:// atau https:// bila diisi
  urlTujuan       String?
  catatan         String?
  dibuatPada      DateTime @default(now())
  diubahPada      DateTime @updatedAt

  @@index([setIklanId])
  @@index([berkasKreatifId])
}

/// Laporan hasil harian per kampanye, diketik manual. Satu baris per kampanye per tanggal.
model MetrikIklan {
  id              String   @id @default(cuid())
  kampanyeId      String
  kampanye        Kampanye @relation(fields: [kampanyeId], references: [id], onDelete: Cascade)
  tanggal         DateTime
  belanja         Decimal  @default(0) @db.Decimal(18, 2)
  jangkauan       Int      @default(0)
  tayangan        Int      @default(0)
  klik            Int      @default(0)
  leads           Int      @default(0)
  konversi        Int      @default(0)
  /// "Hasil" seperti kolom Results di Ads Manager; null = otomatis dari tujuan kampanye (src/lib/iklan.ts)
  hasil           Int?
  pendapatan      Decimal  @default(0) @db.Decimal(18, 2)
  /// Nilai ketikan manual menimpa hitungan; null = dihitung dari angka dasar
  ctrManual       Decimal? @db.Decimal(18, 2)
  cpcManual       Decimal? @db.Decimal(18, 2)
  cpmManual       Decimal? @db.Decimal(18, 2)
  catatan         String?
  dicatatOlehNama String
  dibuatPada      DateTime @default(now())
  diubahPada      DateTime @updatedAt

  @@unique([kampanyeId, tanggal])
  @@index([tanggal])
}

/// Daftar pilihan jenis & pilar konten per perusahaan (HKA content_types, content_pillars). Tanpa baris = bawaan di src/lib/pemasaran.ts.
/// perusahaanId sebagai kunci utama tanpa bawaan "utama" (D6 menyimpang dari kontrak): penyimpanan yang lupa
/// mengirim perusahaan harus gagal, bukan diam-diam menimpa pengaturan DPRO.
model PengaturanPemasaran {
  perusahaanId   String     @id
  perusahaan     Perusahaan @relation(fields: [perusahaanId], references: [id], onDelete: Cascade)
  jenisKonten    String[]
  pilarKonten    String[]
  diubahOlehNama String?
  diubahPada     DateTime   @updatedAt
}
